_FAILED = 0


def check(name: str, got, want) -> None:
    global _FAILED
    if got == want:
        print(f"  ✅ {name}")
    else:
        _FAILED += 1
        print(f"  ❌ {name}\n       got:  {got!r}\n       want: {want!r}")


def _aged(path: Path, days: float, now: float) -> Path:
    """Set atime and mtime `days` ago. An mtime before the birth time moves the birth time back on APFS."""
    when = now - days * 86400
    os.utime(path, (when, when))
    return path


def _write(path: Path, data: bytes | str = b"x", days: float | None = None, now: float = 0.0) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(data.encode() if isinstance(data, str) else data)
    return _aged(path, days, now) if days is not None else path


def selftest_measure_real() -> None:
    print("\nmeasure_real (APFS clones, hard links)")
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        solo = _write(root / "solo", os.urandom(300_000))
        a = _write(root / "a", os.urandom(300_000))
        b = root / "b"
        run(["cp", "-c", str(a), str(b)])
        h1 = _write(root / "h1", os.urandom(300_000))
        h2 = root / "h2"
        os.link(h1, h2)
        size = solo.stat().st_blocks * 512
        check("a file nothing shares is freed in full", measure_real([solo])[1], size)
        check("SAFETY: one of two clones frees nothing", measure_real([a])[1], 0)
        check("both clones together free one copy", measure_real([a, b])[1], size)
        check("du counts each clone, real counts the copy once", measure_real([a, b])[0], 2 * size)
        check("SAFETY: one of two hard links frees nothing", measure_real([h1])[1], 0)
        check("both hard links free the inode once", measure_real([h1, h2])[1], size)
        check("a dir is walked, clones inside it pair up", measure_real([root])[1] >= 3 * size, True)


def selftest_code_index() -> None:
    print("\nCodeIndex (one walk of ~/Code for every reference-based section)")
    with tempfile.TemporaryDirectory() as tmp:
        code = Path(tmp)
        proj = code / "proj"
        _write(proj / "go.mod", "module x\n")
        _write(proj / "go.sum", "")
        _write(proj / "uv.lock", "")
        _write(proj / "web/pylock.toml", "")
        _write(proj / ".venv/lib/python3.12/site-packages/foo-1.0.dist-info/METADATA", "")
        (proj / "node_modules/.pnpm/x@1.0.0").mkdir(parents=True)
        (proj / "node_modules/inner/node_modules/.pnpm").mkdir(parents=True)
        _write(proj / "tool.py", "#!/usr/bin/env -S uv run --script\n# /// script\n# ///\n")
        runner = _write(proj / "bin/runme", "#!/usr/bin/env -S uv run --script\n# /// script\n# ///\n")
        runner.chmod(0o755)
        _write(proj / "plain.py", "print(1)\n")
        _write(proj / "tmp/copy/go.mod", "module copy\n")
        (proj / "tmp/copy/node_modules/.pnpm").mkdir(parents=True)
        _write(code / "go/pkg/mod/example.com/m@v1/go.mod", "module m\n")
        index = build_code_index(code)
        check("go.mod dirs, not tmp copies or the module cache", index.go_mods, [proj])
        check("uv and pylock lock files", sorted(index.locks), [proj / "uv.lock", proj / "web/pylock.toml"])
        check("project venvs", index.venvs, [proj / ".venv"])
        check("pnpm node_modules, not descended into, not under tmp", index.node_modules, [proj / "node_modules"])
        check("PEP 723 scripts by file name, with or without .py", index.scripts, {"tool.py", "runme"})


def selftest_cargo_rearm() -> None:
    print("\ncargo: real last use (re-armed atimes)")
    with tempfile.TemporaryDirectory() as tmp:
        target = Path(tmp)
        now = time.time()
        day = 86400

        def unit(name: str, mtime_days: float, atime_days: float, polluted_json_days: float | None = None) -> Path:
            d = target / "debug/.fingerprint" / name
            for f in (f"lib-{name}", f"dep-lib-{name}", "invoked.timestamp", f"lib-{name}.json"):
                _write(d / f, "x")
                os.utime(d / f, (now - atime_days * day, now - mtime_days * day))
            if polluted_json_days is not None:
                os.utime(d / f"lib-{name}.json", (now - polluted_json_days * day, now - mtime_days * day))
            return d

        armed = unit("armed", mtime_days=30, atime_days=30 + 1 / 86400)  # re-armed, not read since
        read = unit("read", mtime_days=30, atime_days=2)  # read by a build two days ago
        legacy = unit("legacy", mtime_days=20, atime_days=20 + 1 / 86400)  # armed, but no sidecar entry
        unit("polluted", mtime_days=40, atime_days=40, polluted_json_days=0)
        sidecar = {"debug/.fingerprint/armed": now - 3 * day, "debug/.fingerprint/gone": now - day}
        lastuse = plan_cargo_lastuse(target, sidecar)
        days = {k.rsplit("/", 1)[-1]: round((now - v) / day) for k, v in lastuse.items()}
        check("an armed unit nobody read keeps its recorded last use", days.get("armed"), 3)
        check("a read since re-arming is the new last use", days.get("read"), 2)
        check("no record and still armed → its last build", days.get("legacy"), 20)
        check("SAFETY: a json read outside cargo does not count as use", days.get("polluted"), 40)

        hash_file = armed / "lib-armed"
        before = hash_file.stat()
        originals = apply_lastuse(target, lastuse)
        check("before the sweep every file shows the unit's real last use",
              round((now - hash_file.stat().st_atime) / day), 3)
        check("mtimes are never touched", hash_file.stat().st_mtime_ns, before.st_mtime_ns)
        restore_atimes(originals)
        check("a dry run puts the atimes back exactly", hash_file.stat().st_atime_ns, before.st_atime_ns)

        shutil.rmtree(legacy)  # swept
        new_sidecar = rearm_target(target, lastuse)
        check("re-arming records each surviving unit's last use", sorted(new_sidecar),
              sorted(f"debug/.fingerprint/{n}" for n in ("armed", "read", "polluted")))
        st = (read / "lib-read").stat()
        check("re-armed: atime one second before mtime", st.st_mtime_ns - st.st_atime_ns, 10**9)
        with open(read / "lib-read", "rb") as f:
            f.read()
        check("CANARY: on this Mac a read after re-arming records the use",
              (read / "lib-read").stat().st_atime > now - 60, True)


def selftest_uv_refs() -> None:
    print("\nuv: references from active projects")
    lock = '[[package]]\nname = "Typing_Extensions"\nversion = "4.12.2"\n\n[[package]]\nname = "foo.bar"\nversion = "1.0"\n'
    check("uv.lock pins, names normalized", lock_pins(lock), {("typing-extensions", "4.12.2"), ("foo-bar", "1.0")})
    pylock = '[[packages]]\nname = "numpy"\nversion = "2.1.0"\n'
    check("pylock.toml pins", lock_pins(pylock), {("numpy", "2.1.0")})
    check("a broken lock file yields nothing", lock_pins("[[package"), set())
    check("wheel pointer dir name → version", wheel_version("1.26.4-cp312-cp312-macosx_11_0_arm64"), "1.26.4")

    with tempfile.TemporaryDirectory() as tmp:
        cache = Path(tmp)
        now = time.time()
        archive = cache / "archive-v0"
        for name in ("CACHEDIR.TAG", ".gitignore", ".lock"):
            (cache / name).touch()

        def entry(path: Path, days: float, prompt: str | None = None) -> Path:
            path.mkdir(parents=True)
            if prompt is not None:
                (path / "pyvenv.cfg").write_text(f"uv = 0.9.17\nprompt = {prompt}\n")
            return _aged(path, days, now)

        def link(path: Path, target: Path) -> Path:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.symlink_to(target)
            return path

        pinned = entry(archive / "PINNEDxxxxxxxxxxxxxxx", 40)
        link(cache / "wheels-v5/pypi/typing-extensions/4.12.2-py3-none-any", pinned)
        unpinned = entry(archive / "UNPINNEDxxxxxxxxxxxxx", 10)
        link(cache / "wheels-v5/pypi/numpy/1.0.0-cp312-cp312-macosx_11_0_arm64", unpinned)
        script_env = entry(cache / "environments-v2/brewer-0123456789abcdef", 10, prompt="brewer.py")
        aged_script_env = entry(cache / "environments-v2/brewer-fedcba9876543210", 40, prompt="brewer.py")
        gone_script_env = entry(cache / "environments-v2/deleted-0123456789abcdef", 10, prompt="deleted.py")
        old_index = _write(cache / "simple-v18/pypi/requests.rkyv", "x", days=10, now=now)
        new_index = _write(cache / "simple-v18/pypi/httpx.rkyv", "x", days=1, now=now)
        removals, _ = plan_uv_cleanup(cache, keep_days=7, ps_output="", now=now,
                                      pins={("typing-extensions", "4.12.2")}, scripts={"brewer.py"})
        removed = {i.path for i in removals}
        check("SAFETY: an old wheel an active lock pins is kept", pinned in removed, False)
        check("an unpinned wheel past 7 days goes", unpinned in removed, True)
        check("SAFETY: a script env whose script still exists is kept for 30 days", script_env in removed, False)
        check("a script env past 30 days goes even if the script exists", aged_script_env in removed, True)
        check("a script env whose script is gone goes after 7 days", gone_script_env in removed, True)
        check("index metadata past 7 days goes", old_index in removed, True)
        check("recent index metadata stays", new_index in removed, False)


def selftest_go() -> None:
    print("\ngo: module cache")
    gosum = (
        "github.com/BurntSushi/toml v1.3.2 h1:o7IhLm0Msx3BaB+n3Ag7L8EVlByGnpq14C4YWiu/gL8=\n"
        "github.com/BurntSushi/toml v1.3.2/go.mod h1:CxXYINrC8qIiEnFrOxCa7Jy5BFHlXnUU2pbicEuybxQ=\n"
        "golang.org/x/mod v0.9.0/go.mod h1:abc=\n"
    )
    check("go.sum: source lines only, paths case-escaped", go_sum_refs(gosum), {"github.com/!burnt!sushi/toml@v1.3.2"})
    check("go.mod go/toolchain lines", toolchain_wants("module x\n\ngo 1.24\n\ntoolchain go1.25.3\n"), {"1.24", "1.25.3"})

    with tempfile.TemporaryDirectory() as tmp:
        mod = Path(tmp)
        now = time.time()

        def extracted(key: str, days: float) -> Path:
            d = mod / key
            _write(d / "go.mod", "module m\n")
            _write(d / "sub/file.go", "package m\n")
            for p in (d / "sub", d):
                _aged(p, days, now)
            return d

        def download(key: str, days: float) -> dict[str, Path]:
            path, ver = key.split("@")
            base = mod / "cache/download" / path / "@v"
            files = {ext: _write(base / f"{ver}.{ext}", "x", days=days, now=now) for ext in ("zip", "ziphash", "mod", "info", "lock")}
            return files

        kept_ref = extracted("github.com/!burnt!sushi/toml@v1.3.2", 40)
        dropped = extracted("github.com/foo/bar@v1.0.0", 40)
        dropped_dl = download("github.com/foo/bar@v1.0.0", 40)
        young = extracted("github.com/foo/bar@v1.1.0", 2)
        parent = extracted("golang.org/x/tools@v0.1.0", 40)
        nested = extracted("golang.org/x/tools/gopls@v0.18.1", 40)
        tc_old = extracted("golang.org/toolchain@v0.0.1-go1.26.0.darwin-arm64", 40)
        tc_newest = extracted("golang.org/toolchain@v0.0.1-go1.26.10.darwin-arm64", 40)
        tc_wanted = extracted("golang.org/toolchain@v0.0.1-go1.25.3.darwin-arm64", 40)
        zip_only = download("github.com/old/zip@v2.0.0", 40)
        for d in [kept_ref, dropped, young, parent, nested, tc_old, tc_newest, tc_wanted]:
            for dp, _dirs, files in os.walk(d, topdown=False):
                for f in files:
                    os.chmod(os.path.join(dp, f), 0o444)
                os.chmod(dp, 0o555)  # how go leaves the module cache: read-only

        refs = {"github.com/!burnt!sushi/toml@v1.3.2", "golang.org/x/tools/gopls@v0.18.1"}
        plan = plan_go_cleanup(mod, refs, {"1.25.3"}, keep_days=7, now=now)
        dirs = sorted(str(r.path.relative_to(mod)) for r in plan if r.path)
        check("old unreferenced extracted dirs go, nested modules told apart", dirs,
              ["github.com/foo/bar@v1.0.0", "golang.org/toolchain@v0.0.1-go1.26.0.darwin-arm64", "golang.org/x/tools@v0.1.0"])
        files = sorted(str(f.relative_to(mod / "cache/download")) for r in plan for f in r.files)
        check("their zips go, and zips nothing extracted from", files, [
            "github.com/foo/bar/@v/v1.0.0.zip", "github.com/foo/bar/@v/v1.0.0.ziphash",
            "github.com/old/zip/@v/v2.0.0.zip", "github.com/old/zip/@v/v2.0.0.ziphash",
        ])
        for what, path in [("a referenced module", kept_ref), ("a module extracted 2 days ago", young),
                           ("the newest toolchain", tc_newest), ("a toolchain a go.mod asks for", tc_wanted)]:
            check(f"SAFETY: keeps {what}", any(r.path == path for r in plan), False)

        busy = next(r for r in plan if r.path == parent)
        lock_fd = os.open(busy.lock, os.O_RDONLY) if busy.lock.exists() else None
        if lock_fd is None:
            busy.lock.parent.mkdir(parents=True, exist_ok=True)
            busy.lock.touch()
            lock_fd = os.open(busy.lock, os.O_RDONLY)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        removed, skipped = apply_go_plan(mod, plan)
        os.close(lock_fd)
        check("SAFETY: a version whose .lock a go process holds is skipped", (parent.exists(), skipped), (True, 1))
        check("read-only module trees are deleted", (dropped.exists(), tc_old.exists()), (False, False))
        check("its zip went, its go.mod and info stay for the module graph",
              [dropped_dl["zip"].exists(), dropped_dl["mod"].exists(), dropped_dl["info"].exists()], [False, True, True])
        check("zip-only versions lose the zip", zip_only["zip"].exists(), False)
        check("no trash left behind", [p.name for p in mod.iterdir() if p.name.startswith(TRASH_PREFIX)], [])


def selftest_pnpm() -> None:
    print("\npnpm: store, dlx, metadata")
    check("node_modules/.pnpm names → index keys",
          [pnpm_key(n) for n in ["@scope+name@1.2.3_react@18.2.0", "name@1.0.0-beta.1_peer@2", "plain@3.0.0", ".modules.yaml", "node_modules"]],
          ["@scope+name@1.2.3", "name@1.0.0-beta.1", "plain@3.0.0", None, None])
    check("index file name → key", index_key("9c68503dbfd7-@napi-rs+wasm-runtime@1.2.4.json"), "@napi-rs+wasm-runtime@1.2.4")
    integrity = "sha512-" + base64.b64encode(bytes(range(64))).decode()
    hexd = bytes(range(64)).hex()
    check("integrity → store file path", store_file_path(Path("/s/files"), integrity, 0o644), Path(f"/s/files/{hexd[:2]}/{hexd[2:]}"))
    check("an executable gets -exec", store_file_path(Path("/s/files"), integrity, 0o755).name.endswith("-exec"), True)
    writers = ["node /opt/homebrew/bin/pnpm install", "pnpm i --frozen-lockfile", "pnpm -C web add zod",
               "pnpm --filter app update", "/opt/homebrew/bin/pnpm", "pnpm dlx create-vite", "pnpx tsx a.ts",
               "node /x/pnpm.cjs fetch"]
    check("installs, dlx and bare pnpm count as busy", [bool(PNPM_BUSY_RE.search(c)) for c in writers], [True] * len(writers))
    readers = ["node /opt/homebrew/bin/pnpm exec vite preview --port 4173", "pnpm run dev", "pnpm dev",
               "pnpm -C web build", "du -sk /Users/me/Library/pnpm", "node /Users/me/Library/pnpm/global/5/.pnpm/x/cli.js"]
    check("SAFETY of the run: exec, scripts and other readers don't block it",
          [bool(PNPM_BUSY_RE.search(c)) for c in readers], [False] * len(readers))

    with tempfile.TemporaryDirectory() as tmp:
        store = Path(tmp) / "store/v10"
        now = time.time()

        def blob(tag: str, days: float, mode: int = 0o644) -> tuple[dict, Path]:
            digest = hashlib.sha512(tag.encode()).digest()
            meta = {"integrity": "sha512-" + base64.b64encode(digest).decode(), "mode": mode, "size": 1}
            path = store_file_path(store / "files", meta["integrity"], mode)
            _write(path, tag, days=days, now=now)
            return meta, path

        def index(key: str, files: dict, days: float, side: dict | None = None) -> Path:
            body = {"name": key.rsplit("@", 1)[0], "version": key.rsplit("@", 1)[1], "requiresBuild": bool(side), "files": files}
            if side:
                body["sideEffects"] = {"darwin-arm64": {"added": side}}
            digest = hashlib.sha256(key.encode()).hexdigest()
            return _write(store / "index" / digest[:2] / f"{digest[2:]}-{key}.json", json.dumps(body), days=days, now=now)

        a, a_path = blob("A", 40)
        b, b_path = blob("B", 40)
        s, s_path = blob("S-side-effect", 40, mode=0o755)
        c, c_path = blob("C", 40)
        n, n_path = blob("N", 1)
        _, orphan_old = blob("orphan-old", 40)
        _, orphan_young = blob("orphan-young", 1)
        index("foo@1.0.0", {"index.js": a}, 40)
        index("@scope+bar@2.0.0", {"index.js": b}, 40, side={"build/out.node": s})
        dropped_index = index("baz@3.0.0", {"index.js": c, "shared.js": a}, 40)
        index("new@1.0.0", {"index.js": n}, 1)
        nm_keys = {"foo@1.0.0", "@scope+bar@2.0.0"}
        drop_index, drop_files = plan_pnpm_store(store, nm_keys, keep_days=7, now=now)
        check("only the old unreferenced package's index goes", drop_index, [dropped_index])
        check("its exclusive file and old orphans go", sorted(drop_files), sorted([c_path, orphan_old]))
        for what, path in [("a file a kept package shares", a_path), ("a scoped package's file", b_path),
                           ("a kept package's side-effect build output", s_path), ("a package stored this week", n_path),
                           ("an orphan written this week (an install in flight)", orphan_young)]:
            check(f"SAFETY: keeps {what}", path in drop_files, False)
        check("SAFETY: unlike `pnpm store prune`, nlink == 1 alone deletes nothing",
              a_path.stat().st_nlink == 1 and a_path not in drop_files, True)

        dlx = Path(tmp) / "dlx"
        k1_new, k1_old = dlx / "k1/19aa-100", dlx / "k1/18aa-90"
        for d in (k1_new, k1_old):
            (d / "node_modules/.pnpm/tool@1.0.0").mkdir(parents=True)
        (dlx / "k1/pkg").symlink_to(k1_new)
        os.utime(dlx / "k1/pkg", (now - 86400, now - 86400), follow_symlinks=False)
        (dlx / "k2/17aa-1/node_modules").mkdir(parents=True)
        (dlx / "k2/pkg").symlink_to(dlx / "k2/17aa-1")
        os.utime(dlx / "k2/pkg", (now - 30 * 86400, now - 30 * 86400), follow_symlinks=False)
        (dlx / "k3/16aa-1/node_modules").mkdir(parents=True)
        (dlx / "k3/pkg").symlink_to(dlx / "k3/16aa-1")
        os.utime(dlx / "k3/pkg", (now - 30 * 86400, now - 30 * 86400), follow_symlinks=False)
        ps_output = f"node {dlx}/k3/16aa-1/node_modules/.bin/mcp-server\n"
        drop, kept_nm = plan_pnpm_dlx(dlx, ps_output, keep_days=7, now=now)
        check("a superseded run goes; a command unused for 7 days goes whole", sorted(drop), sorted([k1_old, dlx / "k2"]))
        check("SAFETY: a dlx command still running is kept", any(str(p).startswith(str(dlx / "k3")) for p in drop), False)
        check("kept runs' node_modules still reference the store", sorted(kept_nm),
              sorted([k1_new / "node_modules", dlx / "k3/16aa-1/node_modules"]))

        caches = Path(tmp) / "Caches/pnpm"
        stale_meta = _write(caches / "metadata-v1.3/registry.npmjs.org/left-pad.json", "{}", days=10, now=now)
        fresh_meta = _write(caches / "metadata-v1.3/registry.npmjs.org/react.json", "{}", days=1, now=now)
        v11_meta = _write(caches / "v11/metadata-full/registry.npmjs.org/a.json", "{}", days=10, now=now)
        other = _write(caches / "lockfile-verified.jsonl", "{}", days=40, now=now)
        drop = plan_pnpm_metadata(caches, keep_days=7, now=now)
        check("metadata files past 7 days go, file by file", sorted(drop), sorted([stale_meta, v11_meta]))
        check("SAFETY: recent metadata and other cache files stay", (fresh_meta in drop, other in drop), (False, False))


def selftest_npm() -> None:
    print("\nnpm: _cacache and _npx")
    writers = ["npm install", "node /opt/homebrew/bin/npm ci", "npm --prefix x i -D foo",
               "/opt/homebrew/bin/npm cache add foo", "npm update"]
    check("installs and cache commands count as busy", [bool(NPM_BUSY_RE.search(c)) for c in writers], [True] * len(writers))
    readers = ["npm run dev", "node /opt/homebrew/bin/npm start", "npm test", "npm --prefix x run build",
               "node /Users/me/.npm/_npx/abc/node_modules/.bin/vite",
               "npm exec @upstash/context7-mcp@latest", "npx -y tsx a.ts", "npm create vite@latest"]
    check("SAFETY of the run: scripts, npx/exec (each agent session's MCP servers; _npx dirs carry their own lock) don't block it",
          [bool(NPM_BUSY_RE.search(c)) for c in readers], [False] * len(readers))
    with tempfile.TemporaryDirectory() as tmp:
        cache = Path(tmp) / "_cacache"
        now = time.time()
        old, young = (now - 30 * 86400) * 1000, (now - 86400) * 1000

        def integrity(tag: str) -> str:
            return "sha512-" + base64.b64encode(hashlib.sha512(tag.encode()).digest()).decode()

        def content(tag: str, days: float) -> Path:
            return _write(cacache_content_path(cache, integrity(tag)), tag, days=days, now=now)

        def line(key: str, tag: str | None, when: float) -> str:
            body = json.dumps({"key": key, "integrity": integrity(tag) if tag else None, "time": when, "size": 1, "metadata": {}})
            return f"{hashlib.sha1(body.encode()).hexdigest()}\t{body}"

        mixed = _write(cache / "index-v5/aa/bb/mixed", "\n" + line("k-old", "I3", old) + "\n" + line("k-young", "I2", young), days=1, now=now)
        all_old = _write(cache / "index-v5/cc/dd/all-old", "\n" + line("k-shared-old", "I1", old) + "\nnot json at all", days=30, now=now)
        _write(cache / "index-v5/ee/ff/shared", "\n" + line("k-shared-young", "I1", young), days=1, now=now)
        tomb = _write(cache / "index-v5/11/22/tomb", "\n" + line("k-gone", "I4", young) + "\n" + line("k-gone", None, young), days=1, now=now)
        i1, i2, i3, i4 = content("I1", 30), content("I2", 1), content("I3", 30), content("I4", 30)
        in_flight = content("I-in-flight", 0)
        plan = plan_cacache(cache, keep_days=7, now=now)
        check("content only expired keys point to goes", sorted(plan.content), sorted([i3, i4]))
        for what, path in [("content a live key shares with an expired one", i1), ("content of a live key", i2),
                           ("content written in the last day (index not appended yet)", in_flight)]:
            check(f"SAFETY: keeps {what}", path in plan.content, False)
        check("a bucket whose keys all expired goes whole, garbage lines tolerated", sorted(plan.drop_buckets), sorted([all_old, tomb]))
        check("a mixed bucket is rewritten to its live keys", [json.loads(ln.split("\t", 1)[1])["key"] for ln in plan.rewrite.get(mixed, [])], ["k-young"])
        stale_tmp = _write(cache / "tmp/abc", "x", days=2, now=now)
        _write(cache / "tmp/def", "x", days=0, now=now)
        check("staging files older than a day go", plan_cacache(cache, keep_days=7, now=now).tmp, [stale_tmp])
        apply_cacache_plan(plan)
        check("applied: content and buckets gone, rewrite kept the live key",
              (i3.exists(), all_old.exists(), "k-young" in mixed.read_text(), "k-old" in mixed.read_text()), (False, False, True, False))

        npx = Path(tmp) / "_npx"
        stale = _aged(_mk(npx / "aaaa"), 10, now)
        fresh = _aged(_mk(npx / "bbbb"), 1, now)
        locked = _mk(npx / "cccc")
        (locked / "concurrency.lock").mkdir()
        _aged(locked, 10, now)
        running = _aged(_mk(npx / "dddd"), 10, now)
        drop = plan_npx(npx, f"node {running}/node_modules/.bin/mcp\n", keep_days=7, now=now)
        check("an npx dir unused for 7 days goes", drop, [stale])
        check("SAFETY: recent, locked (running npx) and process-referenced dirs stay",
              [p in drop for p in (fresh, locked, running)], [False, False, False])


def _mk(path: Path) -> Path:
    path.mkdir(parents=True)
    return path


def selftest_codex() -> None:
    print("\ncodex: sessions and old releases")
    with tempfile.TemporaryDirectory() as tmp:
        home = Path(tmp)
        now = time.time()
        day = 86400
        db = sqlite3.connect(home / "state_5.sqlite")
        db.execute("create table threads(id text, rollout_path text, updated_at integer, is_pinned integer, archived integer)")
        db.execute("create table thread_spawn_edges(parent_thread_id text, child_thread_id text, status text)")

        def thread(tid: str, days: float, pinned: int = 0, file_days: float | None = None, body: bool = True, zst: bool = False) -> Path:
            path = home / "sessions/2026/10/01" / f"rollout-{tid}.jsonl"
            if body:
                target = path.with_name(path.name + ".zst") if zst else path
                _write(target, '{"type":"x"}\n' * 200, days=days if file_days is None else file_days, now=now)
            db.execute("insert into threads values(?,?,?,?,0)", (tid, str(path), int(now - days * day), pinned))
            return path

        thread("c-old", 10)
        thread("d-old", 40)
        thread("fresh", 1)
        thread("pin", 40, pinned=1)
        opened = thread("open", 40)
        thread("parent", 40)
        thread("child", 2)
        thread("touched", 40, file_days=1)
        thread("hist", 40)
        thread("zst", 10, zst=True)
        thread("locked", 40)
        thread("gone", 40, body=False)
        db.execute("insert into thread_spawn_edges values('parent','child','open')")
        db.commit()
        db.close()
        _write(home / "history.jsonl", json.dumps({"session_id": "hist", "ts": int(now - day), "text": "hi"}) + "\n")
        threads = load_codex_threads(home)
        check("schema check: a state db codex 0.167 writes", threads is not None, True)
        plan = plan_codex(threads, codex_history(home), {str(opened)}, {"locked"}, compress_days=7, delete_days=30, now=now)
        check("delete: unused for 30 days, including a dangling row", sorted(t.id for t in plan.delete), ["d-old", "gone"])
        check("compress: unused for 7 days, or kept from deletion only because pinned",
              sorted(t.id for t in plan.compress), ["c-old", "pin"])
        check("skipped with a reason: open in a running codex, writer lock held",
              sorted((t.id, why) for t, why in plan.skipped), [("locked", "writer lock held"), ("open", "open in a running codex")])
        untouched = {"fresh", "parent", "child", "touched", "hist", "zst"}
        acted = {t.id for t in plan.delete + plan.compress} | {t.id for t, _ in plan.skipped}
        check("SAFETY: recent, family-active, recently written or typed-into, already compressed: untouched",
              sorted(untouched & acted), [])

        if shutil.which("zstd"):
            t = threads["c-old"]
            original = t.path.read_bytes()
            mtime = t.path.stat().st_mtime_ns
            locks = home / "thread-writer-locks"
            locks.mkdir()
            held = _write(locks / "c-old.lock", "")
            fd = os.open(held, os.O_RDONLY)
            fcntl.flock(fd, fcntl.LOCK_EX)
            check("SAFETY: a thread with an active writer is not compressed", compress_rollout(home, t), None)
            os.close(fd)
            check("…and nothing is left half done", sorted(p.name for p in t.path.parent.iterdir() if "c-old" in p.name or p.suffix == ".tmp"),
                  ["rollout-c-old.jsonl"])
            check("a changing rollout is not compressed",
                  compress_rollout(home, t, on_encoded=lambda: t.path.open("a").write("more\n")), None)
            t.path.write_bytes(original)
            os.utime(t.path, ns=(mtime, mtime))
            saved = compress_rollout(home, t)
            zst = t.path.with_name(t.path.name + ".zst")
            check("compressed in codex's own format, the plain file removed", (saved is not None, zst.exists(), t.path.exists()), (True, True, False))
            check("lossless", run(["zstd", "-d", "-c", str(zst)]).stdout.encode() == original, True)
            check("mtime kept, so the age signal survives", zst.stat().st_mtime_ns, mtime)
        else:
            print("  (zstd not installed, compression checks skipped)")

        releases = home / "packages/standalone/releases"
        for name in ("0.166.0-aarch64", "0.167.0-aarch64", "0.167.1-aarch64"):
            _write(releases / name / "codex", "bin")
        (home / "packages/standalone/current").symlink_to(releases / "0.167.1-aarch64")
        ps_output = f"{releases}/0.167.0-aarch64/codex resume\n"
        check("old releases nothing runs from go; current and running ones stay",
              plan_codex_releases(home, ps_output), [releases / "0.166.0-aarch64"])

        zstd = shutil.which("zstd")
        if zstd:
            sample = _write(home / "sample.jsonl", "".join(f'{{"n": {i}, "text": "hello"}}\n' for i in range(5000)))
            packed = subprocess.run([zstd, "-3", "-q", "-c", str(sample)], capture_output=True).stdout
            check("dry-run measures the compressed size exactly (rollouts hold base64 images; no fixed ratio)",
                  zstd_size(zstd, sample), len(packed))

        bad = home / "bad"
        bad.mkdir()
        sqlite3.connect(bad / "state_5.sqlite").execute("create table threads(id text)").connection.close()
        check("SAFETY: an unknown state schema → skip the section", load_codex_threads(bad), None)
        check("SAFETY: a renamed state db (new codex) → skip the section", load_codex_threads(home / "packages"), None)

        # `codex delete` of a parent takes its spawned children along; their own delete then fails
        fake = _write(home / "bin/codex", '#!/bin/sh\ncase "$3" in ok) rm -f "$FAKE_DIR/ok" ;; *) echo "Error: failed to delete session" >&2; exit 1 ;; esac\n')
        fake.chmod(0o755)
        files = {tid: _write(home / "del" / tid, "x") for tid in ("ok", "kept")}
        batch = [CodexThread(tid, files.get(tid, home / "del" / tid), now, False, file=home / "del" / tid) for tid in ("ok", "cascaded", "kept")]
        batch.append(CodexThread("dangling", home / "del/dangling", now, False))
        os.environ["FAKE_DIR"] = str(home / "del")
        deleted, refused = delete_codex_threads(str(fake), batch)
        check("a refusal whose rollout is already gone counts as deleted (removed with its parent)", deleted, 2)
        check("real refusals are reported, dangling rows included", [r.split(":")[0] for r in refused], ["kept", "dangling"])


def selftest_dev_space() -> None:
    print("\nprojects / watch: dev-space hand-off")
    check("projects runs the scheduled clean", dev_space_args("projects", dry_run=False), ["clean", "--scheduled"])
    check("projects under --dry-run only reports", dev_space_args("projects", dry_run=True), ["clean", "--scheduled", "-n"])
    check("watch dispatches analysis agents", dev_space_args("watch", dry_run=False), ["watch", "--agent"])
    check("watch under --dry-run neither records, notifies nor dispatches", dev_space_args("watch", dry_run=True),
          ["watch", "--no-record", "--no-notify"])
    check("dry-run exit 1 means there is something to clean", dev_space_found("projects", 1, dry_run=True), 1)
    check("exit 0 means done", dev_space_found("projects", 0, dry_run=False), 0)
    try:
        dev_space_found("projects", 2, dry_run=False)
        failed = False
    except RuntimeError:
        failed = True
    check("exit 2 fails the section (reported by run_sections)", failed, True)
    order = DEFAULT_TARGETS
    caches = ["cargo", "uv", "go", "pnpm", "npm", "codex"]
    check("projects runs before every cache section, so stale node_modules/.venv no longer pin them",
          all(order.index("projects") < order.index(c) for c in caches), True)
    check("watch runs last, measuring what the run left", order[-1], "watch")
    check("the new sections free disk, not memory", {"projects", "go", "pnpm", "npm", "codex", "watch"} <= DISK_TARGETS, True)


def selftest() -> int:
    print("parse_etime")
    check("mm:ss", parse_etime("08:50"), 530)
    check("hh:mm:ss", parse_etime("23:12:10"), 83530)
    check("dd-hh:mm:ss", parse_etime("01-21:18:20"), 163100)
    check("multi-day", parse_etime("09-23:51:05"), 863465)
    check("padded single digit", parse_etime("0:05"), 5)
    check("garbage → 0", parse_etime("ELAPSED"), 0)

    print("\nparse_agent_browser_procs")
    instances, orphans = parse_agent_browser_procs(PS_FIXTURE)
    by_uuid = {i.uuid: i for i in instances}
    check(
        "finds 2 instances",
        sorted(by_uuid),
        ["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3", "7b38b244-8dff-466b-9124-6323ec0ca515"],
    )
    hot = by_uuid["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3"]
    check("groups whole chrome tree", sorted(hot.pids), [4497, 4512, 4518])
    check("links spawning daemon", hot.daemon_pid, 96741)
    check("identifies chrome root", hot.root_pid, 4497)
    check("age spans daemon lifetime", hot.age_seconds, 164702)
    check("sums cpu across tree", round(hot.cpu_pct, 1), 199.3)
    check("orphan daemon w/o chrome", orphans, [(11213, 37725)])
    all_touched = {p for i in instances for p in i.all_pids} | {p for p, _ in orphans}
    check("SAFETY: user's own chrome untouched", 2843 in all_touched, False)
    check("SAFETY: launchd untouched", 1 in all_touched, False)

    print("\nselect_instances")
    # Fixture ages: 78de5d01 = 45.7h, 7b38b244 = 23.2h, orphan 11213 = 10.5h.
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours=24)
    check("age filter kills the stale one", [i.uuid for i in kill_i], ["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3"])
    check("age filter keeps the fresh one", [i.uuid for i in kept], ["7b38b244-8dff-466b-9124-6323ec0ca515"])
    check("age filter keeps fresh orphan", kill_o, [])
    kill_i, _, kept = select_instances(instances, orphans, min_age_hours=1)
    check("1h cutoff catches both day-old sessions", (len(kill_i), len(kept)), (2, 0))
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours=0)
    check("min_age 0 takes everything", (len(kill_i), len(kill_o), len(kept)), (2, 1, 0))

    print("\nparse_booted_devices")
    devices = parse_booted_devices(SIMCTL_FIXTURE)
    check("only booted devices", [d["name"] for d in devices], ["iPhone 17 Pro", "iPhone 17"])
    check("keeps udid", devices[0]["udid"], "286BA6DA-9436-454A-A33F-C3406AF6F74C")
    check("empty runtime tolerated", parse_booted_devices('{"devices":{"x":[]}}'), [])
    check("malformed → empty", parse_booted_devices("not json"), [])

    print("\nhelpers")
    check("counts sim runtime procs", count_procs(AGENT_BROWSER_UDD_RE, PS_FIXTURE), 4)
    check("human_age days", human_age(164702), "1d21h")
    check("human_age hours", human_age(83530), "23h12m")
    check("human_age minutes", human_age(530), "8m50s")

    print("\ncargo: parse_sweep_bytes")
    check("cleaned GiB", parse_sweep_bytes('[INFO] Cleaned 4.51 GiB from "/c/cargo-target"\n'), int(4.51 * 1024**3))
    check("would clean KiB", parse_sweep_bytes('[INFO] Would clean: 21.69 KiB from "/c"'), int(21.69 * 1024))
    check("plain bytes", parse_sweep_bytes('[INFO] Cleaned 512.00 B from "/c"'), 512)
    check("nothing → 0", parse_sweep_bytes('[INFO] Cleaned nothing from "/c"'), 0)
    # cargo-sweep logs its failures and still exits 0, so "no result line" is the failure signal.
    check("error output → None", parse_sweep_bytes('Error: Failed to gather metadata for "/c"'), None)

    print("\ncargo: pick_shared_target")
    stub = Path("/var/folders/zz/T/mac-dev-cleanup-stub")
    check(
        "configured target-dir is picked",
        pick_shared_target('{"target_directory": "/Users/me/Library/Caches/cargo-target"}', stub),
        Path("/Users/me/Library/Caches/cargo-target"),
    )
    check(
        "stub-local target → None (no target-dir configured)",
        pick_shared_target('{"target_directory": "/var/folders/zz/T/mac-dev-cleanup-stub/target"}', stub),
        None,
    )
    check(
        "/private/var alias of the stub → still None",
        pick_shared_target('{"target_directory": "/private/var/folders/zz/T/mac-dev-cleanup-stub/target"}', stub),
        None,
    )

    print("\ncargo: human_bytes")
    check("GiB", human_bytes(19.5 * 1024**3), "19.5 GiB")
    check("MiB", human_bytes(21 * 1024**2), "21.0 MiB")
    check("bytes", human_bytes(512), "512 B")

    print("\ncargo: lock_target")
    with tempfile.TemporaryDirectory() as tmp:
        target = Path(tmp)
        locks = [target / "debug/.cargo-lock", target / "debug/.cargo-build-lock", target / "release/.cargo-lock"]
        for path in locks:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.touch()
        fds = lock_target(target)
        check("idle target → takes every lock", len(fds or []), 3)
        for fd in fds or []:
            os.close(fd)
        # A running cargo holds one of them (possibly shared, e.g. the artifact lock).
        busy = os.open(locks[2], os.O_RDONLY)
        fcntl.flock(busy, fcntl.LOCK_SH)
        check("a lock held by cargo → None", lock_target(target), None)
        probe = os.open(locks[0], os.O_RDONLY)
        try:
            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
            released = True
        except BlockingIOError:
            released = False
        check("backing off releases the locks it already took", released, True)
        os.close(probe)
        os.close(busy)
        check("no lock files → nothing to take", lock_target(target / "missing"), [])

    print("\ngames: parse_game_procs")
    found = parse_game_procs(GAMES_PS_FIXTURE)
    check("Hearthstone with its embedded browser", sorted(found.get("Hearthstone", [])), [62114, 62120])
    check("Battle.net with its helpers", sorted(found.get("Battle.net", [])), [51000, 51010, 51020])
    check("Blizzard's background update agent", sorted(found.get("Blizzard Agent", [])), [50990])
    touched = set().union(*found.values())
    check("SAFETY: Steam untouched (not on the list)", 778 in touched, False)
    check("SAFETY: the user's Chrome untouched", 779 in touched, False)
    check("SAFETY: launchd untouched", 1 in touched, False)
    check("no games running → empty", parse_game_procs("    1 /sbin/launchd\n"), {})

    print("\ngames: quit_script")
    script = quit_script("net.battle.app")
    # `tell application` launches an app that isn't running.
    check("only targets an app that is running", script[0], 'if application id "net.battle.app" is running then')
    # A quit confirmation dialog would otherwise hang osascript until the subprocess timeout.
    check("does not wait for the app to answer", "ignoring application responses" in script, True)

    print("\ngames: default run")
    # The 06:00 run and any manual `mac-dev-cleanup` must never close a game mid-match;
    # games are closed only by the explicit `--only games` evening job.
    check("games are not in the default targets", "games" in DEFAULT_TARGETS, False)

    print("\nuv: uv_layout_matches")
    with tempfile.TemporaryDirectory() as tmp:
        binary = Path(tmp) / "uv"
        # Rust packs string literals back to back, with no separator.
        binary.write_bytes(b"\x00junk" + "".join(UV_BUCKETS).encode() + b"more")
        check("a uv built with every bucket name we know", uv_layout_matches(binary), True)
        binary.write_bytes("".join(UV_BUCKETS).replace("wheels-v5", "wheels-v6").encode())
        check("a uv whose wheel bucket moved on → skip", uv_layout_matches(binary), False)

    print("\nuv: young_uv_holders")
    rows = parse_ps(UV_PS_FIXTURE)
    check(
        "a uv started minutes ago is busy; residents and our own launcher are not",
        young_uv_holders({1514, 1515, 47020, 900}, rows, self_pid=901, min_age=600),
        [47020],
    )
    check("a holder that exited since lsof is ignored", young_uv_holders({99999}, rows, self_pid=901, min_age=600), [])

    print("\nuv: plan_uv_cleanup")
    with tempfile.TemporaryDirectory() as tmp:
        cache = Path(tmp)
        now = time.time()
        old, recent, fresh = now - 200 * 86400, now - 5 * 86400, now
        archive = cache / "archive-v0"

        def entry(path: Path, born: float, venv: bool = False) -> Path:
            path.mkdir(parents=True)
            if venv:
                (path / "pyvenv.cfg").write_text("uv = 0.9.17\n")
            os.utime(path, (born, born))  # an mtime before the birth time moves the birth time back on APFS
            return path

        def link(path: Path, target: Path) -> Path:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.symlink_to(target)
            return path

        for name in ("CACHEDIR.TAG", ".gitignore", ".lock"):
            (cache / name).touch()
        current_bucket = entry(cache / "simple-v18", old)
        entry(cache / "simple-v15", old)  # an older uv's bucket
        entry(cache / ".tmpCrashed", recent)  # temp dir of a uv run that died
        in_flight_tmp = entry(cache / ".tmpInFlight", fresh)  # temp dir of a uv run going on now

        old_wheel = entry(archive / "OLDWHEELxxxxxxxxxxxxx", old)
        old_wheel_link = link(cache / "wheels-v5/pypi/foo/1.0-py3-none-any", old_wheel)
        old_wheel_pointer = cache / "wheels-v5/pypi/foo/1.0-py3-none-any.http"
        old_wheel_pointer.write_bytes(b"\x95\xb5" + old_wheel.name.encode())
        new_wheel = entry(archive / "NEWWHEELxxxxxxxxxxxxx", recent)
        link(cache / "wheels-v5/pypi/foo/2.0-py3-none-any", new_wheel)
        built = entry(archive / "BUILTxxxxxxxxxxxxxxxx", old)
        link(cache / "sdists-v9/pypi/bar/1.0/rev/bar-1.0-py3-none-any", built)
        orphan = entry(archive / "ORPHANxxxxxxxxxxxxxxx", recent)
        fresh_orphan = entry(archive / "FRESHORPHANxxxxxxxxxx", fresh)
        pointer_only = entry(archive / "POINTERONLYxxxxxxxxxx", recent)
        (cache / "sdists-v9/pypi/baz").mkdir(parents=True)
        (cache / "sdists-v9/pypi/baz/revision.http").write_bytes(b"\xb5" + pointer_only.name.encode() + b"\x92")
        old_env_archive = entry(archive / "OLDENVxxxxxxxxxxxxxxx", old, venv=True)
        old_env_link = link(cache / "environments-v2/1111aaaa/2222bbbb", old_env_archive)
        busy_env_archive = entry(archive / "BUSYENVxxxxxxxxxxxxxx", old, venv=True)
        link(cache / "environments-v2/1111aaaa/3333cccc", busy_env_archive)
        old_script = entry(cache / "environments-v2/oldscript-abc", old, venv=True)
        resident = entry(cache / "environments-v2/proc-top-e16", old, venv=True)
        new_script = entry(cache / "environments-v2/newscript-def", recent, venv=True)
        ps_output = (
            f"{resident}/bin/python3 /Users/me/.local/share/proc-top/proc_top.py\n"
            f"{cache}/environments-v2/1111aaaa/3333cccc/bin/python -m some_tool\n"
        )

        removals, in_use = plan_uv_cleanup(cache, keep_days=90, ps_output=ps_output, now=now)
        by_kind: dict[str, list[str]] = {}
        for item in removals:
            by_kind.setdefault(item.kind, []).append(item.path.name)
        check("old buckets and dead runs' temp dirs", sorted(by_kind.get("stale", [])), [".tmpCrashed", "simple-v15"])
        check("unreferenced archives", by_kind.get("orphan"), [orphan.name])
        check("downloaded wheels past the age limit", by_kind.get("wheel"), [old_wheel.name])
        check(
            "script and cached environments past the age limit",
            sorted(by_kind.get("env", [])),
            sorted([old_env_archive.name, old_script.name]),
        )
        wheel = next(i for i in removals if i.kind == "wheel")
        check("a wheel goes with its index symlink", wheel.links, [old_wheel_link])
        cached_env = next(i for i in removals if i.path == old_env_archive)
        check("a cached env goes with its environments-v2 symlink", cached_env.links, [old_env_link])
        check(
            "SAFETY: environments a process runs from are kept and reported",
            sorted(in_use),
            ["environments-v2/1111aaaa/3333cccc", "environments-v2/proc-top-e16"],
        )
        removed = {i.path for i in removals}
        for what, path in [
            ("an archive created in the last day (install in flight)", fresh_orphan),
            ("a wheel built from source (rebuilding needs a toolchain)", built),
            ("an archive only a pointer file names", pointer_only),
            ("a recent wheel", new_wheel),
            ("a recent script env", new_script),
            ("the bucket the installed uv uses", current_bucket),
            ("a running uv's temp dir", in_flight_tmp),
        ]:
            check(f"SAFETY: keeps {what}", path in removed, False)
        check("SAFETY: never touches uv's marker files", {p.name for p in removed} & UV_MARKERS, set())

        apply_uv_plan(cache, removals)
        check("removed entries are gone", [i.path for i in removals if i.path.exists()], [])
        check("their symlinks are gone", [lk for i in removals for lk in i.links if lk.is_symlink()], [])
        # uv 0.9.17 treats a pointer to a missing archive as stale and downloads again.
        check("the wheel's .http pointer stays", old_wheel_pointer.exists(), True)
        kept = (fresh_orphan, built, pointer_only, new_wheel, busy_env_archive, resident, new_script)
        check("kept entries survive", [p.name for p in kept if not p.exists()], [])
        check("no trash left behind", [p.name for p in cache.iterdir() if p.name.startswith(UV_TRASH_PREFIX)], [])

    print("\nuv: default run")
    check("the uv cache is trimmed by the daily run", "uv" in DEFAULT_TARGETS, True)

    print("\nclones: plan_clone_cleanup")
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        now = time.time()
        rows = parse_ps(CLONE_PS_FIXTURE)
        starts = {pid: now - age for pid, _, age, *_ in rows}

        def make_clone(bundle_id: str, suffix: str, exe: str | None, born: float) -> Path:
            path = root / f"{bundle_id}.code_sign_clone/code_sign_clone.{suffix}"
            contents = path / f"{exe or 'Unknown'}.app.bundle/Contents"
            contents.mkdir(parents=True)
            if exe:
                (contents / "Info.plist").write_bytes(plistlib.dumps({"CFBundleExecutable": exe}))
            os.utime(path, (born, born))  # moves the birth time back, see uv above
            return path

        chrome, sun = "com.google.Chrome", "com.adspower.SunBrowser"
        make_clone(chrome, "MAIN01", "Google Chrome", starts[84743] + 1)
        make_clone(chrome, "AGENT1", "Google Chrome", starts[97388] + 1)
        make_clone(sun, "SUN001", "SunBrowser", starts[24480] - 2)
        make_clone(chrome, "NOPLST", None, now - 30 * 86400)
        make_clone(chrome, "BEFORE", "Google Chrome", starts[84743] - 50_000)
        make_clone(chrome, "LATER1", "Google Chrome", starts[84743] + 3600)
        killed = make_clone(chrome, "KILLED", "Google Chrome", starts[55555] + 1)
        make_clone(chrome, "OTHER1", "Google Chrome", starts[24480] + 1)

        orphans, kept = plan_clone_cleanup(read_clones(root), rows, now)
        owners = {c.path.suffix[1:]: c.owner for c in kept}
        check("the user's long-running Chrome keeps the clone it made at launch", owners.get("MAIN01"), 84743)
        check("a running agent-browser Chrome keeps its clone", owners.get("AGENT1"), 97388)
        check("another Chromium app is matched by its own executable", owners.get("SUN001"), 24480)
        check("SAFETY: a clone whose app can't be identified is kept", "NOPLST" in owners, True)
        check(
            "orphans: born long before or after a launch, by a browser whose renderer outlived it, "
            "or when only another app launched",
            sorted(c.path.suffix[1:] for c in orphans),
            ["BEFORE", "KILLED", "LATER1", "OTHER1"],
        )

        print("\nclones: remove_clones")
        crashed_run = root / f"{CLONE_TRASH_PREFIX}crashed"
        (crashed_run / "leftover").mkdir(parents=True)
        os.utime(crashed_run, (now - 7200, now - 7200))
        running = root / f"{CLONE_TRASH_PREFIX}running"
        running.mkdir()
        stale = stale_clone_trash(root, now)
        check("trash a crashed run left behind is picked up, a running one's is not", stale, [crashed_run])

        shutil.rmtree(killed)  # its browser deleted it between the plan and the removal
        check("removes the orphans, skipping one already gone", remove_clones(root, orphans, stale), 3)
        check("orphans are gone", [c.path.name for c in orphans if c.path.exists()], [])
        check("kept clones survive", [c.path.name for c in kept if not c.path.exists()], [])
        check(
            "no trash left behind but the running one's",
            sorted(p.name for p in root.glob(f"{CLONE_TRASH_PREFIX}*")),
            [running.name],
        )

    print("\nclones: default run")
    check("orphaned clones are removed by the daily run", "clones" in DEFAULT_TARGETS, True)
    check("the clone step frees disk, not memory", "clones" in DISK_TARGETS, True)

    selftest_measure_real()
    selftest_code_index()
    selftest_cargo_rearm()
    selftest_uv_refs()
    selftest_go()
    selftest_pnpm()
    selftest_npm()
    selftest_codex()
    selftest_dev_space()

    print("\nrun_sections")
    ran = []

    def hung_simctl() -> int:
        raise subprocess.TimeoutExpired(["xcrun", "simctl", "list"], 60)

    def cargo_ok() -> int:
        ran.append("cargo")
        return 3

    found_count, failed = run_sections([("sim", hung_simctl), ("cargo", cargo_ok)])
    check("a crashing section does not skip the rest (2026-10-23 06:00)", ran, ["cargo"])
    check("the failed section is reported by name", failed, ["sim"])
    check("found still counts the sections that ran", found_count, 3)

    print()
    if _FAILED:
        print(f"❌ {_FAILED} check(s) failed")
    else:
        print("✅ all checks passed")
    return 1 if _FAILED else 0


# ── Main ────────────────────────────────────────────────────
def run_sections(sections: list[tuple[str, Callable[[], int]]]) -> tuple[int, list[str]]:
    """Run each cleanup in turn. Returns (total found, names of sections that crashed).

    Part of main's top level: one section crashing must not skip the rest. On
    2026-10-23 `simctl list` hung for 60s right after the 05:30 wake, and the traceback
    took the cargo sweep down with it.
    """
    found, failed = 0, []
    for name, section in sections:
        try:
            found += section()
        except Exception as e:  # noqa: BLE001
            failed.append(name)
            print(f"{DANGER_MARKER} {name} failed: {e!r}")
        print()
    return found, failed


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Release iOS simulator, agent-browser, project, dev cache, codex session and browser "
        "code-sign clone resources",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-n", "--dry-run", action="store_true", help="Report what would be cleaned, change nothing")
    parser.add_argument(
        "--only",
        choices=[*DEFAULT_TARGETS, "games"],
        help="Run one section: browser (agent-browser Chrome), sim (simulators), projects "
        "(dev-space clean --scheduled), cargo, uv, go, pnpm, npm (dev caches), codex (sessions), "
        "clones (browser code-sign clones), watch (dev-space watch --agent), or games "
        "(default: all but games, which only ever run when asked for explicitly)",
    )
    parser.add_argument(
        "--min-age",
        type=float,
        default=0,
        metavar="HOURS",
        help="Only reap agent-browser sessions older than HOURS (default: 0 = all). "
        "Use e.g. --min-age 2 to run this while a session is actively driving a browser.",
    )
    parser.add_argument(
        "--cargo-days",
        type=int,
        default=7,
        metavar="DAYS",
        help="Remove cargo artifacts no build has used for DAYS (default: 7)",
    )
    # cargo-sweep reads "GB" as 10^9 and sums apparent file sizes, counting the hardlinks
    # between incremental/ and deps/ twice, so its total runs ~5% above `du`. Use GiB.
    parser.add_argument(
        "--cargo-max-size",
        default="20GiB",
        metavar="SIZE",
        help="Then remove least recently used artifacts until the target fits SIZE, as cargo-sweep "
        "measures it: apparent size, a bit above du (default: 20GiB; note GB means 10^9)",
    )
    parser.add_argument(
        "--uv-days",
        type=int,
        default=7,
        metavar="DAYS",
        help="Remove uv cache entries created more than DAYS ago that no active project pins "
        "(default: 7). uv keeps no last-use time; a still-needed one is just fetched again",
    )
    for tool, what in (("go", "go module versions"), ("pnpm", "pnpm store packages, dlx runs and metadata"),
                       ("npm", "npm _cacache entries and _npx packages")):
        parser.add_argument(
            f"--{tool}-days",
            type=int,
            default=7,
            metavar="DAYS",
            help=f"Remove {what} no active project references and nothing used for DAYS (default: 7)",
        )
    parser.add_argument(
        "--codex-compress-days",
        type=int,
        default=7,
        metavar="DAYS",
        help="zstd-compress codex sessions untouched for DAYS (default: 7); codex reads them as is",
    )
    parser.add_argument(
        "--codex-delete-days",
        type=int,
        default=30,
        metavar="DAYS",
        help="`codex delete` unpinned sessions untouched for DAYS (default: 30)",
    )
    parser.add_argument("--selftest", action="store_true", help="Run behaviour checks and exit")
    args = parser.parse_args()

    if args.selftest:
        return selftest()

    if sys.platform != "darwin":
        print("macOS only", file=sys.stderr)
        return 1

    # Under launchd the output is appended to a log file forever, so stamp each run.
    if not sys.stdout.isatty():
        print(f"═══ mac-dev-cleanup {time.strftime('%Y-%m-%d %H:%M:%S')} ═══")

    targets = [args.only] if args.only else DEFAULT_TARGETS
    # Only processes affect memory; the other sections free disk.
    track_memory = not set(targets) <= DISK_TARGETS
    if track_memory:
        free_before, swap_before = mem_stats()

    sections = {
        "browser": lambda: cleanup_agent_browser(args.min_age, args.dry_run),
        "sim": lambda: cleanup_simulators(args.dry_run),
        "cargo": lambda: cleanup_cargo(args.cargo_days, args.cargo_max_size, args.dry_run),
        "projects": lambda: run_dev_space("projects", args.dry_run),
        "uv": lambda: cleanup_uv(args.uv_days, args.dry_run),
        "go": lambda: cleanup_go(args.go_days, args.dry_run),
        "pnpm": lambda: cleanup_pnpm(args.pnpm_days, args.dry_run),
        "npm": lambda: cleanup_npm(args.npm_days, args.dry_run),
        "codex": lambda: cleanup_codex(args.codex_compress_days, args.codex_delete_days, args.dry_run),
        "clones": lambda: cleanup_clones(args.dry_run),
        "watch": lambda: run_dev_space("watch", args.dry_run),
        "games": lambda: cleanup_games(args.dry_run),
    }
    found, failed = run_sections([(name, sections[name]) for name in targets])

    if track_memory and not args.dry_run:
        free_after, swap_after = mem_stats()
        parts = []
        if free_before is not None and free_after is not None:
            parts.append(f"free memory {free_before:.0f}% → {free_after:.0f}%")
        if swap_before is not None and swap_after is not None:
            parts.append(f"swap {swap_before:.2f}G → {swap_after:.2f}G")
        if parts:
            print("  ".join(parts))

    if failed:
        return 2
    # Under --dry-run, a non-zero exit means "there is something to clean".
    return 1 if args.dry_run and found else 0


if __name__ == "__main__":
    sys.exit(main())
