#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Release macOS dev resources: booted iOS simulators, agent-browser Chrome trees, stale
Rust build artifacts in the shared cargo target dir, unused entries in the uv, go, pnpm
and npm caches, expired codex sessions, and code-sign clones left behind by browsers that
did not quit normally. The per-project rules and the disk monitor live in dev-space, next
to this script; the `projects` and `watch` sections run it, so the 06:00 job stays the
single entry point.

None of them cleans up after itself. A booted simulator keeps a full launchd_sim tree of
iOS daemons and widget extensions alive (hundreds of processes, GBs of RAM); a leaked
agent-browser session keeps a ~10-process headless Chrome tree spinning at ~100% CPU
per renderer, indefinitely; and a target dir shared by every Rust project only grows, as
do the package caches, which keep every version they ever fetched. Every killed Chrome
leaves a copy of its app bundle under /var/folders, which keeps the version it was
launched from on disk after the app has updated.

Cache sections keep what an active project (~/Code, committed or edited within 30 days)
references and what was used within the last week, and report two sizes: du, and real,
the space deleting it frees (uv and pnpm files are APFS clones of each other and of the
projects' copies, so du overstates them several times).

`--only games` (never part of the default run) closes Hearthstone and Battle.net before
the night, when the Mac wakes on its own for agents: left open, the game keeps the
display from sleeping and Battle.net's helpers compete with the agents' work.

Exit code: 0 on success, 2 if a section crashed (the others still ran). With --dry-run,
1 means there is something to clean (so it composes as a check, like mac-health).
"""

import argparse
import base64
import contextlib
import ctypes
import fcntl
import hashlib
import json
import os
import plistlib
import re
import shutil
import signal
import sqlite3
import stat
import struct
import subprocess
import sys
import tempfile
import time
import tomllib
from collections.abc import Callable, Iterable, Iterator
from dataclasses import dataclass, field
from pathlib import Path

# Chrome's --user-data-dir is what ties a process to an agent-browser session, and is
# the only reliable discriminator from the user's own Chrome.
AGENT_BROWSER_UDD_RE = re.compile(r"--user-data-dir=\S*?agent-browser-chrome-([0-9a-fA-F-]{36})")
AGENT_BROWSER_DAEMON_RE = re.compile(r"node_modules/agent-browser/bin/agent-browser-darwin")
# Only the browser process itself lacks --type=; helpers all carry one.
CHROME_ROOT_RE = re.compile(r"/Google Chrome\.app/Contents/MacOS/Google Chrome\b")
SIM_RUNTIME_RE = re.compile(r"simruntime/Contents/Resources/RuntimeRoot")
SIMULATOR_APP_RE = re.compile(r"Simulator\.app/Contents/MacOS/Simulator\b")

# `ps` truncates the command column to terminal width unless -ww is given, which
# silently hides processes whose --user-data-dir sits past the cutoff.
PS_ARGS = ["ps", "-Awwo", "pid,ppid,etime,pcpu,command"]

DANGER_MARKER = "⚠️"

# clones runs after browser, so it also takes the clones of the sessions browser just killed.
# projects (dev-space's per-project rules) runs before the caches, so references from the
# node_modules and .venvs it removes no longer keep cache entries alive; watch measures last.
DEFAULT_TARGETS = ["browser", "sim", "projects", "cargo", "uv", "go", "pnpm", "npm", "codex", "clones", "watch"]
# These free disk, not memory.
DISK_TARGETS = {"projects", "cargo", "uv", "go", "pnpm", "npm", "codex", "clones", "watch"}


@dataclass(frozen=True)
class Game:
    """A game or launcher to close in the evening, matched on its executable path."""

    name: str
    exe_re: re.Pattern
    bundle_id: str | None = None  # asked to quit via AppleScript; None = background helper, signals only


GAMES = [
    Game(
        "Hearthstone",
        re.compile(r"/(?:Hearthstone|Hearthstone Beta Launcher|BlizzardBrowser)\.app/Contents/MacOS/"),
        bundle_id="unity.Blizzard Entertainment.Hearthstone",
    ),
    # Its Helper processes (Chromium renderers etc.) run from a versioned framework under
    # ~/Library/Application Support/Battle.net/Versions/, not from inside the app bundle.
    Game("Battle.net", re.compile(r"/Battle\.net\.app/Contents/|/Battle\.net/Versions/"), bundle_id="net.battle.app"),
    Game("Blizzard Agent", re.compile(r"/Battle\.net/Agent/")),
]
GAMES_PS_ARGS = ["ps", "-Awwo", "pid=,comm="]
# Long enough for a game to save and shut down on its own before it gets signalled.
GAME_QUIT_GRACE = 20.0


@dataclass
class Instance:
    """One agent-browser session: its Chrome process tree plus the daemon that spawned it."""

    uuid: str
    pids: set[int] = field(default_factory=set)
    daemon_pid: int | None = None
    root_pid: int | None = None
    age_seconds: int = 0
    cpu_pct: float = 0.0

    @property
    def all_pids(self) -> set[int]:
        return self.pids | ({self.daemon_pid} if self.daemon_pid else set())


# ── Parsing ─────────────────────────────────────────────────
def parse_etime(etime: str) -> int:
    """Convert a ps ELAPSED field ([[dd-]hh:]mm:ss) to seconds. Unparseable → 0."""
    days, _, clock = etime.strip().rpartition("-")
    parts = clock.split(":")
    if not all(p.isdigit() for p in parts) or not 2 <= len(parts) <= 3:
        return 0
    if days and not days.isdigit():
        return 0
    nums = [int(p) for p in parts]
    seconds = nums.pop()
    seconds += nums.pop() * 60
    if nums:
        seconds += nums.pop() * 3600
    if days:
        seconds += int(days) * 86400
    return seconds


def parse_ps(ps_output: str) -> list[tuple[int, int, int, float, str]]:
    """Split ps output into (pid, ppid, age_seconds, cpu_pct, command) rows."""
    rows = []
    for line in ps_output.splitlines():
        fields = line.split(maxsplit=4)
        if len(fields) < 5 or not fields[0].isdigit():
            continue  # header or malformed
        pid, ppid, etime, pcpu, command = fields
        rows.append((int(pid), int(ppid), parse_etime(etime), float(pcpu), command))
    return rows


def parse_agent_browser_procs(ps_output: str) -> tuple[list[Instance], list[tuple[int, int]]]:
    """Split ps output into agent-browser instances and orphan daemons.

    Returns (instances, orphan_daemons) where orphan_daemons is [(pid, age_seconds)]
    for daemons with no Chrome tree left. Never matches the user's own Chrome.
    """
    rows = parse_ps(ps_output)
    daemons = {pid: age for pid, _, age, _, cmd in rows if AGENT_BROWSER_DAEMON_RE.search(cmd)}

    instances: dict[str, Instance] = {}
    for pid, ppid, age, cpu, command in rows:
        match = AGENT_BROWSER_UDD_RE.search(command)
        if not match:
            continue
        inst = instances.setdefault(match.group(1), Instance(uuid=match.group(1)))
        inst.pids.add(pid)
        inst.age_seconds = max(inst.age_seconds, age)
        inst.cpu_pct += cpu
        # The root browser process is the one without --type=; its parent is the daemon.
        if CHROME_ROOT_RE.search(command) and "--type=" not in command:
            inst.root_pid = pid
            if ppid in daemons:
                inst.daemon_pid = ppid
                inst.age_seconds = max(inst.age_seconds, daemons[ppid])

    claimed = {i.daemon_pid for i in instances.values() if i.daemon_pid}
    orphans = sorted((pid, age) for pid, age in daemons.items() if pid not in claimed)
    return list(instances.values()), orphans


def select_instances(
    instances: list[Instance],
    orphans: list[tuple[int, int]],
    min_age_hours: float,
) -> tuple[list[Instance], list[tuple[int, int]], list[Instance]]:
    """Partition by age. Returns (instances_to_kill, orphans_to_kill, instances_kept)."""
    cutoff = min_age_hours * 3600
    kill_i = [i for i in instances if i.age_seconds >= cutoff]
    kept = [i for i in instances if i.age_seconds < cutoff]
    kill_o = [(pid, age) for pid, age in orphans if age >= cutoff]
    return kill_i, kill_o, kept


def parse_booted_devices(simctl_json: str) -> list[dict[str, str]]:
    """Extract booted devices from `simctl list devices -j` output."""
    try:
        data = json.loads(simctl_json)
    except json.JSONDecodeError:
        return []
    booted = []
    for runtime, devices in (data.get("devices") or {}).items():
        for device in devices:
            if device.get("state") == "Booted":
                booted.append(
                    {
                        "udid": device.get("udid", "?"),
                        "name": device.get("name", "?"),
                        "runtime": runtime.rsplit(".", 1)[-1],
                    }
                )
    return booted


def parse_game_procs(ps_output: str) -> dict[str, set[int]]:
    """Running game processes by game name, from `ps -o pid=,comm=` output."""
    found: dict[str, set[int]] = {}
    for line in ps_output.splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) < 2 or not fields[0].isdigit():
            continue
        game = next((g for g in GAMES if g.exe_re.search(fields[1])), None)
        if game:
            found.setdefault(game.name, set()).add(int(fields[0]))
    return found


def quit_script(bundle_id: str) -> list[str]:
    """AppleScript lines that ask a running app to quit, without launching or waiting on it.

    By bundle id: Launch Services does not resolve "Battle.net" as an app name (`open -a` fails).
    """
    return [
        f'if application id "{bundle_id}" is running then',
        "ignoring application responses",
        f'tell application id "{bundle_id}" to quit',
        "end ignoring",
        "end if",
    ]


# ── Process helpers ─────────────────────────────────────────
def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def ps_snapshot() -> str:
    return run(PS_ARGS, timeout=20).stdout


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError) as e:
        return isinstance(e, PermissionError)  # exists but not ours
    return True


def kill_pids(pids: set[int], grace: float = 6.0) -> tuple[int, int]:
    """SIGTERM, wait for exit, then SIGKILL survivors. Returns (termed, force_killed)."""
    termed = 0
    for pid in sorted(pids):
        try:
            os.kill(pid, signal.SIGTERM)
            termed += 1
        except (ProcessLookupError, PermissionError):
            pass

    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        if not any(alive(pid) for pid in pids):
            return termed, 0
        time.sleep(0.3)

    forced = 0
    for pid in sorted(pids):
        if not alive(pid):
            continue
        try:
            os.kill(pid, signal.SIGKILL)
            forced += 1
        except (ProcessLookupError, PermissionError):
            pass
    return termed, forced


def count_procs(pattern: re.Pattern, ps_output: str) -> int:
    return sum(1 for *_, cmd in parse_ps(ps_output) if pattern.search(cmd))


def human_age(seconds: int) -> str:
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        return f"{days}d{hours}h"
    if hours:
        return f"{hours}h{minutes}m"
    return f"{minutes}m{seconds % 60}s"


# ── Memory snapshot ─────────────────────────────────────────
def mem_stats() -> tuple[float | None, float | None]:
    """Return (system free memory %, swap used GB) — both None if unavailable."""
    free_pct = None
    out = run(["memory_pressure", "-Q"], timeout=15).stdout
    match = re.search(r"free percentage:\s*(\d+)", out)
    if match:
        free_pct = float(match.group(1))

    swap_gb = None
    out = run(["sysctl", "-n", "vm.swapusage"], timeout=10).stdout
    match = re.search(r"used\s*=\s*([\d.]+)M", out)
    if match:
        swap_gb = float(match.group(1)) / 1024
    return free_pct, swap_gb


# ── agent-browser cleanup ───────────────────────────────────
def cleanup_agent_browser(min_age_hours: float, dry_run: bool) -> int:
    """Close agent-browser sessions. Returns the number of processes reaped (or found)."""
    print("── agent-browser ──────────────────────────────────")
    instances, orphans = parse_agent_browser_procs(ps_snapshot())
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours)

    if not kill_i and not kill_o:
        suffix = f" ({len(kept)} newer than {min_age_hours}h kept)" if kept else ""
        print(f"nothing to clean{suffix}")
        return 0

    for inst in kill_i:
        marker = f" {DANGER_MARKER} runaway" if inst.cpu_pct > 100 else ""
        print(
            f"  session {inst.uuid[:8]}  age {human_age(inst.age_seconds):>7}  "
            f"{len(inst.all_pids):>2} procs  {inst.cpu_pct:>5.0f}% CPU{marker}"
        )
    for pid, age in kill_o:
        print(f"  idle daemon pid {pid}  age {human_age(age):>7}  (no browser attached)")
    for inst in kept:
        print(f"  keeping {inst.uuid[:8]}  age {human_age(inst.age_seconds):>7}  (newer than {min_age_hours}h)")

    targets = {p for i in kill_i for p in i.all_pids} | {pid for pid, _ in kill_o}
    if dry_run:
        print(f"[dry-run] would reap {len(targets)} processes")
        return len(targets)

    # `agent-browser close --all` is all-or-nothing, so it is only safe when no
    # instance is being spared by --min-age.
    if not kept:
        result = run(["agent-browser", "close", "--all"], timeout=90)
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                if line.strip():
                    print(f"  {line.strip()}")
        elif result.returncode == 127 or "not found" in result.stderr:
            print("  agent-browser CLI unavailable, falling back to signals")
        else:
            print(f"  {DANGER_MARKER} close --all failed: {result.stderr.strip()[:200]}")
    else:
        print(f"  skipping `close --all` (would also close the {len(kept)} kept session(s)); signalling instead")

    survivors = {pid for pid in targets if alive(pid)}
    if survivors:
        termed, forced = kill_pids(survivors)
        print(f"  reaped {termed} leftover process(es)" + (f", {forced} needed SIGKILL" if forced else ""))

    remaining = count_procs(AGENT_BROWSER_UDD_RE, ps_snapshot())
    print(f"✅ done, {remaining} agent-browser chrome process(es) left")
    return len(targets)


# ── simulator cleanup ───────────────────────────────────────
def cleanup_simulators(dry_run: bool) -> int:
    """Shut down booted simulators and quit Simulator.app. Returns processes reaped."""
    print("── iOS simulators ─────────────────────────────────")
    listing = run(["xcrun", "simctl", "list", "devices", "-j"], timeout=60)
    if listing.returncode != 0:
        print(f"{DANGER_MARKER} simctl unavailable: {listing.stderr.strip()[:200]}")
        return 0

    devices = parse_booted_devices(listing.stdout)
    before = ps_snapshot()
    runtime_procs = count_procs(SIM_RUNTIME_RE, before)
    app_pids = {pid for pid, _, _, _, cmd in parse_ps(before) if SIMULATOR_APP_RE.search(cmd)}

    if not devices and not runtime_procs and not app_pids:
        print("nothing to clean")
        return 0

    for device in devices:
        print(f"  booted  {device['name']} ({device['udid'][:8]}, {device['runtime']})")
    print(f"  {runtime_procs} iOS runtime process(es), Simulator.app {'running' if app_pids else 'not running'}")

    if dry_run:
        todo = f"would shut down {len(devices)} device(s), reap {runtime_procs} runtime process(es)"
        if app_pids:
            todo += ", quit Simulator.app"
        print(f"[dry-run] {todo}")
        return runtime_procs + len(app_pids)

    result = run(["xcrun", "simctl", "shutdown", "all"], timeout=180)
    if result.returncode != 0:
        print(f"  {DANGER_MARKER} shutdown all: {result.stderr.strip()[:200]}")

    if app_pids:
        run(["osascript", "-e", 'quit app "Simulator"'], timeout=30)
        deadline = time.monotonic() + 6
        while time.monotonic() < deadline and any(alive(pid) for pid in app_pids):
            time.sleep(0.5)
        # Simulator.app routinely ignores the AppleScript quit; fall back to signals.
        stubborn = {pid for pid in app_pids if alive(pid)}
        if stubborn:
            kill_pids(stubborn)
            print(f"  Simulator.app ignored quit, signalled pid(s) {sorted(stubborn)}")

    after = ps_snapshot()
    left = count_procs(SIM_RUNTIME_RE, after)
    app_left = count_procs(SIMULATOR_APP_RE, after)
    print(
        f"✅ done, {runtime_procs - left} runtime process(es) gone, {left} left"
        + (f", {DANGER_MARKER} Simulator.app still up" if app_left else "")
    )
    return (runtime_procs - left) + (len(app_pids) - app_left)


# ── games cleanup ───────────────────────────────────────────
def cleanup_games(dry_run: bool) -> int:
    """Quit games and their launchers, then signal whatever outlived the quit. Returns processes found."""
    print("── games ──────────────────────────────────────────")
    found = parse_game_procs(run(GAMES_PS_ARGS, timeout=20).stdout)
    if not found:
        print("nothing to clean")
        return 0

    for name, pids in found.items():
        print(f"  {name:<16} {len(pids):>2} process(es)")
    targets = set().union(*found.values())
    if dry_run:
        print(f"[dry-run] would close {', '.join(found)} ({len(targets)} processes)")
        return len(targets)

    for game in GAMES:
        if game.bundle_id and game.name in found:
            run(["osascript", *[arg for line in quit_script(game.bundle_id) for arg in ("-e", line)]], timeout=30)
    deadline = time.monotonic() + GAME_QUIT_GRACE
    while time.monotonic() < deadline and any(alive(pid) for pid in targets):
        time.sleep(0.5)

    stubborn = {pid for pid in targets if alive(pid)}
    if stubborn:
        _, forced = kill_pids(stubborn)
        print(f"  {len(stubborn)} process(es) outlived the quit, signalled" + (f", {forced} needed SIGKILL" if forced else ""))

    left = parse_game_procs(run(GAMES_PS_ARGS, timeout=20).stdout)
    print(
        f"✅ done, closed {', '.join(found)}"
        + (f", {DANGER_MARKER} still running: {', '.join(left)}" if left else "")
    )
    return len(targets)


# ── Shared: trash, real sizes, the ~/Code index ─────────────
# Every disk step moves what it deletes into a trash dir on the same volume first (rename is
# atomic, so a tool sees an entry whole or not at all), then deletes the trash.
TRASH_PREFIX = ".mac-dev-cleanup-trash-"
# A tool of the cleaned kind that started this recently may be installing right now.
BUSY_SECONDS = 600

# du counts every APFS clone in full, but deleting one clone frees nothing while another
# lives, and pnpm and uv install by clonefile: their caches look several times bigger than
# what deleting them gives back. getattrlist's extended common attributes tell how many
# files share a file's data (CLONE_REFCNT, 1 when nobody else does), which data stream
# (CLONEID) and the bytes only this file holds (PRIVATESIZE). Verified with `cp -c` on
# 2026-11-13. 0x200 is EXT_FLAGS, not the refcount (0x41 for any clone).
_ATTR_CMNEXT_PRIVATESIZE = 0x8
_ATTR_CMNEXT_CLONEID = 0x100
_ATTR_CMNEXT_CLONE_REFCNT = 0x1000
_FSOPT_NOFOLLOW = 0x1
_FSOPT_ATTR_CMN_EXTENDED = 0x20


class _AttrList(ctypes.Structure):
    _fields_ = [
        ("bitmapcount", ctypes.c_ushort),
        ("reserved", ctypes.c_ushort),
        ("commonattr", ctypes.c_uint32),
        ("volattr", ctypes.c_uint32),
        ("dirattr", ctypes.c_uint32),
        ("fileattr", ctypes.c_uint32),
        ("forkattr", ctypes.c_uint32),  # holds the extended common attrs under FSOPT_ATTR_CMN_EXTENDED
    ]


_LIBC = ctypes.CDLL(None, use_errno=True)


def clone_attrs(path: str) -> tuple[int, int, int] | None:
    """(private bytes, clone id, clone refcount) of a regular file; None when the volume can't tell."""
    wanted = _ATTR_CMNEXT_PRIVATESIZE | _ATTR_CMNEXT_CLONEID | _ATTR_CMNEXT_CLONE_REFCNT
    attrs = _AttrList(5, 0, 0, 0, 0, 0, wanted)
    buf = ctypes.create_string_buffer(64)
    if _LIBC.getattrlist(os.fsencode(path), ctypes.byref(attrs), buf, 64, _FSOPT_NOFOLLOW | _FSOPT_ATTR_CMN_EXTENDED):
        return None
    # Returned in bit order after the u32 length: off_t private, u64 clone id, u32 refcount.
    _length, private, clone_id, refcnt = struct.unpack_from("<IqQI", buf.raw)
    return private, clone_id, refcnt


def iter_tree(path: Path) -> Iterator[str]:
    """path and everything under it, never following symlinks."""
    if path.is_symlink() or not path.is_dir():
        yield str(path)
        return
    for dirpath, dirs, files in os.walk(path):
        yield dirpath
        for name in files:
            yield os.path.join(dirpath, name)
        for name in dirs:
            if os.path.islink(os.path.join(dirpath, name)):
                yield os.path.join(dirpath, name)


def measure_real(paths: Iterable[Path | str]) -> tuple[int, int]:
    """(du bytes, bytes deleting every path together would really free).

    A hard-linked inode counts only when all its links are in the set; a clone group counts
    once, and only when all its members are in it (otherwise just the members' private bytes).
    """
    inodes: dict[int, list] = {}  # ino → [nlink, links seen, blocks, private, clone id, refcnt]
    du = 0
    for root in paths:
        for name in iter_tree(Path(root)):
            try:
                st = os.lstat(name)
            except FileNotFoundError:
                continue
            record = inodes.get(st.st_ino)
            if record:
                record[1] += 1
                continue
            blocks = st.st_blocks * 512
            du += blocks
            regular = stat.S_ISREG(st.st_mode)
            private, clone_id, refcnt = (clone_attrs(name) if regular else None) or (blocks, 0, 1)
            inodes[st.st_ino] = [st.st_nlink if regular else 1, 1, blocks, private, clone_id, refcnt]

    real = 0
    groups: dict[int, list] = {}  # clone id → [refcnt, members seen, largest member, private sum]
    for nlink, seen, blocks, private, clone_id, refcnt in inodes.values():
        if seen < nlink:
            continue  # a hard link outside the set keeps the data
        if refcnt <= 1:
            real += private
            continue
        group = groups.setdefault(clone_id, [refcnt, 0, 0, 0])
        group[1] += 1
        group[2] = max(group[2], blocks)
        group[3] += private
    for refcnt, members, largest, private in groups.values():
        real += largest + private if members >= refcnt else private
    return du, real


def report_sizes(label: str, count: int, paths: list[Path]) -> tuple[int, int]:
    du, real = measure_real(paths)
    print(f"  {label:<34} {count:>6}  du {human_bytes(du):>9}  real {human_bytes(real):>9}")
    return du, real


def make_trash(parent: Path) -> Path:
    return Path(tempfile.mkdtemp(prefix=TRASH_PREFIX, dir=parent))


def rmtree_force(path: Path) -> None:
    """rmtree that first makes read-only dirs writable (the go module cache is all 0555)."""
    for dirpath, _dirs, _files in os.walk(path):
        os.chmod(dirpath, 0o755)
    shutil.rmtree(path)


def busy_pids(pattern: re.Pattern, ps_rows: list[tuple], min_age: int = BUSY_SECONDS) -> list[int]:
    """Processes matching pattern that started less than min_age seconds ago."""
    return sorted(pid for pid, _ppid, age, _cpu, cmd in ps_rows if age < min_age and pattern.search(cmd))


# One walk of ~/Code feeds every reference-based section: go.sum, uv locks and venvs, pnpm
# node_modules, PEP 723 scripts. tmp/ copies don't count (they are never active, and project
# rules clean them), nor do vendored or built trees, nor any GOPATH's module cache.
CODE_ROOT = Path.home() / "Code"
CODE_SKIP_DIRS = {
    ".git", "tmp", ".venv", "venv", "target", "__pycache__", "vendor", "site-packages", ".build",
    "DerivedData", ".next", "dist", "build", ".tox", "Pods", "node_modules",
}
# A project committed to, or whose lock/manifest changed, within this window keeps its references.
ACTIVE_DAYS = 30


@dataclass
class CodeIndex:
    go_mods: list[Path] = field(default_factory=list)  # dirs holding a go.mod
    locks: list[Path] = field(default_factory=list)  # uv.lock and pylock*.toml files
    venvs: list[Path] = field(default_factory=list)  # project .venv dirs
    node_modules: list[Path] = field(default_factory=list)  # node_modules dirs pnpm made (with .pnpm/)
    scripts: set[str] = field(default_factory=set)  # file names of PEP 723 scripts


def is_pep723_script(path: str, name: str) -> bool:
    if not name.endswith(".py") and ("." in name or not os.access(path, os.X_OK)):
        return False
    try:
        with open(path, "rb") as f:
            return b"# /// script" in f.read(4096)
    except OSError:
        return False


def build_code_index(root: Path) -> CodeIndex:
    index = CodeIndex()
    abandoned_gopath = root / "go"
    for dirpath, dirs, files in os.walk(root):
        here = Path(dirpath)
        if "node_modules" in dirs and (here / "node_modules/.pnpm").is_dir():
            index.node_modules.append(here / "node_modules")
        if ".venv" in dirs:
            index.venvs.append(here / ".venv")
        dirs[:] = sorted(
            d for d in dirs
            if d not in CODE_SKIP_DIRS and here / d != abandoned_gopath and not (d == "mod" and here.name == "pkg")
        )
        for name in sorted(files):
            if name == "go.mod":
                index.go_mods.append(here)
            elif name == "uv.lock" or (name.startswith("pylock") and name.endswith(".toml")):
                index.locks.append(here / name)
            elif is_pep723_script(os.path.join(dirpath, name), name):
                index.scripts.add(name)
    return index


_CODE_INDEX: CodeIndex | None = None
_GIT_LAST_COMMIT: dict[str, float] = {}


def code_index() -> CodeIndex:
    """The ~/Code index, built on first use and shared by the sections of this run."""
    global _CODE_INDEX
    if _CODE_INDEX is None:
        _CODE_INDEX = build_code_index(CODE_ROOT)
    return _CODE_INDEX


def git_last_commit(directory: Path) -> float:
    key = str(directory)
    if key not in _GIT_LAST_COMMIT:
        out = run(["git", "-C", key, "log", "-1", "--format=%ct"], timeout=30).stdout.strip()
        _GIT_LAST_COMMIT[key] = float(out) if out.isdigit() else 0.0
    return _GIT_LAST_COMMIT[key]


def is_active(directory: Path, now: float, *names: str) -> bool:
    """Committed to, or one of the named files changed, within ACTIVE_DAYS."""
    newest = git_last_commit(directory)
    for name in names:
        with contextlib.suppress(FileNotFoundError):
            newest = max(newest, (directory / name).stat().st_mtime)
    return now - newest < ACTIVE_DAYS * 86400


# ── cargo target cleanup ────────────────────────────────────
# What cargo-sweep reports per target dir, e.g. `[INFO] Cleaned 4.51 GiB from "…"`.
SWEEP_RESULT_RE = re.compile(r"(?:Cleaned|Would clean:) (nothing|[\d.]+ (?:B|KiB|MiB|GiB|TiB)) from")
BYTE_UNITS = {"B": 1, "KiB": 1024, "MiB": 1024**2, "GiB": 1024**3, "TiB": 1024**4}

# cargo-sweep only accepts a project path and finds the target dir via `cargo metadata`.
# An empty project with no local override resolves to the global build.target-dir, so
# the sweep never depends on any real project still existing.
STUB_MANIFEST = '[package]\nname = "mac-dev-cleanup-stub"\nversion = "0.0.0"\nedition = "2021"\n'


def parse_sweep_bytes(output: str) -> int | None:
    """Bytes cargo-sweep says it cleaned (or would clean). None when it printed no result."""
    sizes = SWEEP_RESULT_RE.findall(output)
    if not sizes:
        return None
    total = 0
    for size in sizes:
        if size != "nothing":
            number, unit = size.split()
            total += int(float(number) * BYTE_UNITS[unit])
    return total


def pick_shared_target(metadata_json: str, stub: Path) -> Path | None:
    """The target dir `cargo metadata` reports for the stub, or None if it is the stub's own."""
    target = Path(json.loads(metadata_json)["target_directory"])
    # Resolve both sides: macOS temp dirs live under /var, which cargo may report as /private/var.
    if target.resolve().is_relative_to(stub.resolve()):
        return None
    return target


def human_bytes(size: float) -> str:
    if size < 1024:
        return f"{size:.0f} B"
    for unit in ("KiB", "MiB", "GiB"):
        size /= 1024
        if size < 1024:
            return f"{size:.1f} {unit}"
    return f"{size / 1024:.1f} TiB"


# cargo-sweep ranks a .fingerprint/<unit>/ dir by the newest atime of the files in it, and
# every build reads them, fresh or not (cargo 1.98 reads the hash, dep-info, json and
# invoked.timestamp files). But this Mac updates atime on a read only while atime < mtime
# (measured 2026-11-13: no 24h rule, ctime irrelevant), so after a rebuild only the first
# build registers and a dependency used daily looks unused from then on. Hence "re-arming":
# after each sweep, record every unit's real last use in a sidecar and set its atimes one
# second before mtime, so the next read records itself; before the next sweep, show
# cargo-sweep the real last use. The json files never count as use: `cargo sweep
# --installed` and other tools read them all.
CARGO_SIDECAR = Path.home() / ".local/state/mac-dev-cleanup/cargo-lastuse.json"
REARM_GAP_NS = 10**9


def fingerprint_units(target: Path) -> list[Path]:
    """Every .fingerprint/<unit>/ dir, for host builds (<profile>/) and --target builds (<triple>/<profile>/)."""
    return sorted(p for pattern in ("*/.fingerprint/*", "*/*/.fingerprint/*") for p in target.glob(pattern) if p.is_dir())


def plan_cargo_lastuse(target: Path, sidecar: dict[str, float]) -> dict[str, float]:
    """Unit (relative to target) → real last use: the recorded one, or a read since re-arming, whichever is newer."""
    lastuse = {}
    for unit in fingerprint_units(target):
        rel = str(unit.relative_to(target))
        seen = [sidecar.get(rel, 0.0)]
        mtimes = []
        for f in unit.iterdir():
            if f.name.endswith(".json") or not f.is_file():
                continue
            st = f.stat()
            mtimes.append(st.st_mtime)
            if st.st_atime_ns >= st.st_mtime_ns:  # not armed: read since re-arming, or written since
                seen.append(st.st_atime)
        last = max(seen)
        lastuse[rel] = last if last > 0 else max(mtimes, default=unit.stat().st_mtime)
    return lastuse


def apply_lastuse(target: Path, lastuse: dict[str, float]) -> list[tuple[str, int, int]]:
    """Set every file's atime to its unit's real last use. Returns the original (path, atime, mtime)s."""
    originals = []
    for rel, last in lastuse.items():
        unit = target / rel
        if not unit.is_dir():
            continue
        for f in unit.iterdir():
            if f.is_file():
                st = f.stat()
                originals.append((str(f), st.st_atime_ns, st.st_mtime_ns))
                os.utime(f, ns=(int(last * 1e9), st.st_mtime_ns))
    return originals


def restore_atimes(originals: list[tuple[str, int, int]]) -> None:
    for path, atime_ns, mtime_ns in originals:
        with contextlib.suppress(FileNotFoundError):
            os.utime(path, ns=(atime_ns, mtime_ns))


def rearm_target(target: Path, lastuse: dict[str, float]) -> dict[str, float]:
    """Arm every surviving unit (atime one second before mtime). Returns the sidecar to save."""
    sidecar = {}
    for rel, last in lastuse.items():
        unit = target / rel
        if not unit.is_dir():
            continue  # swept
        sidecar[rel] = last
        for f in unit.iterdir():
            if f.is_file():
                st = f.stat()
                os.utime(f, ns=(st.st_mtime_ns - REARM_GAP_NS, st.st_mtime_ns))
    return sidecar


def load_cargo_sidecar(target: Path) -> dict[str, float]:
    try:
        data = json.loads(CARGO_SIDECAR.read_text())
    except (FileNotFoundError, ValueError):
        return {}
    return data.get("units", {}) if data.get("target") == str(target) else {}


def save_cargo_sidecar(target: Path, units: dict[str, float]) -> None:
    CARGO_SIDECAR.parent.mkdir(parents=True, exist_ok=True)
    tmp = CARGO_SIDECAR.with_suffix(".tmp")
    tmp.write_text(json.dumps({"target": str(target), "units": units}))
    os.replace(tmp, CARGO_SIDECAR)


def lock_target(target: Path) -> list[int] | None:
    """Take every cargo build lock in the target without blocking. None if cargo holds one.

    Holding them for the sweep makes a build that starts meanwhile wait, instead of
    reading artifacts as they are deleted. Cargo takes these with flock(2), as does
    fcntl.flock. The profile dirs (debug/, release/) hold the host locks, which cargo
    takes even for --target builds.
    """
    fds = []
    for path in sorted(target.glob("*/.cargo*lock")):
        fd = os.open(path, os.O_RDONLY)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            for taken in fds:
                os.close(taken)
            return None
        fds.append(fd)
    return fds


def dir_size(path: Path) -> int:
    """Disk usage in bytes. `du` counts hardlinks once, and incremental objects are hardlinked."""
    return int(run(["du", "-sk", str(path)], timeout=300).stdout.split()[0]) * 1024


def sweep_target(cargo: str, stub: Path, target: Path, keep_days: int, max_size: str, dry_run: bool) -> int:
    """Run the time sweep, then the size cap. Returns bytes cleaned (or that would be)."""
    before = dir_size(target)
    print(f"  {target}  {human_bytes(before)}")

    lastuse = plan_cargo_lastuse(target, load_cargo_sidecar(target))
    cutoff = time.time() - keep_days * 86400
    print(f"  {len(lastuse)} fingerprint units, {sum(v < cutoff for v in lastuse.values())} unused > {keep_days}d by real last use")
    # A dry run shows cargo-sweep the real last use too, then puts the atimes back.
    originals = apply_lastuse(target, lastuse)
    total = 0
    passes = [(f"unused > {keep_days}d", ["--time", str(keep_days)]), (f"cap {max_size}", ["--maxsize", max_size])]
    try:
        for label, criterion in passes:
            cmd = [cargo, "sweep", *criterion, *(["--dry-run"] if dry_run else []), str(stub)]
            result = run(cmd, timeout=600)
            cleaned = parse_sweep_bytes(result.stdout + result.stderr)
            if cleaned is None:
                tail = (result.stderr or result.stdout).strip().splitlines()[-1:] or ["no output"]
                print(f"  {DANGER_MARKER} {label}: cargo sweep failed: {tail[0][:200]}")
                continue
            total += cleaned
            print(f"  {label:<16} {'would clean' if dry_run else 'cleaned'} {human_bytes(cleaned)}")
    finally:
        if dry_run:
            restore_atimes(originals)

    if not dry_run:
        # Interrupted before this point, the files keep atime = real last use: nothing is lost.
        save_cargo_sidecar(target, rearm_target(target, lastuse))
        print(f"✅ done, {human_bytes(before)} → {human_bytes(dir_size(target))}, re-armed {len(lastuse)} units")
    return total


def cleanup_cargo(keep_days: int, max_size: str, dry_run: bool) -> int:
    """Sweep the shared cargo target dir. Returns bytes cleaned (or that would be)."""
    print("── cargo target ───────────────────────────────────")
    cargo = shutil.which("cargo")
    if not cargo:
        print("cargo not found, skipped")
        return 0
    if not shutil.which("cargo-sweep"):
        print(f"{DANGER_MARKER} cargo-sweep not installed (`cargo install cargo-sweep`), skipped")
        return 0

    with tempfile.TemporaryDirectory(prefix="mac-dev-cleanup-") as tmp:
        stub = Path(tmp)
        (stub / "Cargo.toml").write_text(STUB_MANIFEST)
        (stub / "src").mkdir()
        (stub / "src/lib.rs").touch()

        meta = run([cargo, "metadata", "--no-deps", "--format-version", "1", "--manifest-path", str(stub / "Cargo.toml")])
        if meta.returncode != 0:
            print(f"{DANGER_MARKER} cargo metadata failed: {meta.stderr.strip()[:200]}")
            return 0
        target = pick_shared_target(meta.stdout, stub)
        if target is None:
            print("no shared build.target-dir configured, nothing to sweep")
            return 0
        if not target.is_dir():
            print(f"{target} does not exist yet, nothing to sweep")
            return 0

        fds = lock_target(target)
        if fds is None:
            print(f"a cargo build is using {target}, skipped this run")
            return 0
        try:
            return sweep_target(cargo, stub, target, keep_days, max_size, dry_run)
        finally:
            for fd in fds:
                os.close(fd)


# ── uv cache cleanup ────────────────────────────────────────
# `uv cache prune` cannot run here unattended. Resident `uv run` jobs (proc-top, …) hold a
# shared lock on the cache for as long as they live, so prune waits forever; and with
# --force it deletes every cached environment, including the ones those jobs run from.
# This section does the same garbage collection by hand, leaving in-use entries alone.
#
# The cache layout of uv 0.9.17 (CacheBucket::to_str in crates/uv-cache/src/lib.rs).
# uv bumps a bucket's version whenever its format changes, so a uv binary that does not
# contain every one of these names lays the cache out differently, and is left alone.
UV_BUCKETS = (
    "sdists-v9",
    "flat-index-v2",
    "git-v0",
    "interpreter-v4",
    "simple-v18",
    "wheels-v5",
    "archive-v0",
    "builds-v0",
    "environments-v2",
    "python-v0",
    "binaries-v0",
)
UV_MARKERS = {"CACHEDIR.TAG", ".gitignore", ".git", ".lock"}
UV_TRASH_PREFIX = TRASH_PREFIX
# An install persists an archive first and links it after; anything younger may be mid-install.
UV_GRACE_SECONDS = 86400
# A uv holding the cache lock for less than this may be installing right now.
UV_BUSY_SECONDS = 600
UV_KIND_LABELS = {
    "stale": "old buckets, temp dirs",
    "orphan": "unreferenced archives",
    "wheel": "downloaded wheels",
    "env": "environments",
    "index": "index metadata",
}
# A `uv run --script` env whose script still exists under ~/Code is kept this long: uv keeps no
# last-use time, so even a script run daily gets its env rebuilt (a clone, seconds) this often.
UV_SCRIPT_ENV_DAYS = 30
UV_INDEX_BUCKET = "simple-v18"


@dataclass
class UvRemoval:
    """A cache entry to delete, with the symlinks that point at it (removed alongside)."""

    kind: str  # one of UV_KIND_LABELS
    path: Path
    links: list[Path] = field(default_factory=list)


def uv_layout_matches(binary: Path) -> bool:
    """Whether this uv binary was built with every bucket name in UV_BUCKETS."""
    data = binary.read_bytes()
    return all(name.encode() in data for name in UV_BUCKETS)


def young_uv_holders(holders: set[int], ps_rows: list[tuple], self_pid: int, min_age: int) -> list[int]:
    """Lock holders started less than min_age seconds ago, other than this script's own launcher."""
    parents = {pid: ppid for pid, ppid, *_ in ps_rows}
    ages = {pid: age for pid, _, age, *_ in ps_rows}
    ancestors, pid = set(), self_pid
    while pid in parents and pid not in ancestors:
        ancestors.add(pid)
        pid = parents[pid]
    return sorted(p for p in holders - ancestors if p in ages and ages[p] < min_age)


def uv_archive_links(cache: Path) -> dict[str, dict[str, list[Path]]]:
    """Archive id → {"wheels" | "sdists" | "envs": [symlinks pointing at that archive]}."""
    archive_root = os.path.realpath(cache / "archive-v0")
    found: dict[str, dict[str, list[Path]]] = {}

    def add(source: str, path: Path) -> None:
        target = os.path.realpath(path)
        if os.path.dirname(target) == archive_root:
            found.setdefault(os.path.basename(target), {}).setdefault(source, []).append(path)

    for source, bucket in (("wheels", "wheels-v5"), ("sdists", "sdists-v9")):
        for dirpath, dirs, files in os.walk(cache / bucket):
            dirs[:] = [d for d in dirs if d != "src"]  # unpacked source trees, as uv skips them too
            for name in dirs + files:
                if os.path.islink(os.path.join(dirpath, name)):
                    add(source, Path(dirpath, name))
    # Cached environments (`uv run --with`, uvx) are environments-v2/<interpreter>/<hash> links;
    # the other entries there are `uv run --script` environments, real venvs not worth walking.
    for top in sorted((cache / "environments-v2").glob("*")):
        if top.is_symlink():
            add("envs", top)
        elif top.is_dir() and not (top / "pyvenv.cfg").exists():
            for child in sorted(top.iterdir()):
                if child.is_symlink():
                    add("envs", child)
    return found


def uv_pointer_bytes(cache: Path) -> bytes:
    """All .http/.rev pointer files, concatenated. They name archives by id inside msgpack."""
    chunks = []
    for bucket in ("wheels-v5", "sdists-v9"):
        for dirpath, dirs, files in os.walk(cache / bucket):
            dirs[:] = [d for d in dirs if d != "src"]
            chunks += [Path(dirpath, f).read_bytes() for f in files if f.endswith((".http", ".rev"))]
    return b"\n".join(chunks)


def plan_uv_cleanup(
    cache: Path,
    keep_days: int,
    ps_output: str,
    now: float,
    pins: set[tuple[str, str]] | None = None,
    scripts: set[str] | None = None,
) -> tuple[list[UvRemoval], list[str]]:
    """What to delete from the cache. Returns (removals, entries kept only because a process uses them).

    uv records no last-use time and this Mac only updates atime on the first read after a
    write, so age is creation time. What still has a user is kept regardless of age: wheels
    an active project's lock or .venv pins (`pins`), and for UV_SCRIPT_ENV_DAYS the env of a
    script that still exists (`scripts`, file names). The rest is downloaded once more or
    rebuilt from the archives. Wheels built from source stay, since rebuilding them takes
    minutes and a toolchain.
    """
    grace_cutoff = now - UV_GRACE_SECONDS
    age_cutoff = now - keep_days * 86400
    removals: list[UvRemoval] = []
    in_use: list[str] = []

    def born(path: Path) -> float:
        return path.lstat().st_birthtime

    def consider(kind: str, path: Path, cutoff: float, links: list[Path] | None = None) -> None:
        if born(path) >= cutoff:
            return
        links = links or []
        if any(f"{p}/" in ps_output for p in (path, *links)):
            in_use.append(str((links[0] if links else path).relative_to(cache)))
            return
        removals.append(UvRemoval(kind, path, links))

    for entry in sorted(cache.iterdir()):
        if entry.name not in UV_BUCKETS and entry.name not in UV_MARKERS:
            consider("stale", entry, grace_cutoff)

    links_by_id = uv_archive_links(cache)
    pointers = uv_pointer_bytes(cache)
    for archive in sorted((cache / "archive-v0").iterdir()):
        sources = links_by_id.get(archive.name, {})
        links = [lk for group in sources.values() for lk in group]
        if not sources:
            if archive.name.encode() not in pointers:
                consider("orphan", archive, grace_cutoff)
        elif set(sources) == {"wheels"}:
            if pins is not None and any(uv_wheel_key(cache, lk) in pins for lk in links):
                continue
            consider("wheel", archive, age_cutoff, links)
        elif set(sources) == {"envs"}:
            consider("env", archive, age_cutoff, links)

    script_cutoff = now - UV_SCRIPT_ENV_DAYS * 86400
    for cfg in sorted((cache / "environments-v2").glob("*/pyvenv.cfg")):
        kept_script = scripts is not None and uv_env_prompt(cfg) in scripts
        consider("env", cfg.parent, script_cutoff if kept_script else age_cutoff)

    # The index's HTTP cache: a missing entry is fetched again on the next resolve.
    for dirpath, _dirs, files in os.walk(cache / UV_INDEX_BUCKET):
        for name in files:
            path = Path(dirpath, name)
            if path.lstat().st_mtime < age_cutoff:
                removals.append(UvRemoval("index", path))
    return removals, in_use


def uv_wheel_key(cache: Path, link: Path) -> tuple[str, str] | None:
    """wheels-v5/<index>/<name>/<version>-<tags> → (normalized name, version)."""
    parts = link.relative_to(cache / "wheels-v5").parts
    return (norm_dist(parts[-2]), wheel_version(parts[-1])) if len(parts) >= 2 else None


def uv_env_prompt(cfg: Path) -> str:
    """The script file name a `uv run --script` env was made for (pyvenv.cfg's prompt)."""
    match = re.search(r"^prompt = (.+)$", cfg.read_text(errors="replace"), re.M)
    return match.group(1).strip() if match else ""


def norm_dist(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def wheel_version(name: str) -> str:
    return name.split("-", 1)[0]


def lock_pins(text: str) -> set[tuple[str, str]]:
    """(normalized name, version) of every package in a uv.lock ([[package]]) or pylock.toml ([[packages]])."""
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return set()
    packages = [*data.get("package", []), *data.get("packages", [])]
    return {(norm_dist(p["name"]), str(p.get("version", ""))) for p in packages if isinstance(p, dict) and "name" in p}


def venv_pins(venv: Path) -> set[tuple[str, str]]:
    pins = set()
    for info in venv.glob("lib/python*/site-packages/*.dist-info"):
        match = re.match(r"^(.+?)-(\d[^-]*)\.dist-info$", info.name)
        if match:
            pins.add((norm_dist(match.group(1)), match.group(2)))
    return pins


def uv_refs(index: "CodeIndex", now: float) -> set[tuple[str, str]]:
    """What active projects pin: their lock files and installed .venvs."""
    pins: set[tuple[str, str]] = set()
    for lock in index.locks:
        if is_active(lock.parent, now, lock.name, "pyproject.toml", ".venv"):
            pins |= lock_pins(lock.read_text(errors="replace"))
    for venv in index.venvs:
        if is_active(venv.parent, now, "uv.lock", "pyproject.toml", ".venv"):
            pins |= venv_pins(venv)
    return pins


def apply_uv_plan(cache: Path, removals: list[UvRemoval]) -> None:
    """Rename each entry into a trash dir, so uv sees it whole or not at all, then delete the trash."""
    trash = Path(tempfile.mkdtemp(prefix=UV_TRASH_PREFIX, dir=cache))
    for i, item in enumerate(removals):
        for link in item.links:
            link.unlink(missing_ok=True)
        item.path.rename(trash / f"{i}-{item.path.name}")
    shutil.rmtree(trash)


def tree_bytes(paths: list[Path], seen: set[int]) -> int:
    """Allocated bytes under paths, each inode once (what du reports)."""
    total = 0
    for root in paths:
        for dirpath, _dirs, files in os.walk(root):
            for name in [dirpath, *(os.path.join(dirpath, f) for f in files)]:
                st = os.lstat(name)
                if st.st_ino not in seen:
                    seen.add(st.st_ino)
                    total += st.st_blocks * 512
    return total


def volume_free(path: Path) -> int:
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def cleanup_uv(keep_days: int, dry_run: bool) -> int:
    """Trim the uv cache. Returns bytes cleaned (or that would be), as du counts them."""
    print("── uv cache ───────────────────────────────────────")
    uv = shutil.which("uv")
    if not uv:
        print("uv not found, skipped")
        return 0
    if not uv_layout_matches(Path(uv).resolve()):
        version = run([uv, "--version"]).stdout.strip()
        print(f"{DANGER_MARKER} {version} lays out its cache differently, skipped (update UV_BUCKETS)")
        return 0
    cache = Path(run([uv, "cache", "dir"]).stdout.strip())
    if not (cache / "archive-v0").is_dir():
        print(f"no uv cache at {cache}, nothing to clean")
        return 0

    holders = {int(pid) for pid in run(["lsof", "-t", "--", str(cache / ".lock")]).stdout.split()}
    ps_rows = parse_ps(ps_snapshot())
    busy = young_uv_holders(holders, ps_rows, os.getpid(), UV_BUSY_SECONDS)
    if busy:
        print(f"uv started < {UV_BUSY_SECONDS // 60}m ago may be installing (pid {', '.join(map(str, busy))}), skipped this run")
        return 0

    now = time.time()
    index = code_index()
    pins = uv_refs(index, now)
    removals, in_use = plan_uv_cleanup(
        cache, keep_days, "\n".join(row[-1] for row in ps_rows), now, pins=pins, scripts=index.scripts
    )
    before = dir_size(cache)
    print(f"  {cache}  {human_bytes(before)}  (keeping {len(pins)} pins of active projects, {len(index.scripts)} scripts' envs)")
    for kind, label in UV_KIND_LABELS.items():
        items = [i for i in removals if i.kind == kind]
        if not items:
            continue
        du, real = measure_real([i.path for i in items])
        age = "" if kind in ("stale", "orphan") else f" > {keep_days}d"
        print(f"  {label + age:<26} {len(items):>5}  du {human_bytes(du):>9}  real {human_bytes(real):>9}")
    if in_use:
        print(f"  kept, in use: {', '.join(in_use)}")
    if not removals:
        print("nothing to clean")
        return 0
    total, real = measure_real([i.path for i in removals])
    if dry_run:
        print(f"[dry-run] would remove {len(removals)} entries, du {human_bytes(total)}, real {human_bytes(real)}")
        return total

    free_before = volume_free(cache)
    apply_uv_plan(cache, removals)
    # uv installs by APFS clone, so blocks shared with installed venvs stay allocated.
    print(
        f"✅ done, {human_bytes(before)} → {human_bytes(dir_size(cache))}, "
        f"volume free +{human_bytes(max(volume_free(cache) - free_before, 0))}"
    )
    return total


# ── go module cache cleanup ─────────────────────────────────
# `go clean -modcache` is all or nothing. Instead: drop module versions no active project's
# go.sum needs (lines without the /go.mod suffix need the source) and that were extracted
# more than a week ago. A dropped version loses its extracted tree and its .zip/.ziphash;
# the tiny .mod/.info files stay, since resolving the module graph needs them. Go guards a
# version's download and extraction with flock(<ver>.lock) but reads extracted sources
# without a lock, which is why referenced versions are never touched. The build cache
# (GOCACHE) trims itself: every go command prunes entries unused for 5 days, once a day.
GO_BUSY_RE = re.compile(r"(?:^|/)go (?:build|test|run|install|get|mod|list|vet|generate|work)\b")
TOOLCHAIN_LINE_RE = re.compile(r"^\s*(?:go\s+|toolchain\s+go)(\d+\.\d+(?:\.\d+)?(?:(?:rc|beta)\d+)?)\s*(?://.*)?$", re.M)
TOOLCHAIN_KEY_RE = re.compile(r"^golang\.org/toolchain@v\d+\.\d+\.\d+-go(\d+\.\d+(?:\.\d+)?(?:(?:rc|beta)\d+)?)\.")


@dataclass
class GoRemoval:
    key: str  # <module>@<version>, case-escaped like the cache paths
    path: Path | None  # the extracted tree, None for a download-only version
    files: list[Path]  # download cache files dropped with it (.zip, .ziphash)
    lock: Path  # cache/download/<module>/@v/<version>.lock


def go_escape(path: str) -> str:
    """The module cache's case escaping: upper case → '!' + lower case."""
    return re.sub(r"[A-Z]", lambda m: "!" + m.group().lower(), path)


def go_sum_refs(text: str) -> set[str]:
    refs = set()
    for line in text.splitlines():
        fields = line.split()
        if len(fields) == 3 and not fields[1].endswith("/go.mod"):
            refs.add(f"{go_escape(fields[0])}@{go_escape(fields[1])}")
    return refs


def toolchain_wants(go_mod: str) -> set[str]:
    return set(TOOLCHAIN_LINE_RE.findall(go_mod))


def version_tuple(version: str) -> tuple[int, ...]:
    return tuple(int(n) for n in re.findall(r"\d+", version))


def go_extracted(mod: Path) -> dict[str, Path]:
    """key → extracted dir. Nested modules are siblings named <path>@<version>, never descended into."""
    found = {}
    for dirpath, dirs, _files in os.walk(mod):
        here = Path(dirpath)
        if here == mod:
            dirs[:] = [d for d in dirs if d != "cache" and not d.startswith(TRASH_PREFIX)]
        keep = []
        for d in dirs:
            if "@" in d:
                found[str((here / d).relative_to(mod))] = here / d
            else:
                keep.append(d)
        dirs[:] = keep
    return found


def go_downloads(mod: Path) -> dict[str, Path]:
    """key → cache/download/<module>/@v/<version>.zip."""
    found = {}
    root = mod / "cache/download"
    for dirpath, dirs, files in os.walk(root):
        if os.path.basename(dirpath) == "@v":
            module = Path(dirpath).parent.relative_to(root)
            found.update({f"{module}@{f[:-4]}": Path(dirpath, f) for f in files if f.endswith(".zip")})
            dirs[:] = []
    return found


def plan_go_cleanup(mod: Path, refs: set[str], wants: set[str], keep_days: int, now: float) -> list[GoRemoval]:
    """Versions to drop: unreferenced, not a wanted or the newest toolchain, untouched for keep_days."""
    cutoff = now - keep_days * 86400
    extracted, downloads = go_extracted(mod), go_downloads(mod)
    toolchains = {k: m.group(1) for k in set(extracted) | set(downloads) if (m := TOOLCHAIN_KEY_RE.match(k))}
    newest = max(toolchains.values(), key=version_tuple, default=None)

    def wanted(key: str) -> bool:
        version = toolchains.get(key)
        if version is None:
            return key in refs
        return version == newest or any(version in (w, f"{w}.0") for w in wants)

    plan = []
    for key in sorted(set(extracted) | set(downloads)):
        if wanted(key):
            continue
        tree, archive = extracted.get(key), downloads.get(key)
        if tree is not None and tree.lstat().st_mtime >= cutoff:
            continue  # extracted this week
        old_zip = archive is not None and archive.lstat().st_mtime < cutoff
        if tree is None and not old_zip:
            continue
        files = [f for f in (archive, archive.with_suffix(".ziphash")) if f.exists()] if old_zip else []
        module, version = key.rsplit("@", 1)
        plan.append(GoRemoval(key, tree, files, mod / "cache/download" / module / "@v" / f"{version}.lock"))
    return plan


def try_flock(path: Path) -> int | None | bool:
    """An exclusive non-blocking flock on path: its fd, None if there is no such file, False if it is held."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except FileNotFoundError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return False
    return fd


def apply_go_plan(mod: Path, plan: list[GoRemoval]) -> tuple[int, int]:
    """Returns (versions removed, versions skipped because a go process holds their lock)."""
    trash = make_trash(mod)
    removed = skipped = 0
    try:
        for i, item in enumerate(plan):
            fd = try_flock(item.lock)
            if fd is False:
                skipped += 1
                continue
            try:
                if item.path is not None and item.path.exists():
                    os.chmod(item.path, 0o755)  # moving a dir to another parent needs write access to it
                    item.path.rename(trash / f"{i}-{item.path.name}")
                for f in item.files:
                    f.rename(trash / f"{i}-{f.name}")
                removed += 1
            finally:
                if fd is not None:
                    os.close(fd)
    finally:
        rmtree_force(trash)
    return removed, skipped


def cleanup_go(keep_days: int, dry_run: bool) -> int:
    """Trim the go module cache. Returns bytes cleaned (or that would be), by du."""
    print("── go module cache ────────────────────────────────")
    go = shutil.which("go")
    if not go:
        print("go not found, skipped")
        return 0
    env = json.loads(run([go, "env", "-json", "GOMODCACHE", "GOCACHE", "GOVERSION"]).stdout or "{}")
    mod = Path(env.get("GOMODCACHE", ""))
    if not env.get("GOMODCACHE") or not (mod / "cache/download").is_dir():
        print(f"no module cache at {mod}, nothing to clean")
        return 0
    busy = busy_pids(GO_BUSY_RE, parse_ps(ps_snapshot()))
    if busy:
        print(f"go started < {BUSY_SECONDS // 60}m ago may be downloading (pid {', '.join(map(str, busy))}), skipped this run")
        return 0
    trim = Path(env.get("GOCACHE", "")) / "trim.txt"
    if trim.exists() and time.time() - trim.stat().st_mtime > 3 * 86400:
        print(f"  {DANGER_MARKER} go build cache last trimmed {human_age(int(time.time() - trim.stat().st_mtime))} ago (go trims it daily)")

    now = time.time()
    active = [d for d in code_index().go_mods if is_active(d, now, "go.mod", "go.sum")]
    refs: set[str] = set()
    wants: set[str] = set()
    for d in active:
        with contextlib.suppress(FileNotFoundError):
            refs |= go_sum_refs((d / "go.sum").read_text(errors="replace"))
        wants |= toolchain_wants((d / "go.mod").read_text(errors="replace"))
    plan = plan_go_cleanup(mod, refs, wants, keep_days, now)
    print(f"  {mod}  {human_bytes(dir_size(mod))}  ({env.get('GOVERSION')}, {len(active)} active projects, {len(refs)} versions referenced)")
    if not plan:
        print("nothing to clean")
        return 0
    trees = [r.path for r in plan if r.path]
    report_sizes(f"extracted, unused > {keep_days}d", len(trees), trees)
    zips = [f for r in plan for f in r.files]
    report_sizes(f"downloaded zips, unused > {keep_days}d", sum(1 for f in zips if f.suffix == ".zip"), zips)
    total, real = measure_real(trees + zips)
    if dry_run:
        print(f"[dry-run] would remove {len(plan)} module versions, du {human_bytes(total)}, real {human_bytes(real)}")
        return total
    free_before = volume_free(mod)
    removed, skipped = apply_go_plan(mod, plan)
    note = f", {skipped} skipped (a go process holds their lock)" if skipped else ""
    print(f"✅ done, removed {removed} module versions{note}, volume free +{human_bytes(max(volume_free(mod) - free_before, 0))}")
    return total


# ── pnpm cleanup ────────────────────────────────────────────
# `pnpm store prune` can't run here: it deletes every store file with nlink == 1, and on APFS
# pnpm installs node_modules by clonefile, so every file in this store has nlink 1 and the
# whole store would go. It also wipes all metadata unconditionally and takes no lock. So:
# keep a package (its index json and the files it, and its side-effect builds, point at) when
# a node_modules that exists names it in .pnpm/, or it was stored this week; delete the rest.
# Index first, then files, so an interruption only leaves orphans for the next run.
# A command line run as `<path>/<tool> …` or `node <path>/<tool> …`, past its leading options.
_TOOL_CMD = r"^(?:\S*/)?(?:node\s+(?:--\S+\s+)*)?(?:\S*/)?"
# Only commands that write the store or the dlx cache make the run wait; `pnpm exec`, `pnpm
# run` and scripts (a dev server started minutes ago) only read it. Bare `pnpm` installs.
PNPM_BUSY_RE = re.compile(
    _TOOL_CMD + r"(?:pnpm(?:\.c?js)?(?:\s+(?:-C|--dir|-F|--filter)\s+\S+|\s+(?!(?:-C|--dir|-F|--filter)\s)-\S+)*"
    r"(?:\s+(?:install|i|add|update|up|upgrade|remove|rm|uninstall|un|dlx|fetch|import|rebuild|rb|store"
    r"|install-test|it|link|ln|dedupe|patch-commit|create)(?:\s|$)|\s*$)|pnpx(?:\.c?js)?(?:\s|$))"
)
PNPM_ENTRY_RE = re.compile(r"^((?:@[^+]+\+)?[^@]+)@([^_]+)")
PNPM_INDEX_RE = re.compile(r"^[0-9a-f]+-(.+)\.json$")


def pnpm_key(entry: str) -> str | None:
    """node_modules/.pnpm/<entry> → '<name>@<version>' in the store index's naming ('/' as '+')."""
    match = PNPM_ENTRY_RE.match(entry)
    return f"{match.group(1)}@{match.group(2)}" if match else None


def index_key(file_name: str) -> str | None:
    match = PNPM_INDEX_RE.match(file_name)
    return match.group(1) if match else None


def store_file_path(files_dir: Path, integrity: str, mode: int) -> Path:
    digest = base64.b64decode(integrity.split("-", 1)[1]).hex()
    return files_dir / digest[:2] / (digest[2:] + ("-exec" if mode & 0o111 else ""))


def index_files(body: dict) -> Iterator[dict]:
    yield from body.get("files", {}).values()
    for effect in (body.get("sideEffects") or {}).values():
        if isinstance(effect, dict):
            yield from (effect.get("added") or {}).values()


def pnpm_nm_keys(node_modules: Iterable[Path]) -> set[str]:
    keys = set()
    for nm in node_modules:
        with contextlib.suppress(OSError):
            keys.update(k for k in map(pnpm_key, os.listdir(nm / ".pnpm")) if k)
    return keys


def plan_pnpm_store(store: Path, nm_keys: set[str], keep_days: int, now: float) -> tuple[list[Path], list[Path]]:
    """(index jsons to drop, store files to drop). A kept index that can't be read aborts with ValueError."""
    cutoff = now - keep_days * 86400
    files_dir = store / "files"
    keep: set[str] = set()
    drop_index = []
    for sub in sorted(os.listdir(store / "index")):
        for name in sorted(os.listdir(store / "index" / sub)):
            path = store / "index" / sub / name
            key = index_key(name)
            if key is None:
                continue
            if key not in nm_keys and path.lstat().st_mtime < cutoff:
                drop_index.append(path)
                continue
            body = json.loads(path.read_bytes())  # unreadable → ValueError: don't guess what it keeps
            keep.update(str(store_file_path(files_dir, f["integrity"], f["mode"])) for f in index_files(body))
    drop_files = []
    for sub in sorted(os.listdir(files_dir)):
        for name in sorted(os.listdir(files_dir / sub)):
            path = files_dir / sub / name
            if str(path) not in keep and path.lstat().st_mtime < cutoff:  # young: an install may be in flight
                drop_files.append(path)
    return drop_index, drop_files


def plan_pnpm_dlx(dlx: Path, ps_output: str, keep_days: int, now: float) -> tuple[list[Path], list[Path]]:
    """(dirs to drop, node_modules of the runs kept). pnpm never deletes an old dlx run itself.

    <key>/pkg links to the current run and is recreated whenever pnpm reinstalls the command,
    so its own mtime is the last (re)install: past keep_days the whole command goes, otherwise
    only its superseded runs. A run a process's command line points into is always kept.
    """
    cutoff = now - keep_days * 86400
    drop, kept_nm = [], []
    for key in sorted(dlx.iterdir()):
        if not key.is_dir() or key.is_symlink() or key.name.startswith(TRASH_PREFIX):
            continue
        link = key / "pkg"
        current = os.path.realpath(link) if link.is_symlink() else None
        expired = current is None or link.lstat().st_mtime < cutoff
        runs = [r for r in sorted(key.iterdir()) if r.is_dir() and not r.is_symlink()]
        running = [r for r in runs if f"{r}/" in ps_output]
        if expired and not running:
            drop.append(key)
            continue
        for r in runs:
            if r in running or (not expired and os.path.realpath(r) == current):
                kept_nm.append(r / "node_modules")
            else:
                drop.append(r)
    return drop, kept_nm


def plan_pnpm_metadata(caches: Path, keep_days: int, now: float) -> list[Path]:
    """Registry metadata files older than keep_days (pnpm rewrites a file whenever it refetches it)."""
    cutoff = now - keep_days * 86400
    roots = [p for base in (caches, caches / "v11") if base.is_dir() for p in base.iterdir() if p.is_dir() and p.name.startswith("metadata")]
    drop = []
    for root in roots:
        for dirpath, _dirs, files in os.walk(root):
            drop.extend(Path(dirpath, f) for f in files if Path(dirpath, f).lstat().st_mtime < cutoff)
    return sorted(drop)


def cleanup_pnpm(keep_days: int, dry_run: bool) -> int:
    """Trim the pnpm store, dlx cache and metadata. Returns bytes cleaned (or that would be), by du."""
    print("── pnpm ───────────────────────────────────────────")
    pnpm = shutil.which("pnpm")
    if not pnpm:
        print("pnpm not found, skipped")
        return 0
    store = Path(run([pnpm, "store", "path"]).stdout.strip())
    if store.name != "v10" or not (store / "index").is_dir() or not (store / "files").is_dir():
        version = run([pnpm, "--version"]).stdout.strip()
        print(f"{DANGER_MARKER} pnpm {version} keeps its store as {store}, a layout this step doesn't know; skipped")
        return 0
    ps_rows = parse_ps(ps_snapshot())
    busy = busy_pids(PNPM_BUSY_RE, ps_rows)
    if busy:
        print(f"pnpm started < {BUSY_SECONDS // 60}m ago may be installing (pid {', '.join(map(str, busy))}), skipped this run")
        return 0

    now = time.time()
    caches = Path.home() / "Library/Caches/pnpm"
    dlx = caches / "dlx"
    ps_output = "\n".join(row[-1] for row in ps_rows)
    dlx_drop, dlx_nm = plan_pnpm_dlx(dlx, ps_output, keep_days, now) if dlx.is_dir() else ([], [])
    node_modules = [*code_index().node_modules, *sorted(Path.home().glob("Library/pnpm/global/*/node_modules")), *dlx_nm]
    try:
        index_drop, file_drop = plan_pnpm_store(store, pnpm_nm_keys(node_modules), keep_days, now)
    except ValueError as e:
        print(f"  {DANGER_MARKER} a kept store index is unreadable ({e}); store skipped")
        index_drop, file_drop = [], []
    meta_drop = plan_pnpm_metadata(caches, keep_days, now)

    print(f"  {store}  ({len(node_modules)} node_modules keep their packages)")
    if not (dlx_drop or index_drop or file_drop or meta_drop):
        print("nothing to clean")
        return 0
    report_sizes(f"dlx runs, unused > {keep_days}d / superseded", len(dlx_drop), dlx_drop)
    report_sizes(f"store packages, unreferenced > {keep_days}d", len(index_drop), index_drop + file_drop)
    report_sizes(f"metadata, older than {keep_days}d", len(meta_drop), meta_drop)
    total, real = measure_real(dlx_drop + index_drop + file_drop + meta_drop)
    if dry_run:
        print(f"[dry-run] would remove du {human_bytes(total)}, real {human_bytes(real)} ({len(file_drop)} store files)")
        return total

    free_before = volume_free(store)
    if dlx_drop:
        trash = make_trash(dlx)
        try:
            for i, path in enumerate(dlx_drop):
                if path.exists():
                    path.rename(trash / f"{i}-{path.name}")
        finally:
            shutil.rmtree(trash)
    for path in index_drop + file_drop + meta_drop:
        path.unlink(missing_ok=True)
    print(f"✅ done, volume free +{human_bytes(max(volume_free(store) - free_before, 0))}")
    return total


# ── npm cleanup ─────────────────────────────────────────────
# _cacache is content-addressed: index-v5 buckets are append-only logs of
# "<sha1>\t{key, integrity, time, …}" lines (a key's last line wins, integrity null = deleted),
# content-v2 holds the data by hash. No last-access time exists, so a key expires keep_days
# after it was last written; content no live key points to goes. Writes are tmp + rename and
# appends, without locks, so the worst race is a cache miss. _npx/<hash>/ is one npx package;
# npm 11 creates and removes <dir>/concurrency.lock around every run, so the dir's mtime is
# its last use, and a lock present means it runs right now.
# Only installs make the run wait. npx / npm exec (every agent session starts its MCP servers
# that way) hold their _npx dir's concurrency.lock while installing, which plan_npx honours,
# and what they add to _cacache is younger than the one-day grace.
NPM_BUSY_RE = re.compile(
    _TOOL_CMD + r"npm(?:-cli\.js)?(?:\s+(?:--prefix|-C|-w|--workspace)\s+\S+|\s+(?!(?:--prefix|-C|-w|--workspace)\s)-\S+)*"
    r"\s+(?:install|i|in|add|ci|clean-install|ic|update|up|upgrade|cache|pack|publish"
    r"|install-test|it|install-ci-test|cit|dedupe|ddp|uninstall|remove|rm|r|un|link|ln|rebuild|rb)(?:\s|$)"
)
NPM_GRACE_SECONDS = 86400


@dataclass
class CacachePlan:
    content: list[Path] = field(default_factory=list)
    drop_buckets: list[Path] = field(default_factory=list)
    rewrite: dict[Path, list[str]] = field(default_factory=dict)
    tmp: list[Path] = field(default_factory=list)
    bucket_mtimes: dict[Path, int] = field(default_factory=dict)
    expired: int = 0
    live: int = 0


def cacache_content_path(cache: Path, integrity: str) -> Path:
    algo, b64 = integrity.split("-", 1)
    digest = base64.b64decode(b64).hex()
    return cache / "content-v2" / algo / digest[:2] / digest[2:4] / digest[4:]


def read_bucket(path: Path) -> list[tuple[str, dict]]:
    rows = []
    for line in path.read_text(errors="replace").splitlines():
        _, sep, body = line.partition("\t")
        if not sep:
            continue
        try:
            entry = json.loads(body)
        except ValueError:
            continue
        if isinstance(entry, dict) and "key" in entry:
            rows.append((line, entry))
    return rows


def plan_cacache(cache: Path, keep_days: int, now: float) -> CacachePlan:
    plan = CacachePlan()
    cutoff_ms = (now - keep_days * 86400) * 1000
    buckets: dict[Path, list[tuple[str, dict]]] = {}
    for dirpath, _dirs, files in os.walk(cache / "index-v5"):
        for name in files:
            path = Path(dirpath, name)
            plan.bucket_mtimes[path] = path.stat().st_mtime_ns
            buckets[path] = read_bucket(path)
    latest: dict[str, tuple[dict, Path, str]] = {}
    for path, rows in buckets.items():
        for line, entry in rows:
            latest[entry["key"]] = (entry, path, line)
    fresh = {k for k, (e, _, _) in latest.items() if e.get("integrity") and (e.get("time") or 0) >= cutoff_ms}
    plan.live = len(fresh)
    plan.expired = sum(1 for e, _, _ in latest.values() if e.get("integrity")) - len(fresh)

    keep = set()
    for key in fresh:
        for token in str(latest[key][0]["integrity"]).split():
            with contextlib.suppress(ValueError, IndexError):
                keep.add(str(cacache_content_path(cache, token)))
    grace = now - NPM_GRACE_SECONDS  # content written in the last day may still await its index line
    for dirpath, _dirs, files in os.walk(cache / "content-v2"):
        for name in files:
            path = Path(dirpath, name)
            if str(path) not in keep and path.lstat().st_mtime < grace:
                plan.content.append(path)
    plan.content.sort()

    for path, rows in buckets.items():
        keys = dict.fromkeys(entry["key"] for _, entry in rows)
        kept = [latest[k][2] for k in keys if k in fresh]
        if not kept:
            plan.drop_buckets.append(path)
        elif len(kept) < len(rows):
            plan.rewrite[path] = kept
    plan.drop_buckets.sort()
    tmp = cache / "tmp"
    if tmp.is_dir():
        plan.tmp = sorted(p for p in tmp.iterdir() if p.lstat().st_mtime < grace)
    return plan


def apply_cacache_plan(plan: CacachePlan) -> None:
    """Content first, then the index: a reader meanwhile sees a miss, never a dangling hit it trusts."""
    for path in plan.content:
        path.unlink(missing_ok=True)
    for path in plan.drop_buckets:
        if path.exists() and path.stat().st_mtime_ns == plan.bucket_mtimes.get(path):  # untouched since planned
            path.unlink()
    for path, lines in plan.rewrite.items():
        if not path.exists() or path.stat().st_mtime_ns != plan.bucket_mtimes.get(path):
            continue
        tmp = path.with_name(f"{path.name}.{TRASH_PREFIX}{os.getpid()}")
        tmp.write_text("".join(f"\n{line}" for line in lines))
        os.replace(tmp, path)
    for path in plan.tmp:
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path, ignore_errors=True)
        else:
            path.unlink(missing_ok=True)


def plan_npx(npx: Path, ps_output: str, keep_days: int, now: float) -> list[Path]:
    cutoff = now - keep_days * 86400
    drop = []
    for d in sorted(npx.iterdir()):
        if not d.is_dir() or d.is_symlink() or d.name.startswith(TRASH_PREFIX):
            continue
        if d.lstat().st_mtime >= cutoff or (d / "concurrency.lock").exists() or f"{d}/" in ps_output:
            continue
        drop.append(d)
    return drop


def apply_npx_plan(npx: Path, drop: list[Path]) -> int:
    """Take each dir's own concurrency lock (as npx does), then move it to the trash. Returns dirs removed."""
    trash = make_trash(npx)
    removed = 0
    try:
        for i, d in enumerate(drop):
            try:
                (d / "concurrency.lock").mkdir()
            except (FileExistsError, FileNotFoundError):
                continue  # an npx started meanwhile, or the dir is gone
            d.rename(trash / f"{i}-{d.name}")
            removed += 1
    finally:
        shutil.rmtree(trash)
    return removed


def cleanup_npm(keep_days: int, dry_run: bool) -> int:
    """Trim npm's _cacache and _npx. Returns bytes cleaned (or that would be), by du."""
    print("── npm ────────────────────────────────────────────")
    npm = shutil.which("npm")
    if not npm:
        print("npm not found, skipped")
        return 0
    root = Path(run([npm, "config", "get", "cache"]).stdout.strip())
    major = int((run([npm, "--version"]).stdout.strip().split(".") or ["0"])[0] or 0)
    ps_rows = parse_ps(ps_snapshot())
    busy = busy_pids(NPM_BUSY_RE, ps_rows)
    if busy:
        print(f"npm started < {BUSY_SECONDS // 60}m ago may be installing (pid {', '.join(map(str, busy))}), skipped this run")
        return 0

    now = time.time()
    cache = root / "_cacache"
    plan = CacachePlan()
    if (cache / "index-v5").is_dir() and (cache / "content-v2").is_dir():
        plan = plan_cacache(cache, keep_days, now)
    elif cache.exists():
        print(f"  {DANGER_MARKER} {cache} has a layout this step doesn't know; _cacache skipped")
    npx = root / "_npx"
    npx_drop: list[Path] = []
    if npx.is_dir() and major >= 11:
        npx_drop = plan_npx(npx, "\n".join(row[-1] for row in ps_rows), keep_days, now)
    elif npx.is_dir():
        print(f"  {DANGER_MARKER} npm {major} doesn't mark npx runs with concurrency.lock; _npx skipped")

    print(f"  {root}  (_cacache: {plan.live} keys used in {keep_days}d, {plan.expired} expired)")
    cacache_files = plan.content + plan.drop_buckets + plan.tmp
    if not (cacache_files or plan.rewrite or npx_drop):
        print("nothing to clean")
        return 0
    report_sizes(f"_cacache, unused > {keep_days}d", len(plan.content), cacache_files)
    report_sizes(f"_npx packages, unused > {keep_days}d", len(npx_drop), npx_drop)
    total, real = measure_real(cacache_files + npx_drop)
    if dry_run:
        print(f"[dry-run] would remove du {human_bytes(total)}, real {human_bytes(real)}"
              + (f", compact {len(plan.rewrite)} index bucket(s)" if plan.rewrite else ""))
        return total
    free_before = volume_free(root)
    apply_cacache_plan(plan)
    removed = apply_npx_plan(npx, npx_drop) if npx_drop else 0
    print(f"✅ done, {removed} npx package(s) removed, volume free +{human_bytes(max(volume_free(root) - free_before, 0))}")
    return total


# ── codex session cleanup ───────────────────────────────────
# `codex resume` and the app list sessions from state_5.sqlite's `threads` table, which names
# each rollout's path; deleting a rollout file by hand leaves a row that can't be opened. So:
# - compress: a rollout unused for a week becomes <name>.jsonl.zst. codex reads that form
#   transparently whatever its compression flag says (rollout/src/compression.rs,
#   open_rollout_line_reader, codex 0.167), and the index keeps the .jsonl path. The publish
#   protocol is codex's own: encode and verify aside, then under the writer coordination
#   lock, with the thread's writer lock free and the source unchanged, link the .zst in place
#   and remove the .jsonl.
# - delete: past the delete age, `codex delete --force <uuid>`, which removes the rollout
#   (either form), the state rows and the name index together. Without --force it refuses
#   when there is no terminal. It also refuses threads others reference.
# Threads spawned from one another age as one: a family is as recent as its newest member.
CODEX_STATE_DB = "state_5.sqlite"
CODEX_THREAD_COLUMNS = {"id", "rollout_path", "updated_at", "is_pinned", "archived"}
CODEX_DELETE_MAX = 200
CODEX_DELETE_BUDGET = 600  # seconds per run, ~2s per delete
CODEX_TMP_STALE = 6 * 3600  # codex's own TEMP_FILE_STALE_AFTER


@dataclass
class CodexThread:
    id: str
    path: Path  # the .jsonl path the index stores
    updated_at: float
    pinned: bool
    related: list[str] = field(default_factory=list)  # spawn parent and children
    file: Path | None = None  # what is on disk: the .jsonl, its .jsonl.zst, or nothing (dangling row)
    mtime: float = 0.0

    @property
    def compressed(self) -> bool:
        return self.file is not None and self.file.name.endswith(".zst")


@dataclass
class CodexPlan:
    compress: list[CodexThread] = field(default_factory=list)
    delete: list[CodexThread] = field(default_factory=list)
    skipped: list[tuple[CodexThread, str]] = field(default_factory=list)


def load_codex_threads(home: Path) -> dict[str, CodexThread] | None:
    """Unarchived threads from codex's state db; None when the db isn't the layout this step knows."""
    db = home / CODEX_STATE_DB
    if not db.is_file() or any(p.name != CODEX_STATE_DB for p in home.glob("state_*.sqlite")):
        return None
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    try:
        if not CODEX_THREAD_COLUMNS <= {row[1] for row in con.execute("pragma table_info(threads)")}:
            return None
        rows = con.execute("select id, rollout_path, updated_at, is_pinned from threads where archived = 0").fetchall()
        has_edges = con.execute("select 1 from sqlite_master where name = 'thread_spawn_edges'").fetchone()
        edges = con.execute("select parent_thread_id, child_thread_id from thread_spawn_edges").fetchall() if has_edges else []
    finally:
        con.close()
    threads = {}
    for tid, rollout, updated, pinned in rows:
        updated = float(updated or 0)
        threads[tid] = CodexThread(tid, Path(rollout), updated / 1000 if updated > 1e11 else updated, bool(pinned))
    for parent, child in edges:
        if parent in threads and child in threads:
            threads[parent].related.append(child)
            threads[child].related.append(parent)
    for t in threads.values():
        for candidate in (t.path, t.path.with_name(t.path.name + ".zst")):
            if candidate.is_file():
                t.file, t.mtime = candidate, candidate.stat().st_mtime
                break
    return threads


def codex_history(home: Path) -> dict[str, float]:
    """Session id → when the user last typed into it (history.jsonl)."""
    latest: dict[str, float] = {}
    with contextlib.suppress(FileNotFoundError):
        for line in (home / "history.jsonl").read_text(errors="replace").splitlines():
            with contextlib.suppress(ValueError, KeyError, TypeError):
                entry = json.loads(line)
                latest[entry["session_id"]] = max(latest.get(entry["session_id"], 0.0), float(entry["ts"]))
    return latest


def codex_locked_ids(home: Path) -> set[str]:
    """Threads whose writer lock a codex process holds right now."""
    held = set()
    for lock in (home / "thread-writer-locks").glob("*.lock"):
        if lock.name.startswith("."):
            continue
        fd = try_flock(lock)
        if fd is False:
            held.add(lock.stem)
        elif fd is not None:
            os.close(fd)
    return held


def plan_codex(threads: dict[str, CodexThread], history: dict[str, float], opened: set[str], locked: set[str],
               compress_days: int, delete_days: int, now: float) -> CodexPlan:
    last = {t.id: max(t.updated_at, t.mtime, history.get(t.id, 0.0)) for t in threads.values()}
    family_last: dict[str, float] = {}
    for tid in threads:
        if tid in family_last:
            continue
        members, todo = set(), [tid]
        while todo:
            cur = todo.pop()
            if cur not in members:
                members.add(cur)
                todo.extend(threads[cur].related)
        newest = max(last[m] for m in members)
        family_last.update(dict.fromkeys(members, newest))

    plan = CodexPlan()
    for t in sorted(threads.values(), key=lambda t: t.id):
        age = now - family_last[t.id]
        if age <= compress_days * 86400:
            continue
        if t.file is not None and (str(t.file) in opened or str(t.path) in opened):
            plan.skipped.append((t, "open in a running codex"))
        elif t.id in locked:
            plan.skipped.append((t, "writer lock held"))
        elif age > delete_days * 86400 and not t.pinned:
            plan.delete.append(t)
        elif t.file is not None and not t.compressed:
            plan.compress.append(t)
    return plan


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def zstd_sha256(zstd: str, path: Path) -> str | None:
    digest = hashlib.sha256()
    with subprocess.Popen([zstd, "-d", "-q", "-c", str(path)], stdout=subprocess.PIPE) as proc:
        for chunk in iter(lambda: proc.stdout.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest() if proc.returncode == 0 else None


def zstd_size(zstd: str, path: Path) -> int:
    """Bytes `zstd -3` turns path into, without writing them anywhere."""
    size = 0
    with subprocess.Popen([zstd, "-3", "-q", "-c", str(path)], stdout=subprocess.PIPE) as proc:
        for chunk in iter(lambda: proc.stdout.read(1 << 20), b""):
            size += len(chunk)
    return size


def same_file(path: Path, before: os.stat_result) -> bool:
    try:
        st = path.stat()
    except FileNotFoundError:
        return False
    return (st.st_ino, st.st_size, st.st_mtime_ns) == (before.st_ino, before.st_size, before.st_mtime_ns)


@contextlib.contextmanager
def codex_publication_lock(home: Path, thread_id: str) -> Iterator[bool]:
    """codex's publication guard: hold .coordination.lock, having seen the thread's writer lock free."""
    locks = home / "thread-writer-locks"
    locks.mkdir(exist_ok=True)
    coord = os.open(locks / ".coordination.lock", os.O_RDWR | os.O_CREAT, 0o644)
    try:
        deadline = time.monotonic() + 30
        while True:
            try:
                fcntl.flock(coord, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    yield False
                    return
                time.sleep(0.05)
        probe = try_flock(locks / f"{thread_id}.lock")
        if probe is not None and probe is not False:
            os.close(probe)  # every writer takes coordination first, so the probe can go
        yield probe is not False
    finally:
        os.close(coord)


def compress_rollout(home: Path, thread: CodexThread, on_encoded: Callable[[], object] | None = None) -> tuple[int, int] | None:
    """Replace a rollout by its .jsonl.zst. Returns (blocks before, blocks after), None when skipped."""
    zstd = shutil.which("zstd")
    plain = thread.path
    target = plain.with_name(plain.name + ".zst")
    if zstd is None or not plain.is_file() or target.exists():
        return None
    before = plain.stat()
    fd, tmp_name = tempfile.mkstemp(prefix="rollout-compress-", suffix=".jsonl.zst.tmp", dir=plain.parent)
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as out:
            if subprocess.run([zstd, "-3", "-q", "-c", str(plain)], stdout=out, timeout=600).returncode != 0:
                return None
        if on_encoded:
            on_encoded()
        if zstd_sha256(zstd, tmp) != file_sha256(plain):
            return None  # corrupt, or the rollout changed while encoding
        os.chmod(tmp, stat.S_IMODE(before.st_mode))
        os.utime(tmp, ns=(before.st_atime_ns, before.st_mtime_ns))
        with codex_publication_lock(home, thread.id) as free:
            if not free or not same_file(plain, before):
                return None
            try:
                os.link(tmp, target)
            except FileExistsError:
                return None
            if not same_file(plain, before):
                target.unlink()
                return None
            plain.unlink()
        return before.st_blocks * 512, target.stat().st_blocks * 512
    finally:
        tmp.unlink(missing_ok=True)


def plan_codex_releases(home: Path, ps_output: str) -> list[Path]:
    """Standalone releases neither `current` nor any running process uses (codex prunes only the daemon's)."""
    releases = home / "packages/standalone/releases"
    if not releases.is_dir():
        return []
    current = (home / "packages/standalone/current").resolve()
    return [
        d for d in sorted(releases.iterdir())
        if d.is_dir() and not d.is_symlink() and d.resolve() != current
        and f"{d}/" not in ps_output and f"{d.resolve()}/" not in ps_output
    ]


def delete_codex_threads(codex: str, threads: list[CodexThread]) -> tuple[int, list[str]]:
    """`codex delete --force` each thread within the time budget. Returns (deleted, refusals).
    Deleting a parent removes its spawned children too, so a child's own delete then fails:
    a refusal whose rollout is already gone counts as deleted."""
    deleted, refused, started = 0, [], time.monotonic()
    for t in threads:
        if time.monotonic() - started > CODEX_DELETE_BUDGET:
            break
        result = run([codex, "delete", "--force", t.id], timeout=60)
        if result.returncode == 0 or (t.file is not None and not t.file.exists()):
            deleted += 1
        else:
            refused.append(f"{t.id}: {((result.stderr or result.stdout).strip().splitlines() or ['?'])[-1][:120]}")
    return deleted, refused


def cleanup_codex(compress_days: int, delete_days: int, dry_run: bool) -> int:
    """Compress and delete expired codex sessions, drop unused releases. Returns bytes freed (or that would be)."""
    print("── codex sessions ─────────────────────────────────")
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    if not home.is_dir():
        print(f"no codex home at {home}, nothing to clean")
        return 0
    threads = load_codex_threads(home)
    if threads is None:
        print(f"{DANGER_MARKER} {home} has no {CODEX_STATE_DB} with the threads table this step knows (codex upgraded?); skipped")
        return 0
    now = time.time()
    sessions = home / "sessions"
    lsof = run(["lsof", "-Fn", "+D", str(sessions)], timeout=120).stdout if sessions.is_dir() else ""
    opened = {line[1:] for line in lsof.splitlines() if line.startswith("n")}
    plan = plan_codex(threads, codex_history(home), opened, codex_locked_ids(home), compress_days, delete_days, now)
    ps_output = "\n".join(row[-1] for row in parse_ps(ps_snapshot()))
    releases = plan_codex_releases(home, ps_output)
    stale_tmp = [p for p in sessions.glob("*/*/*/rollout-compress-*.tmp") if now - p.lstat().st_mtime > CODEX_TMP_STALE]

    codex = shutil.which("codex")
    print(f"  {home}  ({len(threads)} sessions, {len(opened)} rollout(s) open, {sum(t.compressed for t in threads.values())} compressed)")
    if not (plan.compress or plan.delete or releases or stale_tmp):
        print("nothing to clean" + (f" ({len(plan.skipped)} expired but in use)" if plan.skipped else ""))
        return 0
    zstd = shutil.which("zstd")
    compressible = [t for t in plan.compress if t.file] if zstd else []
    if plan.compress and not zstd:
        print(f"  {DANGER_MARKER} zstd not found (brew install zstd), {len(plan.compress)} session(s) left uncompressed")
    comp_du = sum(t.file.stat().st_blocks * 512 for t in compressible)
    if dry_run:  # what compressing frees, measured: rollouts with images barely shrink
        comp_du -= sum(-(-zstd_size(zstd, t.file) // 4096) * 4096 for t in compressible)
    label = f"compress, unused > {compress_days}d"
    print(f"  {label:<34} {len(compressible):>6}  " + (f"frees {human_bytes(comp_du):>9}" if dry_run else ""))
    deletable = plan.delete if codex else []
    if plan.delete and not codex:
        print(f"  {DANGER_MARKER} codex CLI not found, {len(plan.delete)} expired session(s) kept")
    del_du, _ = report_sizes(f"delete, unused > {delete_days}d", len(deletable), [t.file for t in deletable if t.file])
    rel_du, _ = report_sizes("releases nothing runs from", len(releases), releases)
    for t, why in plan.skipped:
        print(f"  kept {t.id}: {why}")
    if dry_run:
        print(
            f"[dry-run] would compress {len(compressible)}, delete {len(deletable)} session(s), "
            f"{len(releases)} release(s): frees {human_bytes(comp_du + del_du + rel_du)}"
        )
        return comp_du + del_du + rel_du

    free_before = volume_free(home)
    for path in stale_tmp:
        path.unlink(missing_ok=True)
    compressed = comp_freed = 0
    for t in compressible:
        sizes = compress_rollout(home, t)
        if sizes is not None:
            compressed += 1
            comp_freed += sizes[0] - sizes[1]
    deleted, refused = delete_codex_threads(codex, deletable[:CODEX_DELETE_MAX])
    for line in refused:
        print(f"  codex refused {line}")
    if releases:
        trash = make_trash(releases[0].parent)
        try:
            for i, d in enumerate(releases):
                d.rename(trash / f"{i}-{d.name}")
        finally:
            shutil.rmtree(trash)
    print(
        f"✅ done, compressed {compressed} (freed {human_bytes(comp_freed)}), deleted {deleted} session(s), "
        f"{len(releases)} release(s), volume free +{human_bytes(max(volume_free(home) - free_before, 0))}"
    )
    return comp_freed + del_du + rel_du


# ── dev-space hand-off (project rules, monitoring) ──────────
# dev-space (next to this script) owns the per-project rules and the disk monitor; the 06:00
# run reaches them through two sections. projects runs before the cache sections, so caches
# no longer count references from node_modules/.venvs it just deleted; watch runs last.
def dev_space_args(section: str, dry_run: bool) -> list[str]:
    if section == "projects":
        return ["clean", "--scheduled", *(["-n"] if dry_run else [])]
    return ["watch", "--no-record", "--no-notify"] if dry_run else ["watch", "--agent"]


def dev_space_found(section: str, returncode: int, dry_run: bool) -> int:
    """dev-space's exit code as this script's "found" count; failures raise, for run_sections to report."""
    if returncode == 0:
        return 0
    if section == "projects" and dry_run and returncode == 1:
        return 1
    raise RuntimeError(f"dev-space {' '.join(dev_space_args(section, dry_run))} exited {returncode}")


def run_dev_space(section: str, dry_run: bool) -> int:
    print(f"── {section} (dev-space) {'─' * (36 - len(section))}")
    script = Path(__file__).resolve().parent / "dev-space"
    if not script.is_file():
        print(f"{script.name} not found next to this script, skipped")
        return 0
    sys.stdout.flush()  # the child writes to the same log
    returncode = subprocess.run([str(script), *dev_space_args(section, dry_run)], timeout=3600).returncode
    return dev_space_found(section, returncode, dry_run)


# ── browser code-sign clone cleanup ─────────────────────────
# At launch, Chromium browsers (Chrome, AdsPower's SunBrowser, …) copy their app bundle to
# <DARWIN_USER_TEMP_DIR>/../X/<bundle id>.code_sign_clone/code_sign_clone.XXXXXX/, so that an
# update replacing the app on disk cannot break the running browser's code signature. A
# browser that quits normally deletes its clone; one that is killed or crashes leaves it, and
# by 2026-10-27 agent-browser sessions had left 35 of them, 74 GiB by du.
#
# Most of that is not real disk use: the clones are APFS clones, sharing blocks with the
# installed app and with each other. A clone only costs space once the app updates and it is
# left holding the old version, ~0.7 GiB per Chrome version however many clones share it.
#
# Neither lsof nor `codesign -dv <pid>` can tell which running browser owns a clone: the main
# executable in every clone of one version is a hard link to the same inode, so both name an
# arbitrary sibling. Launch time can: a browser clones itself within a second or two of starting.
CLONE_GLOB = "*.code_sign_clone/code_sign_clone.*"
# Clone birth time minus the browser's start time, in seconds. ps reports elapsed time in
# whole seconds, so the estimated start can be a little late.
CLONE_MATCH_WINDOW = (-30, 300)
CLONE_TRASH_PREFIX = TRASH_PREFIX
# A trash dir younger than this may belong to a run still deleting it.
CLONE_TRASH_GRACE = 3600


@dataclass
class Clone:
    """One code_sign_clone.XXXXXX dir, with the running browser that owns it if any."""

    path: Path
    born: float
    exe: str | None  # CFBundleExecutable of the cloned app, None when there is no Info.plist
    owner: int | None = None


def clone_root() -> Path:
    return Path(run(["getconf", "DARWIN_USER_TEMP_DIR"]).stdout.strip()).parent / "X"


def read_clones(root: Path) -> list[Clone]:
    clones = []
    for path in sorted(root.glob(CLONE_GLOB)):
        plists = sorted(path.glob("*/Contents/Info.plist"))
        exe = plistlib.loads(plists[0].read_bytes()).get("CFBundleExecutable") if plists else None
        clones.append(Clone(path, path.stat().st_birthtime, exe))
    return clones


def browser_starts(ps_rows: list[tuple], exe: str, now: float) -> list[tuple[int, float]]:
    """(pid, start time) of every running browser process of the app whose executable is exe."""
    exe_re = re.compile(rf"/Contents/MacOS/{re.escape(exe)}(?: |$)")
    # Helpers sit in other bundles but carry the exe's name as a prefix, and all have a --type=.
    return [(pid, now - age) for pid, _, age, _, cmd in ps_rows if exe_re.search(cmd) and "--type=" not in cmd]


def plan_clone_cleanup(clones: list[Clone], ps_rows: list[tuple], now: float) -> tuple[list[Clone], list[Clone]]:
    """Split clones into (orphans, kept). A clone is kept when a running browser of its app
    started just before it was made (its owner is set), or when its app is unknown."""
    low, high = CLONE_MATCH_WINDOW
    orphans, kept = [], []
    for clone in clones:
        if clone.exe is None:
            kept.append(clone)
            continue
        starts = browser_starts(ps_rows, clone.exe, now)
        clone.owner = next((pid for pid, start in starts if low <= clone.born - start <= high), None)
        (kept if clone.owner else orphans).append(clone)
    return orphans, kept


def stale_clone_trash(root: Path, now: float) -> list[Path]:
    """Trash dirs that a run which crashed before deleting them left in root."""
    return sorted(p for p in root.glob(f"{CLONE_TRASH_PREFIX}*") if p.stat().st_birthtime < now - CLONE_TRASH_GRACE)


def remove_clones(root: Path, orphans: list[Clone], stale_trash: list[Path]) -> int:
    """Rename each orphan into a trash dir, then delete it and the stale trash. Returns orphans removed.

    The rename keeps this from racing a browser that is deleting its own clone right now,
    such as one the agent-browser step just closed.
    """
    trash = Path(tempfile.mkdtemp(prefix=CLONE_TRASH_PREFIX, dir=root))
    removed = 0
    for i, clone in enumerate(orphans):
        try:
            clone.path.rename(trash / f"{i}-{clone.path.name}")
        except FileNotFoundError:
            continue  # its browser got there first
        removed += 1
    for path in [trash, *stale_trash]:
        shutil.rmtree(path)
    return removed


def cleanup_clones(dry_run: bool) -> int:
    """Delete code-sign clones no running browser owns. Returns clones removed (or that would be)."""
    print("── browser code-sign clones ───────────────────────")
    root = clone_root()
    # Read the clones before ps: a browser that clones itself after this is not in the list.
    clones = read_clones(root)
    ps_rows = parse_ps(ps_snapshot())
    now = time.time()
    orphans, kept = plan_clone_cleanup(clones, ps_rows, now)
    stale_trash = stale_clone_trash(root, now)
    if not orphans and not stale_trash:
        print("nothing to clean" + (f" ({len(kept)} in use)" if kept else ""))
        return 0

    for app in sorted({c.path.parent.name for c in orphans}):
        items = [c.path for c in orphans if c.path.parent.name == app]
        print(f"  {app.removesuffix('.code_sign_clone'):<28} {len(items):>3} orphaned  {human_bytes(tree_bytes(items, set()))} by du")
    if stale_trash:
        print(f"  {len(stale_trash)} trash dir(s) left by an earlier run")
    for clone in kept:
        owner = f"pid {clone.owner}" if clone.owner else "unknown app"
        print(f"  keeping {clone.path.parent.name.removesuffix('.code_sign_clone')}/{clone.path.name}  ({owner})")
    if dry_run:
        print(f"[dry-run] would remove {len(orphans)} clone(s); they share blocks with the app and each other, so far less than du is freed")
        return len(orphans) + len(stale_trash)

    free_before = volume_free(root)
    removed = remove_clones(root, orphans, stale_trash)
    print(f"✅ done, removed {removed} clone(s), volume free +{human_bytes(max(volume_free(root) - free_before, 0))}")
    return removed


