#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Release macOS dev resources: booted iOS simulators, agent-browser Chrome trees, stale
Rust build artifacts in the shared cargo target dir, old entries in the uv cache, and
code-sign clones left behind by browsers that did not quit normally.

None of them cleans up after itself. A booted simulator keeps a full launchd_sim tree of
iOS daemons and widget extensions alive (hundreds of processes, GBs of RAM); a leaked
agent-browser session keeps a ~10-process headless Chrome tree spinning at ~100% CPU
per renderer, indefinitely; and a target dir shared by every Rust project only grows, as
does the uv cache, which keeps every wheel and environment it ever made. Every killed
Chrome leaves a copy of its app bundle under /var/folders, which keeps the version it
was launched from on disk after the app has updated.

`--only games` (never part of the default run) closes Hearthstone and Battle.net before
the night, when the Mac wakes on its own for agents: left open, the game keeps the
display from sleeping and Battle.net's helpers compete with the agents' work.

Exit code: 0 on success, 2 if a section crashed (the others still ran). With --dry-run,
1 means there is something to clean (so it composes as a check, like mac-health).
"""

import argparse
import fcntl
import json
import os
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from dataclasses import dataclass, field
from pathlib import Path

# Chrome's --user-data-dir is what ties a process to an agent-browser session, and is
# the only reliable discriminator from the user's own Chrome.
AGENT_BROWSER_UDD_RE = re.compile(r"--user-data-dir=\S*?agent-browser-chrome-([0-9a-fA-F-]{36})")
AGENT_BROWSER_DAEMON_RE = re.compile(r"node_modules/agent-browser/bin/agent-browser-darwin")
# Only the browser process itself lacks --type=; helpers all carry one.
CHROME_ROOT_RE = re.compile(r"/Google Chrome\.app/Contents/MacOS/Google Chrome\b")
SIM_RUNTIME_RE = re.compile(r"simruntime/Contents/Resources/RuntimeRoot")
SIMULATOR_APP_RE = re.compile(r"Simulator\.app/Contents/MacOS/Simulator\b")

# `ps` truncates the command column to terminal width unless -ww is given, which
# silently hides processes whose --user-data-dir sits past the cutoff.
PS_ARGS = ["ps", "-Awwo", "pid,ppid,etime,pcpu,command"]

DANGER_MARKER = "⚠️"

# clones runs after browser, so it also takes the clones of the sessions browser just killed.
DEFAULT_TARGETS = ["browser", "sim", "cargo", "uv", "clones"]
# These free disk, not memory.
DISK_TARGETS = {"cargo", "uv", "clones"}


@dataclass(frozen=True)
class Game:
    """A game or launcher to close in the evening, matched on its executable path."""

    name: str
    exe_re: re.Pattern
    bundle_id: str | None = None  # asked to quit via AppleScript; None = background helper, signals only


GAMES = [
    Game(
        "Hearthstone",
        re.compile(r"/(?:Hearthstone|Hearthstone Beta Launcher|BlizzardBrowser)\.app/Contents/MacOS/"),
        bundle_id="unity.Blizzard Entertainment.Hearthstone",
    ),
    # Its Helper processes (Chromium renderers etc.) run from a versioned framework under
    # ~/Library/Application Support/Battle.net/Versions/, not from inside the app bundle.
    Game("Battle.net", re.compile(r"/Battle\.net\.app/Contents/|/Battle\.net/Versions/"), bundle_id="net.battle.app"),
    Game("Blizzard Agent", re.compile(r"/Battle\.net/Agent/")),
]
GAMES_PS_ARGS = ["ps", "-Awwo", "pid=,comm="]
# Long enough for a game to save and shut down on its own before it gets signalled.
GAME_QUIT_GRACE = 20.0


@dataclass
class Instance:
    """One agent-browser session: its Chrome process tree plus the daemon that spawned it."""

    uuid: str
    pids: set[int] = field(default_factory=set)
    daemon_pid: int | None = None
    root_pid: int | None = None
    age_seconds: int = 0
    cpu_pct: float = 0.0

    @property
    def all_pids(self) -> set[int]:
        return self.pids | ({self.daemon_pid} if self.daemon_pid else set())


# ── Parsing ─────────────────────────────────────────────────
def parse_etime(etime: str) -> int:
    """Convert a ps ELAPSED field ([[dd-]hh:]mm:ss) to seconds. Unparseable → 0."""
    days, _, clock = etime.strip().rpartition("-")
    parts = clock.split(":")
    if not all(p.isdigit() for p in parts) or not 2 <= len(parts) <= 3:
        return 0
    if days and not days.isdigit():
        return 0
    nums = [int(p) for p in parts]
    seconds = nums.pop()
    seconds += nums.pop() * 60
    if nums:
        seconds += nums.pop() * 3600
    if days:
        seconds += int(days) * 86400
    return seconds


def parse_ps(ps_output: str) -> list[tuple[int, int, int, float, str]]:
    """Split ps output into (pid, ppid, age_seconds, cpu_pct, command) rows."""
    rows = []
    for line in ps_output.splitlines():
        fields = line.split(maxsplit=4)
        if len(fields) < 5 or not fields[0].isdigit():
            continue  # header or malformed
        pid, ppid, etime, pcpu, command = fields
        rows.append((int(pid), int(ppid), parse_etime(etime), float(pcpu), command))
    return rows


def parse_agent_browser_procs(ps_output: str) -> tuple[list[Instance], list[tuple[int, int]]]:
    """Split ps output into agent-browser instances and orphan daemons.

    Returns (instances, orphan_daemons) where orphan_daemons is [(pid, age_seconds)]
    for daemons with no Chrome tree left. Never matches the user's own Chrome.
    """
    rows = parse_ps(ps_output)
    daemons = {pid: age for pid, _, age, _, cmd in rows if AGENT_BROWSER_DAEMON_RE.search(cmd)}

    instances: dict[str, Instance] = {}
    for pid, ppid, age, cpu, command in rows:
        match = AGENT_BROWSER_UDD_RE.search(command)
        if not match:
            continue
        inst = instances.setdefault(match.group(1), Instance(uuid=match.group(1)))
        inst.pids.add(pid)
        inst.age_seconds = max(inst.age_seconds, age)
        inst.cpu_pct += cpu
        # The root browser process is the one without --type=; its parent is the daemon.
        if CHROME_ROOT_RE.search(command) and "--type=" not in command:
            inst.root_pid = pid
            if ppid in daemons:
                inst.daemon_pid = ppid
                inst.age_seconds = max(inst.age_seconds, daemons[ppid])

    claimed = {i.daemon_pid for i in instances.values() if i.daemon_pid}
    orphans = sorted((pid, age) for pid, age in daemons.items() if pid not in claimed)
    return list(instances.values()), orphans


def select_instances(
    instances: list[Instance],
    orphans: list[tuple[int, int]],
    min_age_hours: float,
) -> tuple[list[Instance], list[tuple[int, int]], list[Instance]]:
    """Partition by age. Returns (instances_to_kill, orphans_to_kill, instances_kept)."""
    cutoff = min_age_hours * 3600
    kill_i = [i for i in instances if i.age_seconds >= cutoff]
    kept = [i for i in instances if i.age_seconds < cutoff]
    kill_o = [(pid, age) for pid, age in orphans if age >= cutoff]
    return kill_i, kill_o, kept


def parse_booted_devices(simctl_json: str) -> list[dict[str, str]]:
    """Extract booted devices from `simctl list devices -j` output."""
    try:
        data = json.loads(simctl_json)
    except json.JSONDecodeError:
        return []
    booted = []
    for runtime, devices in (data.get("devices") or {}).items():
        for device in devices:
            if device.get("state") == "Booted":
                booted.append(
                    {
                        "udid": device.get("udid", "?"),
                        "name": device.get("name", "?"),
                        "runtime": runtime.rsplit(".", 1)[-1],
                    }
                )
    return booted


def parse_game_procs(ps_output: str) -> dict[str, set[int]]:
    """Running game processes by game name, from `ps -o pid=,comm=` output."""
    found: dict[str, set[int]] = {}
    for line in ps_output.splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) < 2 or not fields[0].isdigit():
            continue
        game = next((g for g in GAMES if g.exe_re.search(fields[1])), None)
        if game:
            found.setdefault(game.name, set()).add(int(fields[0]))
    return found


def quit_script(bundle_id: str) -> list[str]:
    """AppleScript lines that ask a running app to quit, without launching or waiting on it.

    By bundle id: Launch Services does not resolve "Battle.net" as an app name (`open -a` fails).
    """
    return [
        f'if application id "{bundle_id}" is running then',
        "ignoring application responses",
        f'tell application id "{bundle_id}" to quit',
        "end ignoring",
        "end if",
    ]


# ── Process helpers ─────────────────────────────────────────
def run(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def ps_snapshot() -> str:
    return run(PS_ARGS, timeout=20).stdout


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError) as e:
        return isinstance(e, PermissionError)  # exists but not ours
    return True


def kill_pids(pids: set[int], grace: float = 6.0) -> tuple[int, int]:
    """SIGTERM, wait for exit, then SIGKILL survivors. Returns (termed, force_killed)."""
    termed = 0
    for pid in sorted(pids):
        try:
            os.kill(pid, signal.SIGTERM)
            termed += 1
        except (ProcessLookupError, PermissionError):
            pass

    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        if not any(alive(pid) for pid in pids):
            return termed, 0
        time.sleep(0.3)

    forced = 0
    for pid in sorted(pids):
        if not alive(pid):
            continue
        try:
            os.kill(pid, signal.SIGKILL)
            forced += 1
        except (ProcessLookupError, PermissionError):
            pass
    return termed, forced


def count_procs(pattern: re.Pattern, ps_output: str) -> int:
    return sum(1 for *_, cmd in parse_ps(ps_output) if pattern.search(cmd))


def human_age(seconds: int) -> str:
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes = rem // 60
    if days:
        return f"{days}d{hours}h"
    if hours:
        return f"{hours}h{minutes}m"
    return f"{minutes}m{seconds % 60}s"


# ── Memory snapshot ─────────────────────────────────────────
def mem_stats() -> tuple[float | None, float | None]:
    """Return (system free memory %, swap used GB) — both None if unavailable."""
    free_pct = None
    out = run(["memory_pressure", "-Q"], timeout=15).stdout
    match = re.search(r"free percentage:\s*(\d+)", out)
    if match:
        free_pct = float(match.group(1))

    swap_gb = None
    out = run(["sysctl", "-n", "vm.swapusage"], timeout=10).stdout
    match = re.search(r"used\s*=\s*([\d.]+)M", out)
    if match:
        swap_gb = float(match.group(1)) / 1024
    return free_pct, swap_gb


# ── agent-browser cleanup ───────────────────────────────────
def cleanup_agent_browser(min_age_hours: float, dry_run: bool) -> int:
    """Close agent-browser sessions. Returns the number of processes reaped (or found)."""
    print("── agent-browser ──────────────────────────────────")
    instances, orphans = parse_agent_browser_procs(ps_snapshot())
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours)

    if not kill_i and not kill_o:
        suffix = f" ({len(kept)} newer than {min_age_hours}h kept)" if kept else ""
        print(f"nothing to clean{suffix}")
        return 0

    for inst in kill_i:
        marker = f" {DANGER_MARKER} runaway" if inst.cpu_pct > 100 else ""
        print(
            f"  session {inst.uuid[:8]}  age {human_age(inst.age_seconds):>7}  "
            f"{len(inst.all_pids):>2} procs  {inst.cpu_pct:>5.0f}% CPU{marker}"
        )
    for pid, age in kill_o:
        print(f"  idle daemon pid {pid}  age {human_age(age):>7}  (no browser attached)")
    for inst in kept:
        print(f"  keeping {inst.uuid[:8]}  age {human_age(inst.age_seconds):>7}  (newer than {min_age_hours}h)")

    targets = {p for i in kill_i for p in i.all_pids} | {pid for pid, _ in kill_o}
    if dry_run:
        print(f"[dry-run] would reap {len(targets)} processes")
        return len(targets)

    # `agent-browser close --all` is all-or-nothing, so it is only safe when no
    # instance is being spared by --min-age.
    if not kept:
        result = run(["agent-browser", "close", "--all"], timeout=90)
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                if line.strip():
                    print(f"  {line.strip()}")
        elif result.returncode == 127 or "not found" in result.stderr:
            print("  agent-browser CLI unavailable, falling back to signals")
        else:
            print(f"  {DANGER_MARKER} close --all failed: {result.stderr.strip()[:200]}")
    else:
        print(f"  skipping `close --all` (would also close the {len(kept)} kept session(s)); signalling instead")

    survivors = {pid for pid in targets if alive(pid)}
    if survivors:
        termed, forced = kill_pids(survivors)
        print(f"  reaped {termed} leftover process(es)" + (f", {forced} needed SIGKILL" if forced else ""))

    remaining = count_procs(AGENT_BROWSER_UDD_RE, ps_snapshot())
    print(f"✅ done, {remaining} agent-browser chrome process(es) left")
    return len(targets)


# ── simulator cleanup ───────────────────────────────────────
def cleanup_simulators(dry_run: bool) -> int:
    """Shut down booted simulators and quit Simulator.app. Returns processes reaped."""
    print("── iOS simulators ─────────────────────────────────")
    listing = run(["xcrun", "simctl", "list", "devices", "-j"], timeout=60)
    if listing.returncode != 0:
        print(f"{DANGER_MARKER} simctl unavailable: {listing.stderr.strip()[:200]}")
        return 0

    devices = parse_booted_devices(listing.stdout)
    before = ps_snapshot()
    runtime_procs = count_procs(SIM_RUNTIME_RE, before)
    app_pids = {pid for pid, _, _, _, cmd in parse_ps(before) if SIMULATOR_APP_RE.search(cmd)}

    if not devices and not runtime_procs and not app_pids:
        print("nothing to clean")
        return 0

    for device in devices:
        print(f"  booted  {device['name']} ({device['udid'][:8]}, {device['runtime']})")
    print(f"  {runtime_procs} iOS runtime process(es), Simulator.app {'running' if app_pids else 'not running'}")

    if dry_run:
        todo = f"would shut down {len(devices)} device(s), reap {runtime_procs} runtime process(es)"
        if app_pids:
            todo += ", quit Simulator.app"
        print(f"[dry-run] {todo}")
        return runtime_procs + len(app_pids)

    result = run(["xcrun", "simctl", "shutdown", "all"], timeout=180)
    if result.returncode != 0:
        print(f"  {DANGER_MARKER} shutdown all: {result.stderr.strip()[:200]}")

    if app_pids:
        run(["osascript", "-e", 'quit app "Simulator"'], timeout=30)
        deadline = time.monotonic() + 6
        while time.monotonic() < deadline and any(alive(pid) for pid in app_pids):
            time.sleep(0.5)
        # Simulator.app routinely ignores the AppleScript quit; fall back to signals.
        stubborn = {pid for pid in app_pids if alive(pid)}
        if stubborn:
            kill_pids(stubborn)
            print(f"  Simulator.app ignored quit, signalled pid(s) {sorted(stubborn)}")

    after = ps_snapshot()
    left = count_procs(SIM_RUNTIME_RE, after)
    app_left = count_procs(SIMULATOR_APP_RE, after)
    print(
        f"✅ done, {runtime_procs - left} runtime process(es) gone, {left} left"
        + (f", {DANGER_MARKER} Simulator.app still up" if app_left else "")
    )
    return (runtime_procs - left) + (len(app_pids) - app_left)


# ── games cleanup ───────────────────────────────────────────
def cleanup_games(dry_run: bool) -> int:
    """Quit games and their launchers, then signal whatever outlived the quit. Returns processes found."""
    print("── games ──────────────────────────────────────────")
    found = parse_game_procs(run(GAMES_PS_ARGS, timeout=20).stdout)
    if not found:
        print("nothing to clean")
        return 0

    for name, pids in found.items():
        print(f"  {name:<16} {len(pids):>2} process(es)")
    targets = set().union(*found.values())
    if dry_run:
        print(f"[dry-run] would close {', '.join(found)} ({len(targets)} processes)")
        return len(targets)

    for game in GAMES:
        if game.bundle_id and game.name in found:
            run(["osascript", *[arg for line in quit_script(game.bundle_id) for arg in ("-e", line)]], timeout=30)
    deadline = time.monotonic() + GAME_QUIT_GRACE
    while time.monotonic() < deadline and any(alive(pid) for pid in targets):
        time.sleep(0.5)

    stubborn = {pid for pid in targets if alive(pid)}
    if stubborn:
        _, forced = kill_pids(stubborn)
        print(f"  {len(stubborn)} process(es) outlived the quit, signalled" + (f", {forced} needed SIGKILL" if forced else ""))

    left = parse_game_procs(run(GAMES_PS_ARGS, timeout=20).stdout)
    print(
        f"✅ done, closed {', '.join(found)}"
        + (f", {DANGER_MARKER} still running: {', '.join(left)}" if left else "")
    )
    return len(targets)


# ── cargo target cleanup ────────────────────────────────────
# What cargo-sweep reports per target dir, e.g. `[INFO] Cleaned 4.51 GiB from "…"`.
SWEEP_RESULT_RE = re.compile(r"(?:Cleaned|Would clean:) (nothing|[\d.]+ (?:B|KiB|MiB|GiB|TiB)) from")
BYTE_UNITS = {"B": 1, "KiB": 1024, "MiB": 1024**2, "GiB": 1024**3, "TiB": 1024**4}

# cargo-sweep only accepts a project path and finds the target dir via `cargo metadata`.
# An empty project with no local override resolves to the global build.target-dir, so
# the sweep never depends on any real project still existing.
STUB_MANIFEST = '[package]\nname = "mac-dev-cleanup-stub"\nversion = "0.0.0"\nedition = "2021"\n'


def parse_sweep_bytes(output: str) -> int | None:
    """Bytes cargo-sweep says it cleaned (or would clean). None when it printed no result."""
    sizes = SWEEP_RESULT_RE.findall(output)
    if not sizes:
        return None
    total = 0
    for size in sizes:
        if size != "nothing":
            number, unit = size.split()
            total += int(float(number) * BYTE_UNITS[unit])
    return total


def pick_shared_target(metadata_json: str, stub: Path) -> Path | None:
    """The target dir `cargo metadata` reports for the stub, or None if it is the stub's own."""
    target = Path(json.loads(metadata_json)["target_directory"])
    # Resolve both sides: macOS temp dirs live under /var, which cargo may report as /private/var.
    if target.resolve().is_relative_to(stub.resolve()):
        return None
    return target


def human_bytes(size: float) -> str:
    if size < 1024:
        return f"{size:.0f} B"
    for unit in ("KiB", "MiB", "GiB"):
        size /= 1024
        if size < 1024:
            return f"{size:.1f} {unit}"
    return f"{size / 1024:.1f} TiB"


def reset_polluted_atimes(target: Path, dry_run: bool) -> int:
    """Set fingerprint JSONs read since cargo last wrote them back to atime = mtime.

    cargo-sweep ranks artifacts by the newest atime in each .fingerprint/<unit>/ dir, and
    cargo's freshness check reads only the hash file there, so that atime is a true
    "last used by a build". The JSON is read by cargo only right before rewriting it, but
    `cargo sweep --installed` (even with --dry-run) reads every one, which makes the whole
    target look used today and silently disables the time-based sweep for weeks.
    """
    count = 0
    for path in target.glob("*/.fingerprint/*/*.json"):
        stat = path.stat()
        if stat.st_atime_ns > stat.st_mtime_ns:
            count += 1
            if not dry_run:
                os.utime(path, ns=(stat.st_mtime_ns, stat.st_mtime_ns))
    return count


def lock_target(target: Path) -> list[int] | None:
    """Take every cargo build lock in the target without blocking. None if cargo holds one.

    Holding them for the sweep makes a build that starts meanwhile wait, instead of
    reading artifacts as they are deleted. Cargo takes these with flock(2), as does
    fcntl.flock. The profile dirs (debug/, release/) hold the host locks, which cargo
    takes even for --target builds.
    """
    fds = []
    for path in sorted(target.glob("*/.cargo*lock")):
        fd = os.open(path, os.O_RDONLY)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            for taken in fds:
                os.close(taken)
            return None
        fds.append(fd)
    return fds


def dir_size(path: Path) -> int:
    """Disk usage in bytes. `du` counts hardlinks once, and incremental objects are hardlinked."""
    return int(run(["du", "-sk", str(path)], timeout=300).stdout.split()[0]) * 1024


def sweep_target(cargo: str, stub: Path, target: Path, keep_days: int, max_size: str, dry_run: bool) -> int:
    """Run the time sweep, then the size cap. Returns bytes cleaned (or that would be)."""
    before = dir_size(target)
    print(f"  {target}  {human_bytes(before)}")

    polluted = reset_polluted_atimes(target, dry_run)
    if polluted and dry_run:
        print(f"  [dry-run] would reset atime on {polluted} fingerprint json(s) read outside cargo; estimates below run low")
    elif polluted:
        print(f"  reset atime on {polluted} fingerprint json(s) read outside cargo")

    total = 0
    passes = [(f"unused > {keep_days}d", ["--time", str(keep_days)]), (f"cap {max_size}", ["--maxsize", max_size])]
    for label, criterion in passes:
        cmd = [cargo, "sweep", *criterion, *(["--dry-run"] if dry_run else []), str(stub)]
        result = run(cmd, timeout=600)
        cleaned = parse_sweep_bytes(result.stdout + result.stderr)
        if cleaned is None:
            tail = (result.stderr or result.stdout).strip().splitlines()[-1:] or ["no output"]
            print(f"  {DANGER_MARKER} {label}: cargo sweep failed: {tail[0][:200]}")
            continue
        total += cleaned
        print(f"  {label:<16} {'would clean' if dry_run else 'cleaned'} {human_bytes(cleaned)}")

    if not dry_run:
        print(f"✅ done, {human_bytes(before)} → {human_bytes(dir_size(target))}")
    return total


def cleanup_cargo(keep_days: int, max_size: str, dry_run: bool) -> int:
    """Sweep the shared cargo target dir. Returns bytes cleaned (or that would be)."""
    print("── cargo target ───────────────────────────────────")
    cargo = shutil.which("cargo")
    if not cargo:
        print("cargo not found, skipped")
        return 0
    if not shutil.which("cargo-sweep"):
        print(f"{DANGER_MARKER} cargo-sweep not installed (`cargo install cargo-sweep`), skipped")
        return 0

    with tempfile.TemporaryDirectory(prefix="mac-dev-cleanup-") as tmp:
        stub = Path(tmp)
        (stub / "Cargo.toml").write_text(STUB_MANIFEST)
        (stub / "src").mkdir()
        (stub / "src/lib.rs").touch()

        meta = run([cargo, "metadata", "--no-deps", "--format-version", "1", "--manifest-path", str(stub / "Cargo.toml")])
        if meta.returncode != 0:
            print(f"{DANGER_MARKER} cargo metadata failed: {meta.stderr.strip()[:200]}")
            return 0
        target = pick_shared_target(meta.stdout, stub)
        if target is None:
            print("no shared build.target-dir configured, nothing to sweep")
            return 0
        if not target.is_dir():
            print(f"{target} does not exist yet, nothing to sweep")
            return 0

        fds = lock_target(target)
        if fds is None:
            print(f"a cargo build is using {target}, skipped this run")
            return 0
        try:
            return sweep_target(cargo, stub, target, keep_days, max_size, dry_run)
        finally:
            for fd in fds:
                os.close(fd)


# ── uv cache cleanup ────────────────────────────────────────
# `uv cache prune` cannot run here unattended. Resident `uv run` jobs (proc-top, …) hold a
# shared lock on the cache for as long as they live, so prune waits forever; and with
# --force it deletes every cached environment, including the ones those jobs run from.
# This section does the same garbage collection by hand, leaving in-use entries alone.
#
# The cache layout of uv 0.9.17 (CacheBucket::to_str in crates/uv-cache/src/lib.rs).
# uv bumps a bucket's version whenever its format changes, so a uv binary that does not
# contain every one of these names lays the cache out differently, and is left alone.
UV_BUCKETS = (
    "sdists-v9",
    "flat-index-v2",
    "git-v0",
    "interpreter-v4",
    "simple-v18",
    "wheels-v5",
    "archive-v0",
    "builds-v0",
    "environments-v2",
    "python-v0",
    "binaries-v0",
)
UV_MARKERS = {"CACHEDIR.TAG", ".gitignore", ".git", ".lock"}
UV_TRASH_PREFIX = ".mac-dev-cleanup-trash-"
# An install persists an archive first and links it after; anything younger may be mid-install.
UV_GRACE_SECONDS = 86400
# A uv holding the cache lock for less than this may be installing right now.
UV_BUSY_SECONDS = 600
UV_KIND_LABELS = {
    "stale": "old buckets, temp dirs",
    "orphan": "unreferenced archives",
    "wheel": "downloaded wheels",
    "env": "environments",
}


@dataclass
class UvRemoval:
    """A cache entry to delete, with the symlinks that point at it (removed alongside)."""

    kind: str  # one of UV_KIND_LABELS
    path: Path
    links: list[Path] = field(default_factory=list)


def uv_layout_matches(binary: Path) -> bool:
    """Whether this uv binary was built with every bucket name in UV_BUCKETS."""
    data = binary.read_bytes()
    return all(name.encode() in data for name in UV_BUCKETS)


def young_uv_holders(holders: set[int], ps_rows: list[tuple], self_pid: int, min_age: int) -> list[int]:
    """Lock holders started less than min_age seconds ago, other than this script's own launcher."""
    parents = {pid: ppid for pid, ppid, *_ in ps_rows}
    ages = {pid: age for pid, _, age, *_ in ps_rows}
    ancestors, pid = set(), self_pid
    while pid in parents and pid not in ancestors:
        ancestors.add(pid)
        pid = parents[pid]
    return sorted(p for p in holders - ancestors if p in ages and ages[p] < min_age)


def uv_archive_links(cache: Path) -> dict[str, dict[str, list[Path]]]:
    """Archive id → {"wheels" | "sdists" | "envs": [symlinks pointing at that archive]}."""
    archive_root = os.path.realpath(cache / "archive-v0")
    found: dict[str, dict[str, list[Path]]] = {}

    def add(source: str, path: Path) -> None:
        target = os.path.realpath(path)
        if os.path.dirname(target) == archive_root:
            found.setdefault(os.path.basename(target), {}).setdefault(source, []).append(path)

    for source, bucket in (("wheels", "wheels-v5"), ("sdists", "sdists-v9")):
        for dirpath, dirs, files in os.walk(cache / bucket):
            dirs[:] = [d for d in dirs if d != "src"]  # unpacked source trees, as uv skips them too
            for name in dirs + files:
                if os.path.islink(os.path.join(dirpath, name)):
                    add(source, Path(dirpath, name))
    # Cached environments (`uv run --with`, uvx) are environments-v2/<interpreter>/<hash> links;
    # the other entries there are `uv run --script` environments, real venvs not worth walking.
    for top in sorted((cache / "environments-v2").glob("*")):
        if top.is_symlink():
            add("envs", top)
        elif top.is_dir() and not (top / "pyvenv.cfg").exists():
            for child in sorted(top.iterdir()):
                if child.is_symlink():
                    add("envs", child)
    return found


def uv_pointer_bytes(cache: Path) -> bytes:
    """All .http/.rev pointer files, concatenated. They name archives by id inside msgpack."""
    chunks = []
    for bucket in ("wheels-v5", "sdists-v9"):
        for dirpath, dirs, files in os.walk(cache / bucket):
            dirs[:] = [d for d in dirs if d != "src"]
            chunks += [Path(dirpath, f).read_bytes() for f in files if f.endswith((".http", ".rev"))]
    return b"\n".join(chunks)


def plan_uv_cleanup(cache: Path, keep_days: int, ps_output: str, now: float) -> tuple[list[UvRemoval], list[str]]:
    """What to delete from the cache. Returns (removals, entries kept only because a process uses them).

    uv records no last-use time and this Mac only updates atime on the first read after a
    write, so age is creation time: a still-needed wheel is downloaded once more, an
    environment rebuilt from the archives. Wheels built from source stay, since rebuilding
    them takes minutes and a toolchain.
    """
    grace_cutoff = now - UV_GRACE_SECONDS
    age_cutoff = now - keep_days * 86400
    removals: list[UvRemoval] = []
    in_use: list[str] = []

    def born(path: Path) -> float:
        return path.lstat().st_birthtime

    def consider(kind: str, path: Path, cutoff: float, links: list[Path] | None = None) -> None:
        if born(path) >= cutoff:
            return
        links = links or []
        if any(f"{p}/" in ps_output for p in (path, *links)):
            in_use.append(str((links[0] if links else path).relative_to(cache)))
            return
        removals.append(UvRemoval(kind, path, links))

    for entry in sorted(cache.iterdir()):
        if entry.name not in UV_BUCKETS and entry.name not in UV_MARKERS:
            consider("stale", entry, grace_cutoff)

    links_by_id = uv_archive_links(cache)
    pointers = uv_pointer_bytes(cache)
    for archive in sorted((cache / "archive-v0").iterdir()):
        sources = links_by_id.get(archive.name, {})
        links = [lk for group in sources.values() for lk in group]
        if not sources:
            if archive.name.encode() not in pointers:
                consider("orphan", archive, grace_cutoff)
        elif set(sources) == {"wheels"}:
            consider("wheel", archive, age_cutoff, links)
        elif set(sources) == {"envs"}:
            consider("env", archive, age_cutoff, links)

    for env in sorted((cache / "environments-v2").glob("*/pyvenv.cfg")):
        consider("env", env.parent, age_cutoff)
    return removals, in_use


def apply_uv_plan(cache: Path, removals: list[UvRemoval]) -> None:
    """Rename each entry into a trash dir, so uv sees it whole or not at all, then delete the trash."""
    trash = Path(tempfile.mkdtemp(prefix=UV_TRASH_PREFIX, dir=cache))
    for i, item in enumerate(removals):
        for link in item.links:
            link.unlink(missing_ok=True)
        item.path.rename(trash / f"{i}-{item.path.name}")
    shutil.rmtree(trash)


def tree_bytes(paths: list[Path], seen: set[int]) -> int:
    """Allocated bytes under paths, each inode once (what du reports)."""
    total = 0
    for root in paths:
        for dirpath, _dirs, files in os.walk(root):
            for name in [dirpath, *(os.path.join(dirpath, f) for f in files)]:
                st = os.lstat(name)
                if st.st_ino not in seen:
                    seen.add(st.st_ino)
                    total += st.st_blocks * 512
    return total


def volume_free(path: Path) -> int:
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def cleanup_uv(keep_days: int, dry_run: bool) -> int:
    """Trim the uv cache. Returns bytes cleaned (or that would be), as du counts them."""
    print("── uv cache ───────────────────────────────────────")
    uv = shutil.which("uv")
    if not uv:
        print("uv not found, skipped")
        return 0
    if not uv_layout_matches(Path(uv).resolve()):
        version = run([uv, "--version"]).stdout.strip()
        print(f"{DANGER_MARKER} {version} lays out its cache differently, skipped (update UV_BUCKETS)")
        return 0
    cache = Path(run([uv, "cache", "dir"]).stdout.strip())
    if not (cache / "archive-v0").is_dir():
        print(f"no uv cache at {cache}, nothing to clean")
        return 0

    holders = {int(pid) for pid in run(["lsof", "-t", "--", str(cache / ".lock")]).stdout.split()}
    ps_rows = parse_ps(ps_snapshot())
    busy = young_uv_holders(holders, ps_rows, os.getpid(), UV_BUSY_SECONDS)
    if busy:
        print(f"uv started < {UV_BUSY_SECONDS // 60}m ago may be installing (pid {', '.join(map(str, busy))}), skipped this run")
        return 0

    removals, in_use = plan_uv_cleanup(cache, keep_days, "\n".join(row[-1] for row in ps_rows), time.time())
    before = dir_size(cache)
    print(f"  {cache}  {human_bytes(before)}")
    seen: set[int] = set()
    total = 0
    for kind, label in UV_KIND_LABELS.items():
        items = [i for i in removals if i.kind == kind]
        if not items:
            continue
        size = tree_bytes([i.path for i in items], seen)
        total += size
        age = "" if kind in ("stale", "orphan") else f" > {keep_days}d"
        print(f"  {label + age:<26} {len(items):>5}  {human_bytes(size)}")
    if in_use:
        print(f"  kept, in use: {', '.join(in_use)}")
    if not removals:
        print("nothing to clean")
        return 0
    if dry_run:
        print(f"[dry-run] would remove {len(removals)} entries, {human_bytes(total)} by du")
        return total

    free_before = volume_free(cache)
    apply_uv_plan(cache, removals)
    # uv installs by APFS clone, so blocks shared with installed venvs stay allocated.
    print(
        f"✅ done, {human_bytes(before)} → {human_bytes(dir_size(cache))}, "
        f"volume free +{human_bytes(max(volume_free(cache) - free_before, 0))}"
    )
    return total


# ── browser code-sign clone cleanup ─────────────────────────
# At launch, Chromium browsers (Chrome, AdsPower's SunBrowser, …) copy their app bundle to
# <DARWIN_USER_TEMP_DIR>/../X/<bundle id>.code_sign_clone/code_sign_clone.XXXXXX/, so that an
# update replacing the app on disk cannot break the running browser's code signature. A
# browser that quits normally deletes its clone; one that is killed or crashes leaves it, and
# by 2026-10-27 agent-browser sessions had left 35 of them, 74 GiB by du.
#
# Most of that is not real disk use: the clones are APFS clones, sharing blocks with the
# installed app and with each other. A clone only costs space once the app updates and it is
# left holding the old version, ~0.7 GiB per Chrome version however many clones share it.
#
# Neither lsof nor `codesign -dv <pid>` can tell which running browser owns a clone: the main
# executable in every clone of one version is a hard link to the same inode, so both name an
# arbitrary sibling. Launch time can: a browser clones itself within a second or two of starting.
CLONE_GLOB = "*.code_sign_clone/code_sign_clone.*"
# Clone birth time minus the browser's start time, in seconds. ps reports elapsed time in
# whole seconds, so the estimated start can be a little late.
CLONE_MATCH_WINDOW = (-30, 300)
CLONE_TRASH_PREFIX = ".mac-dev-cleanup-trash-"
# A trash dir younger than this may belong to a run still deleting it.
CLONE_TRASH_GRACE = 3600


@dataclass
class Clone:
    """One code_sign_clone.XXXXXX dir, with the running browser that owns it if any."""

    path: Path
    born: float
    exe: str | None  # CFBundleExecutable of the cloned app, None when there is no Info.plist
    owner: int | None = None


def clone_root() -> Path:
    return Path(run(["getconf", "DARWIN_USER_TEMP_DIR"]).stdout.strip()).parent / "X"


def read_clones(root: Path) -> list[Clone]:
    clones = []
    for path in sorted(root.glob(CLONE_GLOB)):
        plists = sorted(path.glob("*/Contents/Info.plist"))
        exe = plistlib.loads(plists[0].read_bytes()).get("CFBundleExecutable") if plists else None
        clones.append(Clone(path, path.stat().st_birthtime, exe))
    return clones


def browser_starts(ps_rows: list[tuple], exe: str, now: float) -> list[tuple[int, float]]:
    """(pid, start time) of every running browser process of the app whose executable is exe."""
    exe_re = re.compile(rf"/Contents/MacOS/{re.escape(exe)}(?: |$)")
    # Helpers sit in other bundles but carry the exe's name as a prefix, and all have a --type=.
    return [(pid, now - age) for pid, _, age, _, cmd in ps_rows if exe_re.search(cmd) and "--type=" not in cmd]


def plan_clone_cleanup(clones: list[Clone], ps_rows: list[tuple], now: float) -> tuple[list[Clone], list[Clone]]:
    """Split clones into (orphans, kept). A clone is kept when a running browser of its app
    started just before it was made (its owner is set), or when its app is unknown."""
    low, high = CLONE_MATCH_WINDOW
    orphans, kept = [], []
    for clone in clones:
        if clone.exe is None:
            kept.append(clone)
            continue
        starts = browser_starts(ps_rows, clone.exe, now)
        clone.owner = next((pid for pid, start in starts if low <= clone.born - start <= high), None)
        (kept if clone.owner else orphans).append(clone)
    return orphans, kept


def stale_clone_trash(root: Path, now: float) -> list[Path]:
    """Trash dirs that a run which crashed before deleting them left in root."""
    return sorted(p for p in root.glob(f"{CLONE_TRASH_PREFIX}*") if p.stat().st_birthtime < now - CLONE_TRASH_GRACE)


def remove_clones(root: Path, orphans: list[Clone], stale_trash: list[Path]) -> int:
    """Rename each orphan into a trash dir, then delete it and the stale trash. Returns orphans removed.

    The rename keeps this from racing a browser that is deleting its own clone right now,
    such as one the agent-browser step just closed.
    """
    trash = Path(tempfile.mkdtemp(prefix=CLONE_TRASH_PREFIX, dir=root))
    removed = 0
    for i, clone in enumerate(orphans):
        try:
            clone.path.rename(trash / f"{i}-{clone.path.name}")
        except FileNotFoundError:
            continue  # its browser got there first
        removed += 1
    for path in [trash, *stale_trash]:
        shutil.rmtree(path)
    return removed


def cleanup_clones(dry_run: bool) -> int:
    """Delete code-sign clones no running browser owns. Returns clones removed (or that would be)."""
    print("── browser code-sign clones ───────────────────────")
    root = clone_root()
    # Read the clones before ps: a browser that clones itself after this is not in the list.
    clones = read_clones(root)
    ps_rows = parse_ps(ps_snapshot())
    now = time.time()
    orphans, kept = plan_clone_cleanup(clones, ps_rows, now)
    stale_trash = stale_clone_trash(root, now)
    if not orphans and not stale_trash:
        print("nothing to clean" + (f" ({len(kept)} in use)" if kept else ""))
        return 0

    for app in sorted({c.path.parent.name for c in orphans}):
        items = [c.path for c in orphans if c.path.parent.name == app]
        print(f"  {app.removesuffix('.code_sign_clone'):<28} {len(items):>3} orphaned  {human_bytes(tree_bytes(items, set()))} by du")
    if stale_trash:
        print(f"  {len(stale_trash)} trash dir(s) left by an earlier run")
    for clone in kept:
        owner = f"pid {clone.owner}" if clone.owner else "unknown app"
        print(f"  keeping {clone.path.parent.name.removesuffix('.code_sign_clone')}/{clone.path.name}  ({owner})")
    if dry_run:
        print(f"[dry-run] would remove {len(orphans)} clone(s); they share blocks with the app and each other, so far less than du is freed")
        return len(orphans) + len(stale_trash)

    free_before = volume_free(root)
    removed = remove_clones(root, orphans, stale_trash)
    print(f"✅ done, removed {removed} clone(s), volume free +{human_bytes(max(volume_free(root) - free_before, 0))}")
    return removed


