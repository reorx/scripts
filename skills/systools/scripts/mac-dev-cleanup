_FAILED = 0


def check(name: str, got, want) -> None:
    global _FAILED
    if got == want:
        print(f"  ✅ {name}")
    else:
        _FAILED += 1
        print(f"  ❌ {name}\n       got:  {got!r}\n       want: {want!r}")


def selftest() -> int:
    print("parse_etime")
    check("mm:ss", parse_etime("08:50"), 530)
    check("hh:mm:ss", parse_etime("23:12:10"), 83530)
    check("dd-hh:mm:ss", parse_etime("01-21:18:20"), 163100)
    check("multi-day", parse_etime("09-23:51:05"), 863465)
    check("padded single digit", parse_etime("0:05"), 5)
    check("garbage → 0", parse_etime("ELAPSED"), 0)

    print("\nparse_agent_browser_procs")
    instances, orphans = parse_agent_browser_procs(PS_FIXTURE)
    by_uuid = {i.uuid: i for i in instances}
    check(
        "finds 2 instances",
        sorted(by_uuid),
        ["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3", "7b38b244-8dff-466b-9124-6323ec0ca515"],
    )
    hot = by_uuid["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3"]
    check("groups whole chrome tree", sorted(hot.pids), [4497, 4512, 4518])
    check("links spawning daemon", hot.daemon_pid, 96741)
    check("identifies chrome root", hot.root_pid, 4497)
    check("age spans daemon lifetime", hot.age_seconds, 164702)
    check("sums cpu across tree", round(hot.cpu_pct, 1), 199.3)
    check("orphan daemon w/o chrome", orphans, [(11213, 37725)])
    all_touched = {p for i in instances for p in i.all_pids} | {p for p, _ in orphans}
    check("SAFETY: user's own chrome untouched", 2843 in all_touched, False)
    check("SAFETY: launchd untouched", 1 in all_touched, False)

    print("\nselect_instances")
    # Fixture ages: 78de5d01 = 45.7h, 7b38b244 = 23.2h, orphan 11213 = 10.5h.
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours=24)
    check("age filter kills the stale one", [i.uuid for i in kill_i], ["78de5d01-fc2e-4218-bc6a-32e9ab6bb4b3"])
    check("age filter keeps the fresh one", [i.uuid for i in kept], ["7b38b244-8dff-466b-9124-6323ec0ca515"])
    check("age filter keeps fresh orphan", kill_o, [])
    kill_i, _, kept = select_instances(instances, orphans, min_age_hours=1)
    check("1h cutoff catches both day-old sessions", (len(kill_i), len(kept)), (2, 0))
    kill_i, kill_o, kept = select_instances(instances, orphans, min_age_hours=0)
    check("min_age 0 takes everything", (len(kill_i), len(kill_o), len(kept)), (2, 1, 0))

    print("\nparse_booted_devices")
    devices = parse_booted_devices(SIMCTL_FIXTURE)
    check("only booted devices", [d["name"] for d in devices], ["iPhone 17 Pro", "iPhone 17"])
    check("keeps udid", devices[0]["udid"], "286BA6DA-9436-454A-A33F-C3406AF6F74C")
    check("empty runtime tolerated", parse_booted_devices('{"devices":{"x":[]}}'), [])
    check("malformed → empty", parse_booted_devices("not json"), [])

    print("\nhelpers")
    check("counts sim runtime procs", count_procs(AGENT_BROWSER_UDD_RE, PS_FIXTURE), 4)
    check("human_age days", human_age(164702), "1d21h")
    check("human_age hours", human_age(83530), "23h12m")
    check("human_age minutes", human_age(530), "8m50s")

    print("\ncargo: parse_sweep_bytes")
    check("cleaned GiB", parse_sweep_bytes('[INFO] Cleaned 4.51 GiB from "/c/cargo-target"\n'), int(4.51 * 1024**3))
    check("would clean KiB", parse_sweep_bytes('[INFO] Would clean: 21.69 KiB from "/c"'), int(21.69 * 1024))
    check("plain bytes", parse_sweep_bytes('[INFO] Cleaned 512.00 B from "/c"'), 512)
    check("nothing → 0", parse_sweep_bytes('[INFO] Cleaned nothing from "/c"'), 0)
    # cargo-sweep logs its failures and still exits 0, so "no result line" is the failure signal.
    check("error output → None", parse_sweep_bytes('Error: Failed to gather metadata for "/c"'), None)

    print("\ncargo: pick_shared_target")
    stub = Path("/var/folders/zz/T/mac-dev-cleanup-stub")
    check(
        "configured target-dir is picked",
        pick_shared_target('{"target_directory": "/Users/me/Library/Caches/cargo-target"}', stub),
        Path("/Users/me/Library/Caches/cargo-target"),
    )
    check(
        "stub-local target → None (no target-dir configured)",
        pick_shared_target('{"target_directory": "/var/folders/zz/T/mac-dev-cleanup-stub/target"}', stub),
        None,
    )
    check(
        "/private/var alias of the stub → still None",
        pick_shared_target('{"target_directory": "/private/var/folders/zz/T/mac-dev-cleanup-stub/target"}', stub),
        None,
    )

    print("\ncargo: human_bytes")
    check("GiB", human_bytes(19.5 * 1024**3), "19.5 GiB")
    check("MiB", human_bytes(21 * 1024**2), "21.0 MiB")
    check("bytes", human_bytes(512), "512 B")

    print("\ncargo: reset_polluted_atimes")
    with tempfile.TemporaryDirectory() as tmp:
        target = Path(tmp)
        polluted = target / "debug/.fingerprint/foo-1234abcd/lib-foo.json"
        clean = target / "release/.fingerprint/bar-5678abcd/lib-bar.json"
        hash_file = polluted.with_name("lib-foo")
        for path in (polluted, clean, hash_file):
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("{}")
        mtime = 1_700_000_000_000_000_000
        os.utime(polluted, ns=(mtime + 86_400 * 10**9, mtime))  # read a day after cargo wrote it
        os.utime(clean, ns=(mtime, mtime))
        os.utime(hash_file, ns=(mtime + 3600 * 10**9, mtime))  # cargo's own freshness read
        check("dry-run counts only the polluted json", reset_polluted_atimes(target, dry_run=True), 1)
        check("dry-run changes nothing", polluted.stat().st_atime_ns, mtime + 86_400 * 10**9)
        check("reset counts the polluted json", reset_polluted_atimes(target, dry_run=False), 1)
        check("json atime is back to its mtime", polluted.stat().st_atime_ns, mtime)
        check("json mtime preserved", polluted.stat().st_mtime_ns, mtime)
        check("SAFETY: hash file atime (the real LRU signal) untouched", hash_file.stat().st_atime_ns, mtime + 3600 * 10**9)
        check("second pass finds nothing", reset_polluted_atimes(target, dry_run=False), 0)

    print("\ncargo: lock_target")
    with tempfile.TemporaryDirectory() as tmp:
        target = Path(tmp)
        locks = [target / "debug/.cargo-lock", target / "debug/.cargo-build-lock", target / "release/.cargo-lock"]
        for path in locks:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.touch()
        fds = lock_target(target)
        check("idle target → takes every lock", len(fds or []), 3)
        for fd in fds or []:
            os.close(fd)
        # A running cargo holds one of them (possibly shared, e.g. the artifact lock).
        busy = os.open(locks[2], os.O_RDONLY)
        fcntl.flock(busy, fcntl.LOCK_SH)
        check("a lock held by cargo → None", lock_target(target), None)
        probe = os.open(locks[0], os.O_RDONLY)
        try:
            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
            released = True
        except BlockingIOError:
            released = False
        check("backing off releases the locks it already took", released, True)
        os.close(probe)
        os.close(busy)
        check("no lock files → nothing to take", lock_target(target / "missing"), [])

    print("\ngames: parse_game_procs")
    found = parse_game_procs(GAMES_PS_FIXTURE)
    check("Hearthstone with its embedded browser", sorted(found.get("Hearthstone", [])), [62114, 62120])
    check("Battle.net with its helpers", sorted(found.get("Battle.net", [])), [51000, 51010, 51020])
    check("Blizzard's background update agent", sorted(found.get("Blizzard Agent", [])), [50990])
    touched = set().union(*found.values())
    check("SAFETY: Steam untouched (not on the list)", 778 in touched, False)
    check("SAFETY: the user's Chrome untouched", 779 in touched, False)
    check("SAFETY: launchd untouched", 1 in touched, False)
    check("no games running → empty", parse_game_procs("    1 /sbin/launchd\n"), {})

    print("\ngames: quit_script")
    script = quit_script("net.battle.app")
    # `tell application` launches an app that isn't running.
    check("only targets an app that is running", script[0], 'if application id "net.battle.app" is running then')
    # A quit confirmation dialog would otherwise hang osascript until the subprocess timeout.
    check("does not wait for the app to answer", "ignoring application responses" in script, True)

    print("\ngames: default run")
    # The 06:00 run and any manual `mac-dev-cleanup` must never close a game mid-match;
    # games are closed only by the explicit `--only games` evening job.
    check("games are not in the default targets", "games" in DEFAULT_TARGETS, False)

    print("\nuv: uv_layout_matches")
    with tempfile.TemporaryDirectory() as tmp:
        binary = Path(tmp) / "uv"
        # Rust packs string literals back to back, with no separator.
        binary.write_bytes(b"\x00junk" + "".join(UV_BUCKETS).encode() + b"more")
        check("a uv built with every bucket name we know", uv_layout_matches(binary), True)
        binary.write_bytes("".join(UV_BUCKETS).replace("wheels-v5", "wheels-v6").encode())
        check("a uv whose wheel bucket moved on → skip", uv_layout_matches(binary), False)

    print("\nuv: young_uv_holders")
    rows = parse_ps(UV_PS_FIXTURE)
    check(
        "a uv started minutes ago is busy; residents and our own launcher are not",
        young_uv_holders({1514, 1515, 47020, 900}, rows, self_pid=901, min_age=600),
        [47020],
    )
    check("a holder that exited since lsof is ignored", young_uv_holders({99999}, rows, self_pid=901, min_age=600), [])

    print("\nuv: plan_uv_cleanup")
    with tempfile.TemporaryDirectory() as tmp:
        cache = Path(tmp)
        now = time.time()
        old, recent, fresh = now - 200 * 86400, now - 5 * 86400, now
        archive = cache / "archive-v0"

        def entry(path: Path, born: float, venv: bool = False) -> Path:
            path.mkdir(parents=True)
            if venv:
                (path / "pyvenv.cfg").write_text("uv = 0.9.17\n")
            os.utime(path, (born, born))  # an mtime before the birth time moves the birth time back on APFS
            return path

        def link(path: Path, target: Path) -> Path:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.symlink_to(target)
            return path

        for name in ("CACHEDIR.TAG", ".gitignore", ".lock"):
            (cache / name).touch()
        current_bucket = entry(cache / "simple-v18", old)
        entry(cache / "simple-v15", old)  # an older uv's bucket
        entry(cache / ".tmpCrashed", recent)  # temp dir of a uv run that died
        in_flight_tmp = entry(cache / ".tmpInFlight", fresh)  # temp dir of a uv run going on now

        old_wheel = entry(archive / "OLDWHEELxxxxxxxxxxxxx", old)
        old_wheel_link = link(cache / "wheels-v5/pypi/foo/1.0-py3-none-any", old_wheel)
        old_wheel_pointer = cache / "wheels-v5/pypi/foo/1.0-py3-none-any.http"
        old_wheel_pointer.write_bytes(b"\x95\xb5" + old_wheel.name.encode())
        new_wheel = entry(archive / "NEWWHEELxxxxxxxxxxxxx", recent)
        link(cache / "wheels-v5/pypi/foo/2.0-py3-none-any", new_wheel)
        built = entry(archive / "BUILTxxxxxxxxxxxxxxxx", old)
        link(cache / "sdists-v9/pypi/bar/1.0/rev/bar-1.0-py3-none-any", built)
        orphan = entry(archive / "ORPHANxxxxxxxxxxxxxxx", recent)
        fresh_orphan = entry(archive / "FRESHORPHANxxxxxxxxxx", fresh)
        pointer_only = entry(archive / "POINTERONLYxxxxxxxxxx", recent)
        (cache / "sdists-v9/pypi/baz").mkdir(parents=True)
        (cache / "sdists-v9/pypi/baz/revision.http").write_bytes(b"\xb5" + pointer_only.name.encode() + b"\x92")
        old_env_archive = entry(archive / "OLDENVxxxxxxxxxxxxxxx", old, venv=True)
        old_env_link = link(cache / "environments-v2/1111aaaa/2222bbbb", old_env_archive)
        busy_env_archive = entry(archive / "BUSYENVxxxxxxxxxxxxxx", old, venv=True)
        link(cache / "environments-v2/1111aaaa/3333cccc", busy_env_archive)
        old_script = entry(cache / "environments-v2/oldscript-abc", old, venv=True)
        resident = entry(cache / "environments-v2/proc-top-e16", old, venv=True)
        new_script = entry(cache / "environments-v2/newscript-def", recent, venv=True)
        ps_output = (
            f"{resident}/bin/python3 /Users/me/.local/share/proc-top/proc_top.py\n"
            f"{cache}/environments-v2/1111aaaa/3333cccc/bin/python -m some_tool\n"
        )

        removals, in_use = plan_uv_cleanup(cache, keep_days=90, ps_output=ps_output, now=now)
        by_kind: dict[str, list[str]] = {}
        for item in removals:
            by_kind.setdefault(item.kind, []).append(item.path.name)
        check("old buckets and dead runs' temp dirs", sorted(by_kind.get("stale", [])), [".tmpCrashed", "simple-v15"])
        check("unreferenced archives", by_kind.get("orphan"), [orphan.name])
        check("downloaded wheels past the age limit", by_kind.get("wheel"), [old_wheel.name])
        check(
            "script and cached environments past the age limit",
            sorted(by_kind.get("env", [])),
            sorted([old_env_archive.name, old_script.name]),
        )
        wheel = next(i for i in removals if i.kind == "wheel")
        check("a wheel goes with its index symlink", wheel.links, [old_wheel_link])
        cached_env = next(i for i in removals if i.path == old_env_archive)
        check("a cached env goes with its environments-v2 symlink", cached_env.links, [old_env_link])
        check(
            "SAFETY: environments a process runs from are kept and reported",
            sorted(in_use),
            ["environments-v2/1111aaaa/3333cccc", "environments-v2/proc-top-e16"],
        )
        removed = {i.path for i in removals}
        for what, path in [
            ("an archive created in the last day (install in flight)", fresh_orphan),
            ("a wheel built from source (rebuilding needs a toolchain)", built),
            ("an archive only a pointer file names", pointer_only),
            ("a recent wheel", new_wheel),
            ("a recent script env", new_script),
            ("the bucket the installed uv uses", current_bucket),
            ("a running uv's temp dir", in_flight_tmp),
        ]:
            check(f"SAFETY: keeps {what}", path in removed, False)
        check("SAFETY: never touches uv's marker files", {p.name for p in removed} & UV_MARKERS, set())

        apply_uv_plan(cache, removals)
        check("removed entries are gone", [i.path for i in removals if i.path.exists()], [])
        check("their symlinks are gone", [lk for i in removals for lk in i.links if lk.is_symlink()], [])
        # uv 0.9.17 treats a pointer to a missing archive as stale and downloads again.
        check("the wheel's .http pointer stays", old_wheel_pointer.exists(), True)
        kept = (fresh_orphan, built, pointer_only, new_wheel, busy_env_archive, resident, new_script)
        check("kept entries survive", [p.name for p in kept if not p.exists()], [])
        check("no trash left behind", [p.name for p in cache.iterdir() if p.name.startswith(UV_TRASH_PREFIX)], [])

    print("\nuv: default run")
    check("the uv cache is trimmed by the daily run", "uv" in DEFAULT_TARGETS, True)

    print("\nclones: plan_clone_cleanup")
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        now = time.time()
        rows = parse_ps(CLONE_PS_FIXTURE)
        starts = {pid: now - age for pid, _, age, *_ in rows}

        def make_clone(bundle_id: str, suffix: str, exe: str | None, born: float) -> Path:
            path = root / f"{bundle_id}.code_sign_clone/code_sign_clone.{suffix}"
            contents = path / f"{exe or 'Unknown'}.app.bundle/Contents"
            contents.mkdir(parents=True)
            if exe:
                (contents / "Info.plist").write_bytes(plistlib.dumps({"CFBundleExecutable": exe}))
            os.utime(path, (born, born))  # moves the birth time back, see uv above
            return path

        chrome, sun = "com.google.Chrome", "com.adspower.SunBrowser"
        make_clone(chrome, "MAIN01", "Google Chrome", starts[84743] + 1)
        make_clone(chrome, "AGENT1", "Google Chrome", starts[97388] + 1)
        make_clone(sun, "SUN001", "SunBrowser", starts[24480] - 2)
        make_clone(chrome, "NOPLST", None, now - 30 * 86400)
        make_clone(chrome, "BEFORE", "Google Chrome", starts[84743] - 50_000)
        make_clone(chrome, "LATER1", "Google Chrome", starts[84743] + 3600)
        killed = make_clone(chrome, "KILLED", "Google Chrome", starts[55555] + 1)
        make_clone(chrome, "OTHER1", "Google Chrome", starts[24480] + 1)

        orphans, kept = plan_clone_cleanup(read_clones(root), rows, now)
        owners = {c.path.suffix[1:]: c.owner for c in kept}
        check("the user's long-running Chrome keeps the clone it made at launch", owners.get("MAIN01"), 84743)
        check("a running agent-browser Chrome keeps its clone", owners.get("AGENT1"), 97388)
        check("another Chromium app is matched by its own executable", owners.get("SUN001"), 24480)
        check("SAFETY: a clone whose app can't be identified is kept", "NOPLST" in owners, True)
        check(
            "orphans: born long before or after a launch, by a browser whose renderer outlived it, "
            "or when only another app launched",
            sorted(c.path.suffix[1:] for c in orphans),
            ["BEFORE", "KILLED", "LATER1", "OTHER1"],
        )

        print("\nclones: remove_clones")
        crashed_run = root / f"{CLONE_TRASH_PREFIX}crashed"
        (crashed_run / "leftover").mkdir(parents=True)
        os.utime(crashed_run, (now - 7200, now - 7200))
        running = root / f"{CLONE_TRASH_PREFIX}running"
        running.mkdir()
        stale = stale_clone_trash(root, now)
        check("trash a crashed run left behind is picked up, a running one's is not", stale, [crashed_run])

        shutil.rmtree(killed)  # its browser deleted it between the plan and the removal
        check("removes the orphans, skipping one already gone", remove_clones(root, orphans, stale), 3)
        check("orphans are gone", [c.path.name for c in orphans if c.path.exists()], [])
        check("kept clones survive", [c.path.name for c in kept if not c.path.exists()], [])
        check(
            "no trash left behind but the running one's",
            sorted(p.name for p in root.glob(f"{CLONE_TRASH_PREFIX}*")),
            [running.name],
        )

    print("\nclones: default run")
    check("orphaned clones are removed by the daily run", "clones" in DEFAULT_TARGETS, True)
    check("the clone step frees disk, not memory", "clones" in DISK_TARGETS, True)

    print("\nrun_sections")
    ran = []

    def hung_simctl() -> int:
        raise subprocess.TimeoutExpired(["xcrun", "simctl", "list"], 60)

    def cargo_ok() -> int:
        ran.append("cargo")
        return 3

    found_count, failed = run_sections([("sim", hung_simctl), ("cargo", cargo_ok)])
    check("a crashing section does not skip the rest (2026-10-23 06:00)", ran, ["cargo"])
    check("the failed section is reported by name", failed, ["sim"])
    check("found still counts the sections that ran", found_count, 3)

    print()
    if _FAILED:
        print(f"❌ {_FAILED} check(s) failed")
    else:
        print("✅ all checks passed")
    return 1 if _FAILED else 0


# ── Main ────────────────────────────────────────────────────
def run_sections(sections: list[tuple[str, Callable[[], int]]]) -> tuple[int, list[str]]:
    """Run each cleanup in turn. Returns (total found, names of sections that crashed).

    Part of main's top level: one section crashing must not skip the rest. On
    2026-10-23 `simctl list` hung for 60s right after the 05:30 wake, and the traceback
    took the cargo sweep down with it.
    """
    found, failed = 0, []
    for name, section in sections:
        try:
            found += section()
        except Exception as e:  # noqa: BLE001
            failed.append(name)
            print(f"{DANGER_MARKER} {name} failed: {e!r}")
        print()
    return found, failed


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Release iOS simulator, agent-browser, cargo target, uv cache and browser code-sign clone resources",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-n", "--dry-run", action="store_true", help="Report what would be cleaned, change nothing")
    parser.add_argument(
        "--only",
        choices=["sim", "browser", "cargo", "uv", "clones", "games"],
        help="Clean only simulators, only agent-browser, only the cargo target, only the uv cache, "
        "only orphaned browser code-sign clones, "
        "or close games (default: all but games, which only ever run when asked for explicitly)",
    )
    parser.add_argument(
        "--min-age",
        type=float,
        default=0,
        metavar="HOURS",
        help="Only reap agent-browser sessions older than HOURS (default: 0 = all). "
        "Use e.g. --min-age 2 to run this while a session is actively driving a browser.",
    )
    parser.add_argument(
        "--cargo-days",
        type=int,
        default=21,
        metavar="DAYS",
        help="Remove cargo artifacts no build has used for DAYS (default: 21)",
    )
    # cargo-sweep reads "GB" as 10^9 and sums apparent file sizes, counting the hardlinks
    # between incremental/ and deps/ twice, so its total runs ~5% above `du`. Use GiB.
    parser.add_argument(
        "--cargo-max-size",
        default="20GiB",
        metavar="SIZE",
        help="Then remove least recently used artifacts until the target fits SIZE, as cargo-sweep "
        "measures it: apparent size, a bit above du (default: 20GiB; note GB means 10^9)",
    )
    parser.add_argument(
        "--uv-days",
        type=int,
        default=90,
        metavar="DAYS",
        help="Remove downloaded wheels and cached environments in the uv cache created more than "
        "DAYS ago (default: 90). uv keeps no last-use time; a still-needed one is just fetched again",
    )
    parser.add_argument("--selftest", action="store_true", help="Run behaviour checks and exit")
    args = parser.parse_args()

    if args.selftest:
        return selftest()

    if sys.platform != "darwin":
        print("macOS only", file=sys.stderr)
        return 1

    # Under launchd the output is appended to a log file forever, so stamp each run.
    if not sys.stdout.isatty():
        print(f"═══ mac-dev-cleanup {time.strftime('%Y-%m-%d %H:%M:%S')} ═══")

    targets = [args.only] if args.only else DEFAULT_TARGETS
    # Only processes affect memory; the cargo sweep, uv trim and clone removal free disk.
    track_memory = not set(targets) <= DISK_TARGETS
    if track_memory:
        free_before, swap_before = mem_stats()

    sections = {
        "browser": lambda: cleanup_agent_browser(args.min_age, args.dry_run),
        "sim": lambda: cleanup_simulators(args.dry_run),
        "cargo": lambda: cleanup_cargo(args.cargo_days, args.cargo_max_size, args.dry_run),
        "uv": lambda: cleanup_uv(args.uv_days, args.dry_run),
        "clones": lambda: cleanup_clones(args.dry_run),
        "games": lambda: cleanup_games(args.dry_run),
    }
    found, failed = run_sections([(name, sections[name]) for name in targets])

    if track_memory and not args.dry_run:
        free_after, swap_after = mem_stats()
        parts = []
        if free_before is not None and free_after is not None:
            parts.append(f"free memory {free_before:.0f}% → {free_after:.0f}%")
        if swap_before is not None and swap_after is not None:
            parts.append(f"swap {swap_before:.2f}G → {swap_after:.2f}G")
        if parts:
            print("  ".join(parts))

    if failed:
        return 2
    # Under --dry-run, a non-zero exit means "there is something to clean".
    return 1 if args.dry_run and found else 0


if __name__ == "__main__":
    sys.exit(main())
