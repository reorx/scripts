#!/bin/bash
# Made for Claude Code hooks

CONFIG_DIR="$HOME/.config/cc-format"
IS_OFF_FILE="$CONFIG_DIR/is_off"

usage() {
    if [ -n "$CONTROL_MODE" ]; then
        echo "Usage: $0 <action>"
        echo "Control actions:"
        echo "  toggle    - turn on or off cc-format"
        echo "  status    - show status of cc-format"
    else
        echo "Usage: $0 <filename>"
        echo "       $0 --hook"
        echo "Formats files based on their extension:"
        echo "  .py       - formatted with ruff"
        echo "  .ts/.tsx/.js - formatted with the repo's own prettier or biome config if it has one,"
        echo "                 otherwise biome with cc-format's defaults"
        echo "--hook reads a Claude Code or Codex PostToolUse event from stdin and formats the files it changed"
    fi
    exit 1
}

control_mode() {
    local action="$1"
    
    # Ensure config directory exists
    mkdir -p "$CONFIG_DIR"
    
    case "$action" in
        toggle)
            if [ -f "$IS_OFF_FILE" ]; then
                # Turn on
                rm "$IS_OFF_FILE"
                echo "cc-format is now ON"
            else
                # Turn off
                touch "$IS_OFF_FILE"
                echo "cc-format is now OFF"
            fi
            ;;
        status)
            if [ -f "$IS_OFF_FILE" ]; then
                echo "cc-format is OFF"
            else
                echo "cc-format is ON"
            fi
            ;;
        *)
            echo "Error: Unknown action '$action'"
            usage
            ;;
    esac
}

HOOK_FILE_PATTERN='\.(py|ts|tsx|js)$'

# Paths a Codex patch added, updated or moved to, in order and deduplicated
patch_paths() {
    sed -nE 's/^[[:space:]]*\*\*\* (Add File|Update File|Move to): (.*[^[:space:]])[[:space:]]*$/\2/p' \
        | awk '!seen[$0]++'
}

# Claude Code: one file per Edit/MultiEdit/Write, the formatter's output and exit status pass through
hook_claude() {
    local self="$1" event="$2" file_path
    file_path="$(jq -r '.tool_input.file_path // empty' <<< "$event")"
    [[ "$file_path" =~ $HOOK_FILE_PATTERN ]] || exit 0
    exec "$self" "$file_path"
}

# Codex: one apply_patch can touch several files. The model is not told that a hook changed a file, so
# report the reformatted files or its next patch misses. Report formatter errors the same way and exit 0:
# a non-zero status would replace the patch's result and make an applied patch look failed.
hook_codex() {
    local self="$1" event="$2" path before output changed="" failures="" failed_paths=""
    cd "$(jq -r '.cwd // "."' <<< "$event")" || exit 0
    while IFS= read -r path; do
        # A moved file's old path no longer exists, deleted files are not listed
        [[ "$path" =~ $HOOK_FILE_PATTERN ]] && [ -f "$path" ] || continue
        before="$(cksum < "$path")"
        if ! output="$("$self" "$path" 2>&1 < /dev/null)"; then
            failures+="
- $path: $output"
            failed_paths+=" $path"
        elif [ "$(cksum < "$path")" != "$before" ]; then
            changed+="
- $path"
        fi
    done < <(jq -r '.tool_input.command // empty' <<< "$event" | patch_paths)
    report_codex_hook "$changed" "$failures" "$failed_paths"
    exit 0
}

# Print the Codex hook output for reformatted and failed files, nothing when there are neither
report_codex_hook() {
    local changed="$1" failures="$2" failed_paths="$3" context=""
    [ -n "$changed" ] && context="cc-format reformatted these files after your patch, re-read them before patching them again:$changed"
    [ -n "$failures" ] && context="${context:+$context

}cc-format failed on these files, your patch itself was applied:$failures"
    [ -z "$context" ] && return
    jq -n --arg context "$context" --arg failed "$failed_paths" '
        {hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $context}}
        + if $failed == "" then {} else {systemMessage: "cc-format failed on\($failed)"} end'
}

# Check arguments
[ $# -eq 0 ] && usage

# Check if CONTROL_MODE is set
if [ -n "$CONTROL_MODE" ]; then
    control_mode "$1"
    exit 0
fi

# Check if cc-format is disabled
if [ -f "$IS_OFF_FILE" ]; then
    if [ -n "$DEBUG" ]; then
        echo "cc-format is disabled, skipping formatting" >&2
    fi
    exit 0
fi

# Hook mode: format the files changed by a Claude Code or Codex PostToolUse event
if [ "$1" == "--hook" ]; then
    SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    EVENT="$(cat)"
    if [ "$(jq -r '.tool_name' <<< "$EVENT")" == apply_patch ]; then
        hook_codex "$SELF" "$EVENT"
    fi
    hook_claude "$SELF" "$EVENT"
fi

# Get the file path from the first argument
FILE="$1"

# Check if the file exists
if [ ! -f "$FILE" ]; then
    echo "Error: File '$FILE' does not exist"
    exit 1
fi

# Extract the file extension
EXTENSION="${FILE##*.}"

# Set extra args based on NO_WRITE
if [ -n "$NO_WRITE" ]; then
    RUFF_EXTRA="--diff"
    BIOME_EXTRA=""
else
    RUFF_EXTRA=""
    BIOME_EXTRA="--write"
fi

PRETTIER_CONFIG_PATTERN='^(\.prettierrc(\.(json|json5|yaml|yml|toml|js|cjs|mjs|ts|cts|mts))?|prettier\.config\.(js|cjs|mjs|ts|cts|mts))$'

# Print each directory from $1 up to $2 (inclusive)
walk_up() {
    local dir="$1" stop="$2"
    while true; do
        echo "$dir"
        [ "$dir" == "$stop" ] || [ "$dir" == "/" ] && break
        dir="$(dirname "$dir")"
    done
}

# A dir uses prettier if it has a config file, or package.json mentions prettier (config key or dependency)
dir_uses_prettier() {
    local dir="$1"
    ls -A "$dir" | grep -Eq "$PRETTIER_CONFIG_PATTERN" && return 0
    [ -f "$dir/package.json" ] && grep -Eq '"prettier"[[:space:]]*:' "$dir/package.json"
}

# Shallowest prettier config file anywhere in the git repo, for files outside the config's own subtree
find_repo_prettier_config() {
    local root="$1" path
    git -C "$root" ls-files --cached --others --exclude-standard \
        | awk -F/ '{print NF "\t" $0}' | sort -n | cut -f2- \
        | while read -r path; do
            if basename "$path" | grep -Eq "$PRETTIER_CONFIG_PATTERN"; then
                echo "$root/$path"
                break
            fi
        done
}

# Decide which formatter the file's repo uses, the nearest config wins.
# Sets REPO_FORMATTER (prettier | biome | empty), PRETTIER_CONFIG and BIOME_CONFIG_DIR
detect_repo_formatter() {
    local dir
    REPO_FORMATTER=""
    PRETTIER_CONFIG=""
    BIOME_CONFIG_DIR=""
    while read -r dir; do
        if [ -f "$dir/biome.json" ] || [ -f "$dir/biome.jsonc" ]; then
            REPO_FORMATTER=biome
            BIOME_CONFIG_DIR="$dir"
            return
        fi
        if dir_uses_prettier "$dir"; then
            # prettier resolves this config by itself
            REPO_FORMATTER=prettier
            return
        fi
    done < <(walk_up "$FILE_DIR" "${GIT_ROOT:-/}")
    [ -z "$GIT_ROOT" ] && return
    PRETTIER_CONFIG="$(find_repo_prettier_config "$GIT_ROOT")"
    [ -n "$PRETTIER_CONFIG" ] && REPO_FORMATTER=prettier
}

# Print the repo's own node_modules/.bin/$1, searching up from each given start dir
find_local_bin() {
    local name="$1" start dir
    shift
    for start in "$@"; do
        while read -r dir; do
            if [ -x "$dir/node_modules/.bin/$name" ]; then
                echo "$dir/node_modules/.bin/$name"
                return
            fi
        done < <(walk_up "$start" "${GIT_ROOT:-/}")
    done
}

# Prefer the repo's own prettier, then global, then npx; sets PRETTIER_CMD
resolve_prettier_cmd() {
    local local_bin
    local_bin="$(find_local_bin prettier "$FILE_DIR" "$(dirname "${PRETTIER_CONFIG:-$FILE_DIR}")")"
    if [ -n "$local_bin" ]; then
        PRETTIER_CMD=("$local_bin")
    elif command -v prettier > /dev/null; then
        PRETTIER_CMD=(prettier)
    else
        PRETTIER_CMD=(npx --yes prettier)
    fi
}

# Repo has its own biome config: use it as is (and the repo's biome, config schema is tied to its version)
format_with_repo_biome() {
    local biome_bin
    biome_bin="$(find_local_bin biome "$BIOME_CONFIG_DIR")"
    if [ -n "$DEBUG" ]; then
        echo "cc-format: ${biome_bin:-biome} format --config-path=$BIOME_CONFIG_DIR" >&2
    fi
    "${biome_bin:-biome}" format $BIOME_EXTRA --config-path="$BIOME_CONFIG_DIR" "$FILE"
}

format_with_prettier() {
    local args=(--log-level warn)
    [ -n "$PRETTIER_CONFIG" ] && args+=(--config "$PRETTIER_CONFIG")
    resolve_prettier_cmd
    if [ -n "$DEBUG" ]; then
        echo "cc-format: ${PRETTIER_CMD[*]} ${args[*]}" >&2
    fi
    if [ -n "$NO_WRITE" ]; then
        "${PRETTIER_CMD[@]}" "${args[@]}" "$FILE" | diff -u "$FILE" -
    else
        "${PRETTIER_CMD[@]}" "${args[@]}" --write "$FILE"
    fi
}

FILE_DIR="$(cd "$(dirname "$FILE")" && pwd)"
GIT_ROOT="$(git -C "$FILE_DIR" rev-parse --show-toplevel 2> /dev/null)"

# Format based on extension
case "$EXTENSION" in
    py)
        #echo "Formatting Python file with ruff..."
        ruff format $RUFF_EXTRA \
            --line-length 120 \
            --config "format.quote-style = 'single'" \
            "$FILE"
        ;;
    ts|tsx|js)
        detect_repo_formatter
        case "$REPO_FORMATTER" in
            prettier) format_with_prettier; exit $? ;;
            biome) format_with_repo_biome; exit $? ;;
        esac
        #echo "Formatting $EXTENSION file with biome..."
        biome format $BIOME_EXTRA \
            --indent-style=space --line-width=120 \
            --javascript-formatter-quote-style=single \
            "$FILE"
        ;;
    *)
        echo "Error: Unsupported file type '.$EXTENSION'"
        exit 1
        ;;
esac
